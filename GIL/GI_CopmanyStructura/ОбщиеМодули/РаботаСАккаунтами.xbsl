импорт НСИ
импорт НСИ::ДоменОрганизационнаяСтруктура

@ВПроекте
@НаСервере @ДоступноСКлиента
метод ЭтоАдминистратор(Пользователь: Пользователи.Ссылка): Булево
    возврат Пользователь.ЗагрузитьОбъект().Администратор
;

@ВПроекте
@НаСервере @ДоступноСКлиента
метод ЭтоАдминистратор(): Булево
    возврат Пользователи.ТекущийПользователь.ЗагрузитьОбъект().Администратор
;

@ВПроекте
@НаСервере 
метод НайтиПоДоменномуИмени(ДоменноеИмя: Строка): Аккаунты.Ссылка?
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Аккаунты.Ссылка КАК Ссылка,
            Аккаунты.ПометкаУдаления КАК Метка
        ИЗ
            Аккаунты КАК Аккаунты
        ГДЕ
            Аккаунты.Наименование == %ДоменноеИмя
             И Аккаунты.ПометкаУдаления != Истина
    }
    исп РезультатЗапроса = Запрос.Выполнить()
    пер Значение: Аккаунты.Ссылка?
    если не РезультатЗапроса.Пусто()
        Значение = РезультатЗапроса.ПервыйИлиНеопределено().Ссылка
        РезультатЗапроса.Закрыть()
        возврат Значение
    ;
    возврат Значение
    
;

@ВПроекте
@НаСервере @ДоступноСКлиента
метод СотрудникПользователя(Пользователь: Пользователи.Ссылка): ИнформацияОПользователе
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Сотрудники.Подразделение КАК Подразделение,
            Сотрудники.Организация КАК Организация,
            Сотрудники.Ссылка КАК Ссылка,
            ФизическиеЛица.Ссылка КАК СсылкаФизЛицо,
            Аккаунты.Права КАК Права
        ИЗ
            Сотрудники КАК Сотрудники
                ЛЕВОЕ СОЕДИНЕНИЕ ФизическиеЛица КАК ФизическиеЛица
                ПО Сотрудники.ФизическоеЛицо == ФизическиеЛица.Ссылка
                ЛЕВОЕ СОЕДИНЕНИЕ Аккаунты КАК Аккаунты
                ПО ФизическиеЛица.Аккаунт == Аккаунты.Ссылка
                ЛЕВОЕ СОЕДИНЕНИЕ Пользователи КАК Пользователи
                ПО Аккаунты.ПользовательПриложения == Пользователи.Ссылка
        ГДЕ
            Пользователи.Ссылка == %Пользователь
    }
    пер Результат: ИнформацияОПользователе
    для Элемент из Запрос.Выполнить()
        Результат = новый ИнформацияОПользователе(СотрудникСсылка = Элемент.Ссылка, ФизЛицоСсылка = Элемент
                .СсылкаФизЛицо как ФизическиеЛица.Ссылка?, ПодразделениеСсылка = Элемент.Подразделение,
            ОрганизацияСсылка = Элемент.Организация, Права = Элемент.Права как ПраваПользователей)
    ;
    возврат Результат
;

@ВПроекте
@НаСервере @ДоступноСКлиента
метод СотрудникПользователя(): ИнформацияОПользователе
    знч Пользователь = Пользователи.ТекущийПользователь
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Сотрудники.Подразделение КАК Подразделение,
            Сотрудники.Организация КАК Организация,
            Сотрудники.Ссылка КАК Ссылка,
            ФизическиеЛица.Ссылка КАК СсылкаФизЛицо,
            Аккаунты.Права КАК Права,
            Пользователи.Ссылка как Пользователь
        ИЗ
            Сотрудники КАК Сотрудники
                ЛЕВОЕ СОЕДИНЕНИЕ ФизическиеЛица КАК ФизическиеЛица
                ПО Сотрудники.ФизическоеЛицо == ФизическиеЛица.Ссылка
                ЛЕВОЕ СОЕДИНЕНИЕ Аккаунты КАК Аккаунты
                ПО  ФизическиеЛица.Аккаунт == Аккаунты.Ссылка
                ПРАВОЕ СОЕДИНЕНИЕ Пользователи КАК Пользователи
                ПО Аккаунты.ПользовательПриложения == Пользователи.Ссылка
        ГДЕ
            Пользователи.Ссылка == %Пользователь
    }
    пер Результат: ИнформацияОПользователе
    для Элемент из Запрос.Выполнить()
        Результат = новый ИнформацияОПользователе(СотрудникСсылка = Элемент.Ссылка, ФизЛицоСсылка = Элемент
                .СсылкаФизЛицо, ПодразделениеСсылка = Элемент.Подразделение,
            ОрганизацияСсылка = Элемент.Организация, Права = Элемент.Права, Пользователь = Элемент.Пользователь)
    ;
    возврат Результат
;