импорт НСИ

@ВПроекте
@НаСервере @ДоступноСКлиента
статический метод ПолучитьАккаунтПриложения(Сотрудник: Сотрудники.Ссылка?): Аккаунты.Ссылка?
    знч Запрос = Запрос{
        ВЫБРАТЬ
            ФизическиеЛица.Ссылка КАК Ссылка,
            ФизическиеЛица.Аккаунт КАК Аккаунт
        ИЗ
            Сотрудники КАК Сотрудники
                ЛЕВОЕ СОЕДИНЕНИЕ ФизическиеЛица КАК ФизическиеЛица
                ПО Сотрудники.ФизическоеЛицо == ФизическиеЛица.Ссылка
        ГДЕ
            Сотрудники.Ссылка == %Сотрудник
    }
    исп РезультатЗапроса = Запрос.Выполнить()
    пер Аккаунт: Аккаунты.Ссылка?
    если не РезультатЗапроса.Пусто()
        Аккаунт = РезультатЗапроса.Первый().Аккаунт как Аккаунты.Ссылка?
    ;
    возврат Аккаунт
;

