импорт НСИ::ДоменОрганизационнаяСтруктура
импорт НСИ::ДоменЮридическаяСтруктура
импорт НСИ

@ВПроекте
@НаСервере
метод ПолучитьУставнойКапитал(Орг: Организации.Ссылка?, Док: УставнойКапитал.Ссылка?): Строка
    пер Верстка = ""

    пер Автор = ""
    пер ДокКомментарий = ""
    пер Дата = ""
    знч ЗапросУставКап = Запрос{
        ВЫБРАТЬ
            УставнойКапитал.ДатаАктуализации.ЗаменитьNull("") КАК ДатаАктуализации,
            УставнойКапитал.Капитал.ЗаменитьNull("") КАК Капитал,
            УставнойКапитал.Валюта.ЗаменитьNull("") КАК Валюта,
            УставнойКапитал.Пояснение.ЗаменитьNull("") КАК Пояснение,
            УставнойКапитал.Комментарий.ЗаменитьNull("") КАК ДокКомментарий,
            ФизическиеЛица.Наименование.ЗаменитьNull("") КАК Наименование
        ИЗ
            УставнойКапитал КАК УставнойКапитал
                ЛЕВОЕ СОЕДИНЕНИЕ Аккаунты КАК Аккаунты
                ПО Истина
                 И УставнойКапитал.Автор == Аккаунты.ПользовательПриложения
                ЛЕВОЕ СОЕДИНЕНИЕ ФизическиеЛица КАК ФизическиеЛица
                ПО Истина
                 И ФизическиеЛица.Аккаунт == Аккаунты.Ссылка
        ГДЕ
            УставнойКапитал.ОргЕдиница == %Орг
        УПОРЯДОЧИТЬ ПО
            УставнойКапитал.Дата УБЫВ
    }
    если не ЗапросУставКап.Выполнить().Пусто()
        Верстка = Верстка + "<div class='section-label'>Уставной капитал: <br></div><div class='fin-cap'>"
        для Элемент из ЗапросУставКап.Выполнить()
            ДокКомментарий = Элемент.ДокКомментарий
            Верстка = Верстка + "<div class='section-note'><br>" + ДокКомментарий + "</div>"
            Верстка = Верстка + "<span><br>%{Элемент.Капитал.ВСтроку()}</span> - %{Элемент.Валюта
                .ВСтроку()} (%{Элемент.Пояснение.ВСтроку()})"
            Автор = Элемент.Наименование
            Дата = Элемент.ДатаАктуализации.ВСтроку()
        ;
        Верстка = Верстка + "<div class='updating-info'><br>%Автор - %Дата</div>"
        Верстка = Верстка + "</div>"
    ;
    
    возврат Верстка
;

@ВПроекте
@НаСервере
метод ПолучитьНаблюдательныйСовет(Орг: Организации.Ссылка?, Док: НаблюдательныйСовет.Ссылка?): Строка
    пер Верстка = ""

    знч Запрос = Запрос{
        ВЫБРАТЬ
            НаблюдательныйСоветСовет.Индекс КАК Индекс,
            НаблюдательныйСоветСовет.Участник.ЗаменитьNull("") КАК Участник,
            НаблюдательныйСоветСовет.Должность.ЗаменитьNull("") КАК Должность,
            НаблюдательныйСоветСовет.Комментарий.ЗаменитьNull("") КАК Комментарий
        ИЗ
            НаблюдательныйСовет.Совет КАК НаблюдательныйСоветСовет
        ГДЕ
            НаблюдательныйСоветСовет.Владелец == %Док
        УПОРЯДОЧИТЬ ПО
            Индекс УБЫВ
    }
    для Элемент из Запрос.Выполнить()
        Верстка = Верстка + "<span><br>%{Элемент.Участник.Представление()}</span> - %{Элемент.Должность
            .ВСтроку()} (%{Элемент.Комментарий.ВСтроку()})"
    ;

    возврат Верстка
;

@ВПроекте
@НаСервере
метод ПолучитьИсториюИзменения(Орг: Организации.Ссылка?, Док: ИсторияИзмененияНаименованияЮрЛица.Ссылка?): Строка
    пер Верстка = ""

    знч Запрос = Запрос{
        ВЫБРАТЬ
            ИсторияИзмененияНаименованияЮрЛицаТабличнаяЧасть.Индекс КАК Индекс,
            ИсторияИзмененияНаименованияЮрЛицаТабличнаяЧасть.ОснованиеИзменения.ЗаменитьNull("") КАК ОснованиеИзменения,
            ИсторияИзмененияНаименованияЮрЛицаТабличнаяЧасть.Наименование.ЗаменитьNull("") КАК Наименование,
            ИсторияИзмененияНаименованияЮрЛицаТабличнаяЧасть.ДатаИзменения.ЗаменитьNull("") КАК ДатаИзменения
        ИЗ
            ИсторияИзмененияНаименованияЮрЛица.ТабличнаяЧасть КАК ИсторияИзмененияНаименованияЮрЛицаТабличнаяЧасть
        ГДЕ
            ИсторияИзмененияНаименованияЮрЛицаТабличнаяЧасть.Владелец == %Док
        УПОРЯДОЧИТЬ ПО
            Индекс УБЫВ
    }
    для Элемент из Запрос.Выполнить()
        Верстка = Верстка + "<span><br>%{Элемент.Наименование.ВСтроку()}</span> от %{Элемент.ДатаИзменения
            .ВСтроку()} на основании: %{Элемент.ОснованиеИзменения.ВСтроку()}"
    ;

    возврат Верстка
;

@ВПроекте
@НаСервере
метод ПолучитьАкционеры(Орг: Организации.Ссылка?, Док: Акционеры.Ссылка?): Строка
    пер Верстка = ""

    знч Запрос = Запрос{
        ВЫБРАТЬ
            АкционерыАкционеры.Индекс КАК Индекс,
            АкционерыАкционеры.Акционер.ЗаменитьNull("") КАК Акционер,
            АкционерыАкционеры.Комментарий.ЗаменитьNull("") КАК Комментарий
        ИЗ
            Акционеры.Акционеры КАК АкционерыАкционеры
        ГДЕ
            АкционерыАкционеры.Владелец == %Док
        УПОРЯДОЧИТЬ ПО
            Индекс УБЫВ
    }
    для Элемент из Запрос.Выполнить()
        Верстка = Верстка + "<span><br>%{Элемент.Акционер.Представление()}</span> %{Элемент.Комментарий}"
    ;

    возврат Верстка
;

@ВПроекте
@НаСервере
метод ПолучитьНазначениеРуководителя(Орг: Организации.Ссылка?, Док: НазначениеРуководителя.Ссылка?): Строка
    пер Верстка = ""

    знч Запрос = Запрос{
        ВЫБРАТЬ
            НазначениеРуководителяРуководители.Руководитель.ЗаменитьNull("") КАК Руководитель,
            НазначениеРуководителяРуководители.НазначаемаяДолжность.ЗаменитьNull("") КАК НазначаемаяДолжность,
            НазначениеРуководителяРуководители.Комментарий.ЗаменитьNull("") КАК Комментарий,
            НазначениеРуководителяРуководители.Индекс КАК Индекс
        ИЗ
            НазначениеРуководителя.Руководители КАК НазначениеРуководителяРуководители
        ГДЕ
            НазначениеРуководителяРуководители.Владелец == %Док
        УПОРЯДОЧИТЬ ПО
            Индекс УБЫВ
    }
    для Элемент из Запрос.Выполнить()
        Верстка = Верстка + "<span><br>%{Элемент.Руководитель.Представление()}</span>: %{Элемент.НазначаемаяДолжность
            .ВСтроку()} %{Элемент.Комментарий}"
    ;
    возврат Верстка
;

@ВПроекте
@НаСервере
метод ПолучитьКарточкуОргЕдиницы(Орг: Организации.Ссылка?, Адрес: Строка): Строка
    пер Верстка = ""
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Организации.НаименованиеАнглийский.ЗаменитьNull("") КАК НаименованиеАнглийский,
            Организации.ПолноеНаименование.ЗаменитьNull("") КАК ПолноеНаименование,
            Организации.ОГРН.ЗаменитьNull("") КАК ОГРН,
            Организации.КПП.ЗаменитьNull("") КАК КПП,
            Организации.ИНН.ЗаменитьNull("") КАК ИНН,
            Организации.Наименование КАК Наименование,
            Организации.ГоловнаяОрганизация.ЗаменитьNull("") КАК ГоловнаяОрганизация,
            Организации.Адрес.ЗаменитьNull("") КАК Адрес,
            Организации.Страна.ЗаменитьNull("") КАК Страна
        ИЗ
            Организации КАК Организации
        ГДЕ
            Организации.Ссылка == %Орг
    }
    Верстка = Верстка + "<div class='row'><div class ='wrapper-info-card'>"
    для Элемент из Запрос.Выполнить()
        Верстка = Верстка + "<div class='section-label'><span><br>Название: %{Элемент
            .Наименование}</span><span><br>Наименование на английском: %{Элемент
            .НаименованиеАнглийский}</span><span><br>Полное наименование: %{Элемент.Наименование}</span></div>"
        Верстка = Верстка + "<div class='main'>"
        Верстка = Верстка + "<span><br>ИНН: %{Элемент.ИНН}</span>"
        Верстка = Верстка + "<span><br>ОГРН: %{Элемент.ОГРН}</span>"
        Верстка = Верстка + "<span><br>КПП: %{Элемент.КПП}</span>"
        Верстка = Верстка + "<span><br>Страна регистрации: %{Элемент.Страна}</span>"
        Верстка = Верстка + "<span><br>Адрес регистрации: %{Элемент.Адрес}</span>"
        //todo переход на карточку головной организации
        Верстка = Верстка + "</div>"
    ;
    знч ЗапросНазначениеРук = Запрос{
        ВЫБРАТЬ
            НазначениеРуководителя.СсылкаВСЭД.ЗаменитьNull("") КАК СсылкаВСЭД,
            НазначениеРуководителя.ДатаАктуализации.ЗаменитьNull("") КАК ДатаАктуализации,
            НазначениеРуководителя.Комментарий.ЗаменитьNull("") КАК Комментарий,
            ФизическиеЛица.Наименование.ЗаменитьNull("") КАК Наименование,
            НазначениеРуководителя.Ссылка КАК Ссылка
        ИЗ
            НазначениеРуководителя КАК НазначениеРуководителя
                ЛЕВОЕ СОЕДИНЕНИЕ Аккаунты КАК Аккаунты
                ПО Истина
                 И НазначениеРуководителя.Автор == Аккаунты.ПользовательПриложения
                ЛЕВОЕ СОЕДИНЕНИЕ ФизическиеЛица КАК ФизическиеЛица
                ПО Истина
                 И ФизическиеЛица.Аккаунт == Аккаунты.Ссылка
        ГДЕ
            НазначениеРуководителя.Организация == %Орг
        УПОРЯДОЧИТЬ ПО
            НазначениеРуководителя.Дата УБЫВ
    }

    пер Автор = ""
    пер ДокКомментарий = ""
    пер Дата = ""
    пер Комментарий = ""
    пер СсылкаВСЭД = ""
    если не ЗапросНазначениеРук.Выполнить().Пусто()
        пер Док: НазначениеРуководителя.Ссылка?
        Верстка = Верстка + "<div class='section-label'>Назначение руководителя: <br></div><div class='head'>"
        для Элемент из ЗапросНазначениеРук.Выполнить()
            Комментарий = Элемент.Комментарий
            СсылкаВСЭД = Элемент.СсылкаВСЭД
            Автор = Элемент.Наименование
            Дата = Элемент.ДатаАктуализации.ВСтроку()

            Док = Элемент.Ссылка
        ;
        Верстка = Верстка + "<br><div class='section-main-info'>%{Комментарий}</div>"
        Верстка = Верстка + ПолучитьНазначениеРуководителя(Док = Док, Орг = Орг)
        //Верстка = Верстка + "<div class='section-note'><br>" + ДокКомментарий + "</div>"
        Верстка = Верстка + "<div class='updating-info'><br>%Автор - %Дата</div>"
        Верстка = Верстка + "</div>"
    ;

    Комментарий = ""
    СсылкаВСЭД = ""
    Автор = ""
    ДокКомментарий = ""
    Дата = ""

    знч ЗапросАкционеры = Запрос{
        ВЫБРАТЬ
            Акционеры.ДатаАктуализации.ЗаменитьNull("") КАК ДатаАктуализации,
            Акционеры.Комментарий.ЗаменитьNull("") КАК ДокКомментарий,
            Акционеры.Ссылка КАК Ссылка,
            ФизическиеЛица.Наименование.ЗаменитьNull("") КАК Наименование
        ИЗ
            Акционеры КАК Акционеры
                ЛЕВОЕ СОЕДИНЕНИЕ Аккаунты КАК Аккаунты
                ПО Истина
                 И Акционеры.Автор == Аккаунты.ПользовательПриложения
                ЛЕВОЕ СОЕДИНЕНИЕ ФизическиеЛица КАК ФизическиеЛица
                ПО Истина
                 И ФизическиеЛица.Аккаунт == Аккаунты.Ссылка
        ГДЕ
            Акционеры.ОргЕдиница == %Орг
        УПОРЯДОЧИТЬ ПО
            Акционеры.Дата УБЫВ
    }
    Автор = ""
    ДокКомментарий = ""
    Дата = ""
    если не ЗапросАкционеры.Выполнить().Пусто()
        пер Док: Акционеры.Ссылка?
        Верстка = Верстка + "<div class='section-label'>Акционеры компании: <br></div><div class='shareholders'>"
        для Элемент из ЗапросАкционеры.Выполнить()
            Комментарий = Элемент.ДокКомментарий

            Автор = Элемент.Наименование
            Дата = Элемент.ДатаАктуализации.ВСтроку()

            Док = Элемент.Ссылка
        ;
        Верстка = Верстка + "<br><div class='section-main-info'>%{Комментарий}</div>"
        Верстка = Верстка + ПолучитьАкционеры(Док = Док, Орг = Орг)
        //Верстка = Верстка + "<div class='section-note'><br>" + ДокКомментарий + "</div>"
        Верстка = Верстка + "<div class='updating-info'><br>%Автор - %Дата</div>"
        Верстка = Верстка + "</div>"
    ;
    Автор = ""
    ДокКомментарий = ""
    Дата = ""
    знч ЗапросИстория = Запрос{
        ВЫБРАТЬ
            ИсторияИзмененияНаименованияЮрЛица.ДатаАктуализации.ЗаменитьNull("") КАК ДатаАктуализации,
            ИсторияИзмененияНаименованияЮрЛица.Комментарий.ЗаменитьNull("") КАК ДокКомментарий,
            ИсторияИзмененияНаименованияЮрЛица.Ссылка КАК Ссылка,
            ФизическиеЛица.Наименование.ЗаменитьNull("") КАК Наименование
        ИЗ
            ИсторияИзмененияНаименованияЮрЛица КАК ИсторияИзмененияНаименованияЮрЛица
                ЛЕВОЕ СОЕДИНЕНИЕ ИсторияИзмененияНаименованияЮрЛица.ТабличнаяЧасть КАК ТабличнаяЧасть
                ПО Истина
                 И ТабличнаяЧасть.Владелец == ИсторияИзмененияНаименованияЮрЛица.Ссылка
                ЛЕВОЕ СОЕДИНЕНИЕ Аккаунты КАК Аккаунты
                ПО Истина
                 И ИсторияИзмененияНаименованияЮрЛица.Автор == Аккаунты.ПользовательПриложения
                ЛЕВОЕ СОЕДИНЕНИЕ ФизическиеЛица КАК ФизическиеЛица
                ПО Истина
                 И ФизическиеЛица.Аккаунт == Аккаунты.Ссылка
        ГДЕ
            ИсторияИзмененияНаименованияЮрЛица.ЮрЛицо == %Орг
        УПОРЯДОЧИТЬ ПО
            ИсторияИзмененияНаименованияЮрЛица.Дата УБЫВ
    }

    если не ЗапросИстория.Выполнить().Пусто()
        пер Док: ИсторияИзмененияНаименованияЮрЛица.Ссылка?
        Верстка = Верстка
            + "<div class='section-label'>История изменения юр. лица: <br></div><div class='changing-history'>"
        для Элемент из ЗапросИстория.Выполнить()
            Комментарий = Элемент.ДокКомментарий

            Автор = Элемент.Наименование
            Дата = Элемент.ДатаАктуализации.ВСтроку()

            Док = Элемент.Ссылка
        ;
        Верстка = Верстка + "<br><div class='section-main-info'>%{Комментарий}</div>"
        Верстка = Верстка + ПолучитьИсториюИзменения(Док = Док, Орг = Орг)
        //Верстка = Верстка + "<div class='section-note'><br>" + ДокКомментарий + "</div>"
        Верстка = Верстка + "<div class='updating-info'><br>%Автор - %Дата</div>"
        Верстка = Верстка + "</div>"
    ;
    Автор = ""
    ДокКомментарий = ""
    Дата = ""

    знч ЗапросСовет = Запрос{
        ВЫБРАТЬ
            НаблюдательныйСовет.ДатаАктуализации.ЗаменитьNull("") КАК ДатаАктуализации,
            НаблюдательныйСовет.Комментарий.ЗаменитьNull("") КАК ДокКомментарий,
            НаблюдательныйСовет.Ссылка КАК Ссылка,
            ФизическиеЛица.Наименование.ЗаменитьNull("") КАК Наименование
        ИЗ
            НаблюдательныйСовет КАК НаблюдательныйСовет
                ЛЕВОЕ СОЕДИНЕНИЕ Аккаунты КАК Аккаунты
                ПО Истина
                 И НаблюдательныйСовет.Автор == Аккаунты.ПользовательПриложения
                ЛЕВОЕ СОЕДИНЕНИЕ ФизическиеЛица КАК ФизическиеЛица
                ПО Истина
                 И ФизическиеЛица.Аккаунт == Аккаунты.Ссылка
        ГДЕ
            НаблюдательныйСовет.Организация == %Орг
        УПОРЯДОЧИТЬ ПО
            НаблюдательныйСовет.Дата УБЫВ
    }
    если не ЗапросСовет.Выполнить().Пусто()
        пер Док: НаблюдательныйСовет.Ссылка?
        Верстка = Верстка + "<div class='section-label'>Наблюдательный совет: <br></div><div class='changing-history'>"
        для Элемент из ЗапросСовет.Выполнить()
            Комментарий = Элемент.ДокКомментарий

            Автор = Элемент.Наименование
            Дата = Элемент.ДатаАктуализации.ВСтроку()

            Док = Элемент.Ссылка
        ;
        Верстка = Верстка + "<br><div class='section-main-info'>%{Комментарий}</div>"
        Верстка = Верстка + ПолучитьНаблюдательныйСовет(Док = Док, Орг = Орг)
        //Верстка = Верстка + "<div class='section-note'><br>" + ДокКомментарий + "</div>"
        Верстка = Верстка + "<div class='updating-info'><br>%Автор - %Дата</div>"
        Верстка = Верстка + "</div>"
    ;

    Верстка = Верстка + ПолучитьУставнойКапитал(Орг, Неопределено)
    Верстка = Верстка + "</div></div>"
    Автор = ""
    ДокКомментарий = ""
    Дата = ""
    возврат Верстка
;