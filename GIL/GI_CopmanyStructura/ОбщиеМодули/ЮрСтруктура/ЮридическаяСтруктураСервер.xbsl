импорт НСИ::ДоменОрганизационнаяСтруктура
импорт НСИ::ДоменЮридическаяСтруктура

@Локально
@НаСервере
метод ПолучитьПодчиненныеОрганизации(Организация: Организации.Ссылка): Массив<Организации.Ссылка>|Неопределено
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Организации.Ссылка КАК Ссылка,
            Организации.ГоловнаяОрганизация КАК ВышестоящееПодразделение
        ИЗ
            Организации КАК Организации
        ГДЕ
            Организации.ГоловнаяОрганизация == %Организация
    }
    исп РезультатЗапроса = Запрос.Выполнить()
    если РезультатЗапроса.Пусто()
        возврат Неопределено
    ;
    знч Массив = новый Массив<Организации.Ссылка>()
    для Элемент из РезультатЗапроса
        пер ПодразделениеПодчиненное = Элемент.Ссылка
        Массив.Добавить(ПодразделениеПодчиненное)
    ;
    возврат Массив
;

@Локально
@НаСервере
метод СформироватьУзелИзОрганизации(Организация: Организации.Ссылка): УзелОрганиграммы
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Организации.Ссылка.Ид КАК Ид,
            Организации.Ссылка КАК Ссылка,
            Организации.Наименование КАК Наименование,
            Организации.ЭтоПроект КАК ЭтоПроект,
            Организации.ЭтоФилиал КАК ЭтоФилиал,
            Организации.ПроцентВладения КАК ПроцентВладения,
            Организации.ЭтоВнешняяКомпания КАК ЭтоВнешняяКомпания,
            Организации.НаименованиеАнглийский КАК НаименованиеАнглийский
        ИЗ
            Организации КАК Организации
        ГДЕ
            Организации.Ссылка == %Организация
    }
    //
    исп РезультатЗапроса = Запрос.Выполнить()
    пер Объект: Организации.Ссылка?
    пер Описание: Строка
    пер Наименование: Строка
    пер ДочерниеЭлементыУзлы: Массив<УзелОрганиграммы?>
    пер ДопФлаги: Массив<Флаг>
    пер ИдНСИ: Строка
    пер Изображение: ДвоичныйОбъект.Ссылка?
    пер Пояснение: Строка
    для Элемент из РезультатЗапроса
        ИдНСИ = Элемент.Ид.ВСтроку()
        Описание = Элемент.НаименованиеАнглийский
        Наименование = Элемент.Наименование
        Объект = Элемент.Ссылка
        Пояснение = Строки.Шаблон("$0 %", [Элемент.ПроцентВладения.ВСтроку()])
        ДопФлаги.Добавить(новый Флаг("ЭтоОрганизация", ""))
        //ДопФлаги.Добавить(новый Флаг("УбратьВидимостьНавигации", ""))
        если Элемент.ЭтоВнешняяКомпания
            ДопФлаги.Добавить(новый Флаг("ЭтоВнешняяКомпания", ""))
        ;
        если Элемент.Ссылка == УправлениеСостоянием.ПолучитьОргЕдиницуПоУмолчанию()
            ДопФлаги.Добавить(новый Флаг("Якорь", ""))
        ;
        если Элемент.ЭтоПроект
            ДопФлаги.Добавить(новый Флаг("ЭтоПроект", ""))
        //Изображение = Ресурс{triangle-svgrepo-com.svg}.Ссылка
        ;
        если Элемент.ЭтоФилиал
            ДопФлаги.Добавить(новый Флаг("ЭтоФилиал", ""))
            Изображение = Ресурс{triangle-svgrepo-com.svg}.Ссылка
        ;
    ;

    знч ДочерниеЭлементы = ПолучитьПодчиненныеОрганизации(Организация)

    если ДочерниеЭлементы != Неопределено
        для Элемент из ДочерниеЭлементы
            ДочерниеЭлементыУзлы.Добавить(СформироватьУзелИзОрганизации(Элемент))
        ;
    ;
    возврат новый УзелОрганиграммы(Наименование = Наименование, Описание = Описание, Пояснение = Пояснение,
        ОбъектДанных = Объект, ДочерниеЭлементы = ДочерниеЭлементыУзлы, ДопФлаги = ДопФлаги, ИдНСИ = ИдНСИ,
        Изображение = Изображение)
;

@Локально
@НаСервере
метод ПолучитьЮридическихПодчиненных(ДокументИсточник: ЮридическоеПодчинение.Ссылка?,
        Источник: Организации.Ссылка?): Массив<УзелОрганиграммы?>

    знч Запрос = Запрос{
        ВЫБРАТЬ
            ЮридическоеПодчинениеСвязи.ДочерняяЕдиница.ЗаменитьNull() КАК ДочерняяЕдиница,
            ЮридическоеПодчинениеСвязи.ТипСвязи.ЗаменитьNull("") КАК ТипСвязи,
            ЮридическоеПодчинениеСвязи.ПроцентВладения.ЗаменитьNull("") КАК ПроцентВладения,
            Организации.ЭтоПроект.ЗаменитьNull() КАК ЭтоПроект,
            Организации.ЭтоФилиал.ЗаменитьNull() КАК ЭтоФилиал,
            ЮридическоеПодчинениеСвязи.Источник.ЗаменитьNull("") КАК Источник
        ИЗ
            ЮридическоеПодчинение КАК ЮридическоеПодчинение
                ЛЕВОЕ СОЕДИНЕНИЕ ЮридическоеПодчинение.Связи КАК ЮридическоеПодчинениеСвязи
                ПО Истина
                 И ЮридическоеПодчинениеСвязи.Владелец == ЮридическоеПодчинение.Ссылка
                ЛЕВОЕ СОЕДИНЕНИЕ Организации КАК Организации
                ПО Истина
                 И Организации.Ссылка == ЮридическоеПодчинениеСвязи.ДочерняяЕдиница
        ГДЕ
            ЮридическоеПодчинение.Ссылка == %ДокументИсточник
    }

    исп РезультатЗапроса = Запрос.Выполнить()

    //пер Узел: УзелОрганиграммы
    знч Результат: Массив<УзелОрганиграммы?>
    для Элемент из РезультатЗапроса
        если Элемент.Источник == Источник
            //в цикле чтобы не сохранялись значения предыдущих узлов
            пер ИдНСИ: Строка
            пер Наименование: Строка
            пер Пояснение: Строка
            пер Изображение: ДвоичныйОбъект.Ссылка?
            пер Описание: Строка
            пер ДопФлаги: Массив<Флаг>
            пер ДочерниеЭлементы: Массив<УзелОрганиграммы?>
            ИдНСИ = Элемент.ДочерняяЕдиница.Ид.ВСтроку()
            Наименование = Элемент.ДочерняяЕдиница.Представление()
            Пояснение = Строки.Шаблон("$0 %", [Элемент.ПроцентВладения.ВСтроку()])
            Описание = Элемент.ТипСвязи
            ДопФлаги.Добавить(новый Флаг("ЭтоОрганизация", ""))
            если Элемент.ЭтоПроект
                ДопФлаги.Добавить(новый Флаг("ЭтоПроект", ""))
            ;
            если Элемент.ЭтоФилиал
                ДопФлаги.Добавить(новый Флаг("ЭтоФилиал", ""))
                Изображение = Ресурс{triangle-svgrepo-com.svg}.Ссылка
            ;
            ДочерниеЭлементы = ПолучитьЮридическихПодчиненных(ДокументИсточник, Элемент.ДочерняяЕдиница)
            Результат.Добавить(новый УзелОрганиграммы(Изображение = Изображение, Наименование = Наименование,
                Описание = Описание, Пояснение = Пояснение, ДопФлаги = ДопФлаги, ДочерниеЭлементы = ДочерниеЭлементы,
                    ИдНСИ = ИдНСИ))
        ;
    ;
    возврат Результат
;

@Локально
@НаСервере
метод ПолучитьФинансовыеПотоки(ДокументИсточник: ФинансовыеПотоки.Ссылка?,
        Источник: Организации.Ссылка?): Массив<УзелОрганиграммы?>

    знч Запрос = Запрос{
        ВЫБРАТЬ
            ЮридическоеПодчинениеСвязи.ДочерняяЕдиница.ЗаменитьNull() КАК ДочерняяЕдиница,
            ЮридическоеПодчинениеСвязи.ТипСвязи.ЗаменитьNull("") КАК ТипСвязи,
            Организации.ЭтоПроект.ЗаменитьNull() КАК ЭтоПроект,
            Организации.ЭтоФилиал.ЗаменитьNull() КАК ЭтоФилиал,
            ЮридическоеПодчинениеСвязи.Источник.ЗаменитьNull("") КАК Источник
        ИЗ
            ФинансовыеПотоки КАК ЮридическоеПодчинение
                ЛЕВОЕ СОЕДИНЕНИЕ ФинансовыеПотоки.Связи КАК ЮридическоеПодчинениеСвязи
                ПО Истина
                 И ЮридическоеПодчинениеСвязи.Владелец == ЮридическоеПодчинение.Ссылка
                ЛЕВОЕ СОЕДИНЕНИЕ Организации КАК Организации
                ПО Истина
                 И Организации.Ссылка == ЮридическоеПодчинениеСвязи.ДочерняяЕдиница
        ГДЕ
            ЮридическоеПодчинение.Ссылка == %ДокументИсточник
    }

    исп РезультатЗапроса = Запрос.Выполнить()

    //пер Узел: УзелОрганиграммы
    знч Результат: Массив<УзелОрганиграммы?>
    для Элемент из РезультатЗапроса
        если Элемент.Источник == Источник
            //в цикле чтобы не сохранялись значения предыдущих узлов
            пер ИдНСИ: Строка
            пер Наименование: Строка
            пер Пояснение: Строка
            пер Изображение: ДвоичныйОбъект.Ссылка?
            пер Описание: Строка
            пер ДопФлаги: Массив<Флаг>
            пер ДочерниеЭлементы: Массив<УзелОрганиграммы?>
            ИдНСИ = Элемент.ДочерняяЕдиница.Ид.ВСтроку()
            Наименование = Элемент.ДочерняяЕдиница.Представление()
            Пояснение = Элемент.ТипСвязи
            //Описание = Элемент.ТипСвязи
            ДопФлаги.Добавить(новый Флаг("ЭтоОрганизация", ""))
            если Элемент.ЭтоПроект
                ДопФлаги.Добавить(новый Флаг("ЭтоПроект", ""))
            ;
            если Элемент.ЭтоФилиал
                ДопФлаги.Добавить(новый Флаг("ЭтоФилиал", ""))
                Изображение = Ресурс{triangle-svgrepo-com.svg}.Ссылка
            ;
            ДочерниеЭлементы = ПолучитьФинансовыеПотоки(ДокументИсточник, Элемент.ДочерняяЕдиница)
            Результат.Добавить(новый УзелОрганиграммы(Изображение = Изображение, Наименование = Наименование,
                Описание = Описание, Пояснение = Пояснение, ДопФлаги = ДопФлаги, ДочерниеЭлементы = ДочерниеЭлементы,
                    ИдНСИ = ИдНСИ))
        ;
    ;
    возврат Результат
;

@Локально
@НаСервере
метод СформироватьОрганизационноеПодчинение(Организация: Организации.Ссылка?): УзелОрганиграммы
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            ЮридическоеПодчинениеСвязи.Источник.ЗаменитьNull() КАК Источник,
            ЮридическоеПодчинениеСвязи.Индекс КАК Индекс,
            ЮридическоеПодчинение.Ссылка КАК ДокументИсточник
        ИЗ
            ЮридическоеПодчинение КАК ЮридическоеПодчинение
                ЛЕВОЕ СОЕДИНЕНИЕ ЮридическоеПодчинение.Связи КАК ЮридическоеПодчинениеСвязи
                ПО Истина
                 И ЮридическоеПодчинениеСвязи.Владелец == ЮридическоеПодчинение.Ссылка
        ГДЕ
            ЮридическоеПодчинение.Организация == %Организация
        УПОРЯДОЧИТЬ ПО
            Индекс
    }
    исп РезультатЗапроса = Запрос.Выполнить()

    пер Источник: Организации.Ссылка?
    //пер Подчиненный: Организации.Ссылка?
    пер Результат: УзелОрганиграммы?
    если РезультатЗапроса.Пусто()
        возврат новый УзелОрганиграммы(Наименование = Организация.Представление(), ИдНСИ = Организация.Ид
                .ВСтроку(), ДопФлаги = [новый Флаг("ЭтоОрганизация", "")])
    ;
    для Элемент из РезультатЗапроса
        Источник = Элемент.Источник
        Результат = новый УзелОрганиграммы(Наименование = Элемент.Источник.Представление(), ИдНСИ = Элемент.Источник.Ид
                .ВСтроку(), ДочерниеЭлементы = ПолучитьЮридическихПодчиненных(Элемент.ДокументИсточник,
                    Элемент.Источник), ДопФлаги = [новый Флаг("ЭтоОрганизация", "")])
    ;
    РезультатЗапроса.Закрыть()
    возврат Результат
;

@Локально
@НаСервере
метод СформироватьФинансовыеПотоки(Организация: Организации.Ссылка?): УзелОрганиграммы
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            ФинансовыеПотокиСвязи.Источник.ЗаменитьNull() КАК Источник,
            ФинансовыеПотокиСвязи.Индекс КАК Индекс,
            ФинансовыеПотоки.Ссылка КАК ДокументИсточник
        ИЗ
            ФинансовыеПотоки КАК ФинансовыеПотоки
                ЛЕВОЕ СОЕДИНЕНИЕ ЮридическоеПодчинение.Связи КАК ФинансовыеПотокиСвязи
                ПО Истина
                 И ФинансовыеПотокиСвязи.Владелец == ФинансовыеПотоки.Ссылка
        ГДЕ
            ФинансовыеПотоки.Организация == %Организация
        УПОРЯДОЧИТЬ ПО
            Индекс
    }
    исп РезультатЗапроса = Запрос.Выполнить()

    пер Источник: Организации.Ссылка?
    //пер Подчиненный: Организации.Ссылка?
    пер Результат: УзелОрганиграммы?
    если РезультатЗапроса.Пусто()
        возврат новый УзелОрганиграммы(Наименование = Организация.Представление(), ИдНСИ = Организация.Ид
                .ВСтроку(), ДопФлаги = [новый Флаг("ЭтоОрганизация", "")])
    ;
    для Элемент из РезультатЗапроса
        Источник = Элемент.Источник
        Результат = новый УзелОрганиграммы(Наименование = Элемент.Источник.Представление(), ИдНСИ = Элемент.Источник.Ид
                .ВСтроку(), ДочерниеЭлементы = ПолучитьФинансовыеПотоки(Элемент.ДокументИсточник,
                    Элемент.Источник), ДопФлаги = [новый Флаг("ЭтоОрганизация", "")])
    ;
    РезультатЗапроса.Закрыть()
    возврат Результат
;

@ВПроекте
@НаСервере @ДоступноСКлиента
метод ПредставлениеСтруктуры(Организация: Организации.Ссылка?): Массив<УзелОрганиграммы>
    возврат [СформироватьУзелИзОрганизации(Организация)]
;

@ВПроекте
@НаСервере @ДоступноСКлиента
метод ПредставлениеОргПодчинения(Организация: Организации.Ссылка?): Массив<УзелОрганиграммы>
    возврат [СформироватьОрганизационноеПодчинение(Организация)]
;
@ВПроекте
@НаСервере @ДоступноСКлиента
метод ПредставлениеФинПотоков(Организация: Организации.Ссылка?): Массив<УзелОрганиграммы>
    возврат [СформироватьФинансовыеПотоки(Организация)]
;