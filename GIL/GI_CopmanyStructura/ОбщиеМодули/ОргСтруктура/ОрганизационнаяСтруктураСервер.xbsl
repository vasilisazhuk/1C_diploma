импорт НСИ
импорт НСИ::ДоменОрганизационнаяСтруктура

@Локально
структура ПодразделениеРуководитель
    пер Подразделение: Подразделения.Ссылка?
    пер Руководитель: Сотрудники.Ссылка?
;

@Локально
@НаСервере
метод ПолучитьПодчиненныеПодразделения(
        Подразделение: Подразделения.Ссылка): Массив<ПодразделениеРуководитель>|Неопределено

    знч Запрос = Запрос{
        ВЫБРАТЬ
            Подразделения.Ссылка КАК Ссылка,
            Подразделения.ВышестоящееПодразделение КАК ВышестоящееПодразделение,
            Подразделения.Руководитель КАК Руководитель
        ИЗ
            Подразделения КАК Подразделения
        ГДЕ
            Подразделения.ВышестоящееПодразделение == %Подразделение
             И Подразделения.ЭтоФилиал == Ложь
             И НЕ Подразделения.ПометкаУдаления
        СГРУППИРОВАТЬ ПО
            Подразделения.ЭтоЗГД,
            Подразделения.ЭтоПодразделениеПрямогоПодчинения,
            Подразделения.ЭтоУправление,
            Подразделения.ЭтоФилиал,
            Подразделения.Руководитель,
            Подразделения.ИдНСИ,
            Подразделения.Наименование,
            Подразделения.ВышестоящееПодразделение,
            Подразделения.Ссылка
    }
    исп РезультатЗапроса = Запрос.Выполнить()
    если РезультатЗапроса.Пусто()
        возврат Неопределено
    ;
    знч Массив = новый Массив<ПодразделениеРуководитель>()
    для Элемент из РезультатЗапроса
        пер ПодразделениеПодчиненное = Элемент.Ссылка
        пер Руководитель = Элемент.Руководитель
        Массив.Добавить(новый ПодразделениеРуководитель(ПодразделениеПодчиненное, Руководитель))
    ;
    возврат Массив
;

@Локально
@НаСервере
метод СформироватьУзелИзПодразделения(Подразделение: Подразделения.Ссылка?, ВыводитьРуководителя: Булево =
            Истина): УзелОрганиграммы
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Подразделения.Руководитель.Ид КАК Руководитель,
            Подразделения.ИдНСИ КАК ИдНСИ,
            Подразделения.Руководитель КАК РуководительСсылка,
            Подразделения.ЭтоЗГД КАК ЭтоЗГД,
            Подразделения.ЭтоПодразделениеПрямогоПодчинения КАК ЭтоПодразделениеПрямогоПодчинения,
            Подразделения.ЭтоУправление КАК ЭтоУправление,
            Подразделения.ЭтоФилиал КАК ЭтоФилиал,
            Подразделения.СсылкаНаПортал КАК СсылкаНаПортал,
            Подразделения.Ссылка КАК Ссылка,
            Подразделения.Наименование КАК Наименование,
            Сотрудники.Должность КАК Должность,
            Сотрудники.Наименование КАК ФИО,
            ФизическиеЛица.СсылкаНаПортал КАК СсылкаНаПорталРук,
            ФизическиеЛица.Фото КАК Фото,
            КОЛИЧЕСТВО(Сотрудники1.Ссылка) > 0
             ИЛИ КОЛИЧЕСТВО(Подразделения1.Ссылка) > 0 КАК Выводить
        ИЗ
            Подразделения КАК Подразделения
                ЛЕВОЕ СОЕДИНЕНИЕ Сотрудники КАК Сотрудники
                ПО Подразделения.Руководитель == Сотрудники.Ссылка
                ЛЕВОЕ СОЕДИНЕНИЕ ФизическиеЛица КАК ФизическиеЛица
                ПО Сотрудники.ФизическоеЛицо == ФизическиеЛица.Ссылка
                ЛЕВОЕ СОЕДИНЕНИЕ Сотрудники КАК Сотрудники1
                ПО Истина
                 И Сотрудники1.Подразделение == Подразделения.Ссылка
                ЛЕВОЕ СОЕДИНЕНИЕ Подразделения КАК Подразделения1
                ПО Истина
                 И Подразделения1.ВышестоящееПодразделение == Подразделения.Ссылка
        ГДЕ
            Подразделения.Ссылка == %Подразделение
        СГРУППИРОВАТЬ ПО
            Подразделения.Руководитель.Ид,
            Подразделения.ИдНСИ,
            Подразделения.Руководитель,
            Подразделения.ЭтоЗГД,
            Подразделения.ЭтоПодразделениеПрямогоПодчинения,
            Подразделения.ЭтоУправление,
            Подразделения.ЭтоФилиал,
            Подразделения.СсылкаНаПортал,
            Подразделения.Ссылка,
            Подразделения.Наименование,
            Сотрудники.Должность,
            Сотрудники.Наименование,
            ФизическиеЛица.СсылкаНаПортал,
            ФизическиеЛица.Фото
    }
    //
    исп РезультатЗапроса = Запрос.Выполнить()
    пер Объект: Подразделения.Ссылка?
    пер Изображение: ДвоичныйОбъект.Ссылка?
    пер Описание: Строка
    пер Наименование: Строка
    пер ДочерниеЭлементыУзлы: Массив<УзелОрганиграммы?>
    пер ДопФлаги: Массив<Флаг>
    пер ИдНСИ: Строка
    пер Рук: Сотрудники.Ссылка?
    пер Пояснение: Строка
    для Элемент из РезультатЗапроса
        Объект = Элемент.Ссылка
        ИдНСИ = Элемент.Ссылка.Ид.ВСтроку()
        //Пояснение = Элемент.СсылкаНаПортал == "" ? УправлениеСостоянием.ПолучитьПорталПоУмолчанию()
        //    : УправлениеСостоянием.ПолучитьПорталПоУмолчанию() + "/company/vis_structure.php?department=" + Элемент.СсылкаНаПортал + "&viewType=table"
        Пояснение = Элемент.СсылкаНаПортал == "" ? УправлениеСостоянием.ПолучитьПорталПоУмолчанию()
           :  Элемент.СсылкаНаПортал 
        выбор Элемент.Фото
        когда Null
            Изображение = Ресурс {No Image SVG Icon.svg}.Ссылка
        когда Неопределено
            Изображение = Ресурс{user.svg}.Ссылка
        иначе
            Изображение = Элемент.Фото как ДвоичныйОбъект.Ссылка
        ;
        Рук = Элемент.РуководительСсылка
        Описание = Строки.Шаблон("<span class='name' style='font-size: 14px; font-style: normal;'>$1</span>: $0", [
                Элемент.Должность == Null ? "" : Элемент.Должность.ВСтроку(), Элемент.ФИО == Null ? "" : Элемент.ФИО])
        Наименование = Элемент.Наименование.Представление()
        ДопФлаги.Добавить(новый Флаг("Это подразделение", ""))
        если Элемент.ЭтоЗГД
            ДопФлаги.Добавить(новый Флаг(Название = "ЭтоЗГД", Значение = ""))
            ДопФлаги.Добавить(новый Флаг(Название = "Это сотрудник", Значение = ""))
            Пояснение = Элемент.СсылкаНаПорталРук как Строка
            ИдНСИ = Элемент.Руководитель.ВСтроку()
        ;
        если Элемент.ЭтоУправление
            ДопФлаги.Добавить(новый Флаг("ЭтоУправление", ""))
        ;
        если Элемент.ЭтоФилиал
            ДопФлаги.Добавить(новый Флаг(Название = "ЭтоФилиал", Значение = ""))
        ;
        если Элемент.ЭтоПодразделениеПрямогоПодчинения
            ДопФлаги.Добавить(новый Флаг(Название = "ЭтоПодразделениеПрямогоПодчинения", Значение = ""))
        ;
        если ВыводитьРуководителя
            ДопФлаги.Добавить(новый Флаг(Название = "ВыводитьРуководителя", Значение = ""))
        ;
        если Элемент.РуководительСсылка == Неопределено
            ДопФлаги.Добавить(новый Флаг(Название = "РуководительНеЗаполнен", Значение = ""))
        ;
        если Элемент.Выводить
            ДопФлаги.Добавить(новый Флаг(Название = "Выводит", Значение = ""))
        ;
    ;
    знч ДочерниеЭлементы = ПолучитьПодчиненныеПодразделения(Подразделение)

    если ДочерниеЭлементы != Неопределено
        для Элемент из ДочерниеЭлементы
            пер ВыводитьРук = Элемент.Руководитель == Рук
                ? (Элемент.Руководитель == Неопределено или Рук == Неопределено) : не Элемент.Руководитель == Рук
            ДочерниеЭлементыУзлы.Добавить(СформироватьУзелИзПодразделения(Элемент.Подразделение, ВыводитьРук))
        ;
    ;

    //если (Элемент.РуководительСсылка == Руководитель) и (Элемент.РуководительСсылка != Неопределено) и (Руководитель != Неопределено)
    //    ДопФлаги.Добавить(новый Флаг(Название = "НеВыводитьРуководителя", Значение=""))
    //;


    возврат новый УзелОрганиграммы(Наименование = Наименование, Изображение = Изображение, Описание = Описание,
        ОбъектДанных = Объект, ДочерниеЭлементы = ДочерниеЭлементыУзлы, ДопФлаги = ДопФлаги, ИдНСИ = ИдНСИ,
        Пояснение = Пояснение)
;

@Локально
@НаСервере
метод СформироватьФилиалы(Подразделение: Подразделения.Ссылка): Массив<ПодразделениеРуководитель>|Неопределено
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Подразделения.Ссылка КАК Ссылка,
            Подразделения.ВышестоящееПодразделение КАК ВышестоящееПодразделение,
            Подразделения.Руководитель КАК Руководитель
        ИЗ
            Подразделения КАК Подразделения
        ГДЕ
            Подразделения.ВышестоящееПодразделение == %Подразделение
             И Подразделения.ЭтоФилиал == Истина
             И НЕ Подразделения.ПометкаУдаления
    }
    исп РезультатЗапроса = Запрос.Выполнить()
    если РезультатЗапроса.Пусто()
        возврат Неопределено
    ;
    знч Массив = новый Массив<ПодразделениеРуководитель>()
    для Элемент из РезультатЗапроса
        пер ПодразделениеПодчиненное = Элемент.Ссылка
        пер Руководитель = Элемент.Руководитель
        Массив.Добавить(новый ПодразделениеРуководитель(ПодразделениеПодчиненное, Руководитель))
    ;
    возврат Массив
;

@ВПроекте
@НаСервере @ДоступноСКлиента
метод ПредставлениеСтруктуры(Подразделение: Подразделения.Ссылка?): Массив<УзелОрганиграммы>
    знч Массив = новый Массив<УзелОрганиграммы>()
    Массив.Добавить(СформироватьУзелИзПодразделения(Подразделение))
    знч Филиалы = СформироватьФилиалы(Подразделение)
    для Элемент из Филиалы
        Массив.Добавить(СформироватьУзелИзПодразделения(Элемент.Подразделение))
    ;
    возврат Массив
;