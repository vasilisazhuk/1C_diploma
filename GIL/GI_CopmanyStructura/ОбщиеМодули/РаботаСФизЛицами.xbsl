импорт НСИ


@ВПроекте
@НаСервере @ДоступноСКлиента
статический метод НайтиПоИдНСИ(ИдНСИ: Строка): ФизическиеЛица.Ссылка?
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            ФизическиеЛица.Ссылка КАК Ссылка,
            ФизическиеЛица.ПометкаУдаления КАК Метка
        ИЗ
            ФизическиеЛица КАК ФизическиеЛица
        ГДЕ
            ФизическиеЛица.ИдНСИ == %ИдНСИ
             И НЕ ФизическиеЛица.ПометкаУдаления
        УПОРЯДОЧИТЬ ПО 
            ФизическиеЛица.МмоментАктуализации
    }
    исп РезультатЗапроса = Запрос.Выполнить()
    пер Значение: ФизическиеЛица.Ссылка?
    если не РезультатЗапроса.Пусто()
        Значение = РезультатЗапроса.ПервыйИлиНеопределено().Ссылка
        РезультатЗапроса.Закрыть()
        возврат Значение
    ;
    возврат Значение
;

@ВПроекте
@НаСервере @ДоступноСКлиента
статический метод ПолучитьАккаунт(Ссылка: ФизическиеЛица.Ссылка?): Аккаунты.Ссылка?
    знч Запрос = Запрос{
        ВЫБРАТЬ
            ФизическиеЛица.Ссылка КАК Ссылка,
            ФизическиеЛица.Аккаунт КАК Аккаунт
        ИЗ
            ФизическиеЛица КАК ФизическиеЛица
        ГДЕ
            ФизическиеЛица.Ссылка == %Ссылка
             И ФизическиеЛица.ПометкаУдаления != Истина
    }
    возврат Запрос.Выполнить().Пусто() ? Неопределено : Запрос.Выполнить().ПервыйИлиНеопределено().Аккаунт
;