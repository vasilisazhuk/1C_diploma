импорт НСИ

@Локально
@НаСервере
статический метод СформироватьСотрудника(Сотрудник: Сотрудники.Ссылка): УзелОрганиграммы
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Сотрудники.Подразделение КАК Подразделение,
            Сотрудники.Наименование КАК Наименование,
            Сотрудники.Должность КАК Должность,
            Сотрудники.Ссылка КАК Ссылка,
            ФизическиеЛица.Фото КАК Фото
        ИЗ
            Сотрудники КАК Сотрудники
                ЛЕВОЕ СОЕДИНЕНИЕ ФизическиеЛица КАК ФизическиеЛица
                ПО Сотрудники.ФизическоеЛицо == ФизическиеЛица.Ссылка
        ГДЕ
            Сотрудники.Ссылка == %Сотрудник
    }
    пер Наименование = ""
    пер Объект: Сотрудники.Ссылка?
    пер Изображение: Null|ДвоичныйОбъект.Ссылка?
    пер Пояснение = ""
    пер Описание = ""
    пер ИдНСИ = ""
    пер Флаги: Массив<Флаг>
    для Строка из Запрос.Выполнить()
        Наименование = Строка.Наименование
        Объект = Строка.Ссылка
        ИдНСИ = Строка.Ссылка.Ид.ВСтроку()
        Изображение = Строка.Фото 
        Пояснение = Строки.Шаблон("$0", [Строка.Подразделение])
        Описание = Строки.Шаблон("$0", [Строка.Должность])
        Флаги.Добавить(новый Флаг("Это сотрудник", ""))
        Флаги.Добавить(новый Флаг("УбратьВидимостьНавигации", ""))
    ;
    если Изображение == Null или Изображение == Неопределено
        Изображение = Ресурс{user.svg}.Ссылка
        ;
    возврат новый УзелОрганиграммы(
        Наименование = Наименование,
        Изображение = Изображение как ДвоичныйОбъект.Ссылка?,
        ОбъектДанных = Объект,
        Пояснение = Пояснение,
        Описание = Описание,
        ИдНСИ = ИдНСИ, ДопФлаги = Флаги)
    
;

@ВПроекте
@НаСервере @ДоступноСКлиента
статический метод СформироватьЛинейнуюЦепочкуПодчинения(Сотрудник: Сотрудники.Ссылка): Массив<УзелОрганиграммы>
    знч Стек = новый Массив<УзелОрганиграммы>()
    //Стек.Добавить(СформироватьСотрудника(Сотрудник))
    пер Подчиненный: Сотрудники.Ссылка? = Сотрудник
    пер Руководитель: Сотрудники.Ссылка? = РаботаССотрудниками.ПолучитьЛинейногоРуководителя(Подчиненный)
    пока Подчиненный != Неопределено
        Стек.Добавить(СформироватьСотрудника(Подчиненный))
        если Руководитель == Неопределено
            //Стек.Добавить(СформироватьСотрудника(Подчиненный))
            прервать
        ;
        Подчиненный = Руководитель
        Руководитель = РаботаССотрудниками.ПолучитьЛинейногоРуководителя(Подчиненный)
    ;
    для Индекс = Стек.Граница() вниз по 1 
        Стек.Получить(Индекс).ДочерниеЭлементы = [Стек.Получить(Индекс -1)]       
    ;
    возврат [Стек[Стек.Граница()]]
;


@НаСервере @ДоступноСКлиента
@ВПроекте
статический метод СформироватьФункциональнуюЦепочкуПодчинения(Сотрудник: Сотрудники.Ссылка): Массив<УзелОрганиграммы>
    знч Стек = новый Массив<УзелОрганиграммы>()
    //Стек.Добавить(СформироватьСотрудника(Сотрудник))
    пер Подчиненный: Сотрудники.Ссылка? = Сотрудник
    пер Руководитель: Сотрудники.Ссылка? = РаботаССотрудниками.ПолучитьФункциональногоРуководителя(Подчиненный)
    пока Подчиненный != Неопределено
        Стек.Добавить(СформироватьСотрудника(Подчиненный))
        если Руководитель == Неопределено
            //Стек.Добавить(СформироватьСотрудника(Подчиненный))
            прервать
        ;
        Подчиненный = Руководитель
        Руководитель = РаботаССотрудниками.ПолучитьЛинейногоРуководителя(Подчиненный)
    ;
    для Индекс = Стек.Граница() вниз по 1
        Стек.Получить(Индекс).ДочерниеЭлементы = [Стек.Получить(Индекс - 1)]
    ;
    возврат [Стек[Стек.Граница()]]
;