импорт НСИ::ДоменОрганизационнаяСтруктура

@НаСервере
@Локально
статический метод ФорматироватьИнформациюПодразделения(Подразделение: Подразделения.Ссылка): УзелОрганиграммы
    знч УзнатьРуководителя = Запрос{
        ВЫБРАТЬ
            Подразделение.Ссылка КАК Ссылка,
            Подразделение.Наименование КАК Наименование,
            Подразделение.Руководитель КАК Руководитель
        ИЗ
            Подразделения КАК Подразделение
        ГДЕ
            Подразделение.Ссылка == %Подразделение
    }
    знч СтруктураИнформации = УзнатьРуководителя.Выполнить().Первый()
    знч НаименованиеПодразделение = СтруктураИнформации.Наименование
    знч Руководитель = СтруктураИнформации.Руководитель
    знч Узел =
        новый УзелОрганиграммы(Наименование = НаименованиеПодразделение, ОбъектДанных = СтруктураИнформации.Ссылка)
    знч Должность = РаботаССотрудниками.ПолучитьДолжность(Руководитель).Представление()
    знч ИнформацияРуководитель = Руководитель.Представление()
    знч Фото = РаботаССотрудниками.ПолучитьФото(Руководитель)
    если Фото == Неопределено и Руководитель != Неопределено
        Узел.Изображение = Ресурс{user.svg}.Ссылка
    иначе если Руководитель != Неопределено
        Узел.Изображение = Фото
    ;
    Узел.Наименование = НаименованиеПодразделение
    Узел.Описание = Строки.Шаблон("$0: $1", [Должность, ИнформацияРуководитель])
    
    возврат Узел
;

@НаСервере
@Локально
статический метод ПолучитьДочернееПодразделениеОбособленных(Подразделение: Подразделения.Ссылка): Массив<УзелОрганиграммы?>
    знч Список = новый Массив<УзелОрганиграммы?>()
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Подразделение.Ссылка КАК Ссылка,
            Подразделение.Наименование КАК Наименование,
            Подразделение.Руководитель КАК Руководитель
        ИЗ
            Подразделения КАК Подразделение
        ГДЕ
            Подразделение.ВышестоящееПодразделение == %Подразделение
             
    }
    исп РезультатЗапроса = Запрос.Выполнить()
    если РезультатЗапроса.Пусто()
        возврат Список
    ;
    для Элемент из РезультатЗапроса
        пер ДочерниеУзлы = ПолучитьДочернееПодразделение(Элемент.Ссылка)
            знч Узел = ФорматироватьИнформациюПодразделения(Подразделение = Элемент.Ссылка)
            Узел.ДочерниеЭлементы = ДочерниеУзлы
            Список.Добавить(Узел)
    ;
    РезультатЗапроса.Закрыть()
    возврат Список
;

@НаСервере
@Локально
статический метод ПолучитьДочернееПодразделение(Подразделение: Подразделения.Ссылка): Массив<УзелОрганиграммы?>
    знч Список = новый Массив<УзелОрганиграммы?>()
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Подразделение.Ссылка КАК Ссылка,
            Подразделение.Наименование КАК Наименование,
            Подразделение.Руководитель КАК Руководитель
        ИЗ
            Подразделения КАК Подразделение
        ГДЕ
            Подразделение.ВышестоящееПодразделение == %Подразделение
            
    }
    исп РезультатЗапроса = Запрос.Выполнить()
    если РезультатЗапроса.Пусто()
        возврат Список
    ;
    для Элемент из РезультатЗапроса

        пер ДочерниеУзлы = ПолучитьДочернееПодразделение(Элемент.Ссылка)

            знч Узел = ФорматироватьИнформациюПодразделения(Подразделение = Элемент.Ссылка)
            Узел.ДочерниеЭлементы = ДочерниеУзлы
            Список.Добавить(Узел)

    ;
    РезультатЗапроса.Закрыть()
    возврат Список
;

@НаСервере
@Локально
статический метод ЗапросКПодразделениямОбособленных(Источник: Подразделения.Ссылка): Массив<УзелОрганиграммы>
    знч Корень = новый Массив<УзелОрганиграммы>()

    знч Запрос = Запрос{
        ВЫБРАТЬ
            Подразделение.Ссылка КАК Ссылка,
            Подразделение.Наименование КАК Наименование,
            Подразделение.Организация КАК Организация,
            Подразделение.Руководитель КАК Руководитель,
            Подразделение.ВышестоящееПодразделение КАК ВышестоящееПодразделение
        ИЗ
            Подразделения КАК Подразделение
        ГДЕ
            Подразделение.ВышестоящееПодразделение == %Источник
    }
    исп РезультатЗапроса = Запрос.Выполнить()
    для Элемент из РезультатЗапроса
        пер Узел = ФорматироватьИнформациюПодразделения(Элемент.Ссылка)
        Узел.ДочерниеЭлементы = ПолучитьДочернееПодразделениеОбособленных(Элемент.Ссылка)
        Корень.Добавить(Узел)
    ;

    возврат Корень
;

@НаСервере @ДоступноСКлиента
@ВПроекте
статический метод ЗапросКПодразделениям(Источник: Подразделения.Ссылка): Массив<УзелОрганиграммы>

    пер Корень = новый УзелОрганиграммы(Наименование = Источник.Представление(), ОбъектДанных = Источник)
    
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Подразделение.Ссылка КАК Ссылка,
            Подразделение.Наименование КАК Наименование,
            Подразделение.Организация КАК Организация,
            Подразделение.Руководитель КАК Руководитель,
            Подразделение.ВышестоящееПодразделение КАК ВышестоящееПодразделение
        ИЗ
            Подразделения КАК Подразделение
        ГДЕ
            Подразделение.Ссылка == %Источник
    }
    исп РезультатЗапроса = Запрос.Выполнить()
    для Элемент из РезультатЗапроса
    
        
            Корень = ФорматироватьИнформациюПодразделения(Элемент.Ссылка)
        
        пер ДочерниеЭлементы = ПолучитьДочернееПодразделение(Элемент.Ссылка)
        Корень.ДочерниеЭлементы = ДочерниеЭлементы
   
    ;
   
    возврат [Корень]
;
