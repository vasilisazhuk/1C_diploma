импорт НСИ
импорт НСИ::ДоменОрганизационнаяСтруктура

@ВПроекте
@НаСервере @ДоступноСКлиента
статический метод ПолучитьВышестоящееПодразделение(Подразделение: Подразделения.Ссылка): Подразделения.Ссылка?
    пер ВышестоящееПодразделение: Подразделения.Ссылка?
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Подразделения.ВышестоящееПодразделение КАК ВышестоящееПодразделение
        ИЗ
            Подразделения КАК Подразделения
        ГДЕ
            Подразделения.Ссылка == %Подразделение
    }
    исп РезультатЗапроса = Запрос.Выполнить()
    знч Найдено = не РезультатЗапроса.Пусто()
    если не Найдено
        возврат Неопределено
    ;
    ВышестоящееПодразделение = РезультатЗапроса.Первый().ВышестоящееПодразделение
    РезультатЗапроса.Закрыть()
    возврат ВышестоящееПодразделение
;

@ВПроекте
@НаСервере @ДоступноСКлиента
статический метод ПолучитьРуководителя(Подразделение: Подразделения.Ссылка): Сотрудники.Ссылка?
    пер Руководитель: Сотрудники.Ссылка?
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Подразделения.Руководитель КАК Руководитель
        ИЗ
            Подразделения КАК Подразделения
        ГДЕ
            Подразделения.Ссылка == %Подразделение
    }
    исп РезультатЗапроса = Запрос.Выполнить()
    знч Найдено = не РезультатЗапроса.Пусто()
    если не Найдено
        возврат Неопределено
    ;
    Руководитель = РезультатЗапроса.Первый().Руководитель
    РезультатЗапроса.Закрыть()

    возврат Руководитель
;

@ВПроекте
@НаСервере @ДоступноСКлиента
статический метод НайтиПоИдНСИ(ИдНСИ: Строка): Подразделения.Ссылка?
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Подразделения.Ссылка КАК Ссылка,
            Подразделения.ПометкаУдаления КАК Метка
        ИЗ
            Подразделения КАК Подразделения
        ГДЕ
            Подразделения.ИдНСИ == %ИдНСИ
             И Подразделения.ПометкаУдаления != Истина
        УПОРЯДОЧИТЬ ПО
            Подразделения.МоментАктуализации
    }
    исп РезультатЗапроса = Запрос.Выполнить()
    пер Значение: Подразделения.Ссылка?
    если не РезультатЗапроса.Пусто()
        Значение = РезультатЗапроса.ПервыйИлиНеопределено().Ссылка
        РезультатЗапроса.Закрыть()
        возврат Значение
    ;
    возврат Значение
;

@ВПроекте
@НаСервере @ДоступноСКлиента
метод ЭтоЗГД(Подразделение: Подразделения.Ссылка): Булево
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Подразделения.Ссылка КАК Ссылка,
            Подразделения.ЭтоЗГД КАК ЭтоЗГД
        ИЗ
            Подразделения КАК Подразделения
        где 
        Подразделения.Ссылка == %Подразделение
    }
    исп РезультатЗапроса = Запрос.Выполнить()
    знч Найдено = не РезультатЗапроса.Пусто()
    если не Найдено
        РезультатЗапроса.Закрыть()
        возврат Ложь
    ;
    знч Результат = РезультатЗапроса.Первый().ЭтоЗГД
    РезультатЗапроса.Закрыть()

    возврат Результат
;

