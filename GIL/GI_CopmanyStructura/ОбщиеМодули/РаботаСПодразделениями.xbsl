@ВПроекте
@НаСервере @ДоступноСКлиента
метод ОтображатьНаСхеме(Подразделение: Подразделения.Ссылка): Булево
    знч Запрос = Запрос{
        ВЫБРАТЬ
            КОЛИЧЕСТВО(Сотрудники.Ссылка) КАК КоличествоСотрудников
        ИЗ
            Сотрудники КАК Сотрудники
        ГДЕ
            Сотрудники.Подразделение == %Подразделение
    }
    исп РезультатЗапроса = Запрос.Выполнить()
    возврат РезультатЗапроса.ЕдинственныйИлиНеопределено().КоличествоСотрудников > 0
;