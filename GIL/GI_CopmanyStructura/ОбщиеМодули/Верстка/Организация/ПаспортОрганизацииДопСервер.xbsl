импорт НСИ::ДоменОрганизационнаяСтруктура
импорт НСИ::ДоменЮридическаяСтруктура
импорт НСИ
//todo добавить вывод автора и даты последнего изменения
@ВПроекте
@НаСервере
метод ПолучитьИсторическиеНаименования(Организация: Организации.Ссылка?): Строка
    знч Запрос = Запрос{
        ВЫБРАТЬ
            ИсторияИзмененияНаименованияЮрЛицаТабличнаяЧасть.ОснованиеИзменения.ЗаменитьNull("") КАК ОснованиеИзменения,
            ИсторияИзмененияНаименованияЮрЛицаТабличнаяЧасть.ДатаИзменения.ЗаменитьNull("") КАК ДатаИзменения,
            ИсторияИзмененияНаименованияЮрЛицаТабличнаяЧасть.Наименование.ЗаменитьNull("") КАК Наименование,
            ИсторияИзмененияНаименованияЮрЛица.ЮрЛицо.ЗаменитьNull("") КАК ЮрЛицо
        ИЗ
            ИсторияИзмененияНаименованияЮрЛица.ТабличнаяЧасть КАК ИсторияИзмененияНаименованияЮрЛицаТабличнаяЧасть
                ЛЕВОЕ СОЕДИНЕНИЕ ИсторияИзмененияНаименованияЮрЛица КАК ИсторияИзмененияНаименованияЮрЛица
                ПО Истина
        ГДЕ
            ИсторияИзмененияНаименованияЮрЛица.ЮрЛицо == %Организация
    }
    пер Верстка = ""
    Верстка = Верстка + "<div class='org-history'><h3>Юридическое лицо: </h3><br>"
    для Строка из Запрос.Выполнить()
        Верстка = Верстка + "<div class='info-line'>%{Строка.Наименование.ВСтроку()} <span>%{Строка.ОснованиеИзменения
            .ВСтроку()} (%{Строка.ДатаИзменения.ВСтроку()})</span></div>"
    ;
    Верстка = Верстка + "</div>"
    возврат Верстка
;

@ВПроекте
@НаСервере
метод ПолучитьАкционеровКомпании(Орг: Организации.Ссылка?): Строка
    знч Запрос = Запрос{
        ВЫБРАТЬ
            АкционерыАкционеры.Акционер.ЗаменитьNull("") КАК Акционер,
            АкционерыАкционеры.Комментарий.ЗаменитьNull("") КАК Комментарий,
            Акционеры.ДатаАктуализации.ЗаменитьNull("") КАК ДатаАктуализации,
            ФизическиеЛица.Наименование.ЗаменитьNull("") КАК Наименование
        ИЗ
            Акционеры КАК Акционеры
                ЛЕВОЕ СОЕДИНЕНИЕ Акционеры.Акционеры КАК АкционерыАкционеры
                ПО Истина
                 И Акционеры.Ссылка == АкционерыАкционеры.Владелец
                ЛЕВОЕ СОЕДИНЕНИЕ Аккаунты КАК Аккаунты
                ПО Истина
                 И Аккаунты.ПользовательПриложения == Акционеры.Автор
                ЛЕВОЕ СОЕДИНЕНИЕ ФизическиеЛица КАК ФизическиеЛица
                ПО Истина
                 И ФизическиеЛица.Аккаунт == Аккаунты.Ссылка
        ГДЕ
            Акционеры.ОргЕдиница == %Орг
    }
    пер Верстка = ""
    пер Автор: Строка
    пер ДатаАктуализации: Строка
    Верстка = Верстка + "<div class='org-stockholder'><h3>Акционеры: </h3><br>"
    для Строка из Запрос.Выполнить()
        Верстка = Верстка + "<div class='info-line'>%{Строка.Наименование.ВСтроку()} <span>%{Строка.Акционер
            .ВСтроку()} (%{Строка.Комментарий.ВСтроку()})</span></div>"
        Автор = Строка.Наименование
        ДатаАктуализации = Строка.ДатаАктуализации.ВСтроку()
    ;
    Верстка = Верстка + "<div class='mod-section'> Дата последнего изменения:%{ДатаАктуализации} %{Автор}</div>"
    Верстка = Верстка + "</div>"
    возврат Верстка
;

@НаСервере
@ВПроекте
метод ПолучитьНаблюдательныйСовет(Орг: Организации.Ссылка?): Строка
    пер Верстка = ""
    пер Автор: Строка
    пер ДатаАктуализации: Строка
    знч Запрос = Запрос{
        ВЫБРАТЬ
            НаблюдательныйСоветСовет.Участник.ЗаменитьNull("") КАК Участник,
            НаблюдательныйСоветСовет.Должность.ЗаменитьNull("") КАК Должность,
            НаблюдательныйСоветСовет.Комментарий.ЗаменитьNull("") КАК Комментарий,
            ФизическиеЛица.Наименование.ЗаменитьNull("") КАК Наименование,
            НаблюдательныйСовет.ДатаАктуализации.ЗаменитьNull("") КАК ДатаАктуализации
        ИЗ
            НаблюдательныйСовет КАК НаблюдательныйСовет
                ЛЕВОЕ СОЕДИНЕНИЕ НаблюдательныйСовет.Совет КАК НаблюдательныйСоветСовет
                ПО Истина
                 И НаблюдательныйСовет.Ссылка == НаблюдательныйСоветСовет.Владелец
                ЛЕВОЕ СОЕДИНЕНИЕ Аккаунты КАК Аккаунты
                ПО Истина
                 И НаблюдательныйСовет.Автор == Аккаунты.ПользовательПриложения
                ЛЕВОЕ СОЕДИНЕНИЕ ФизическиеЛица КАК ФизическиеЛица
                ПО Истина
                 И ФизическиеЛица.Аккаунт == Аккаунты.Ссылка
        ГДЕ
            НаблюдательныйСовет.Организация == %Орг
    }
    Верстка = Верстка + "<div class='supervisiors'><h3>Наблюдательный совет: </h3><br>"
    для Строка из Запрос.Выполнить()
        Верстка = Верстка + "<div class='info-line'>%{Строка.Наименование.ВСтроку()} <span>%{Строка.Участник
            .ВСтроку()} (%{Строка.Комментарий.ВСтроку()})</span></div>"
        Автор = Строка.Наименование
        ДатаАктуализации = Строка.ДатаАктуализации.ВСтроку()
    ;
    Верстка = Верстка + "<div class='mod-section'> Дата последнего изменения:%{ДатаАктуализации} %{Автор}</div>"
    Верстка = Верстка + "</div>"

    возврат Верстка
;

@ВПроекте
@НаСервере
метод ПолучитьНазначениеРуководителя(Орг: Организации.Ссылка?): Строка
    пер Верстка = ""
    пер Автор: Строка
    пер ДатаАктуализации: Строка
    знч Запрос = Запрос{
        ВЫБРАТЬ
            НазначениеРуководителя.СсылкаВСЭД.ЗаменитьNull("") КАК СсылкаВСЭД,
            НазначениеРуководителя.ДатаАктуализации.ЗаменитьNull("") КАК ДатаАктуализации,
            НазначениеРуководителя.Автор.ЗаменитьNull("") КАК Автор,
            НазначениеРуководителяРуководители.Руководитель.ЗаменитьNull("") КАК Руководитель,
            НазначениеРуководителяРуководители.НазначаемаяДолжность.ЗаменитьNull("") КАК НазначаемаяДолжность,
            ФизическиеЛица.Наименование.ЗаменитьNull("") КАК Наименование
        ИЗ
            НазначениеРуководителя КАК НазначениеРуководителя
                ЛЕВОЕ СОЕДИНЕНИЕ НазначениеРуководителя.Руководители КАК НазначениеРуководителяРуководители
                ПО Истина
                 И НазначениеРуководителя.Ссылка == НазначениеРуководителяРуководители.Владелец
                ЛЕВОЕ СОЕДИНЕНИЕ Аккаунты КАК Аккаунты
                ПО Истина
                 И НазначениеРуководителя.Автор == Аккаунты.ПользовательПриложения
                ЛЕВОЕ СОЕДИНЕНИЕ ФизическиеЛица КАК ФизическиеЛица
                ПО Истина
                 И ФизическиеЛица.Аккаунт == Аккаунты.Ссылка
        ГДЕ
            НазначениеРуководителя.Организация == %Орг
    }
     Верстка = Верстка + "<div class='header'><h3>Руководители: </h3><br>"
    для Строка из Запрос.Выполнить()
        //todo кнопка на сэд
        Верстка = Верстка + "<div class='info-line'>%{Строка.Руководитель.ВСтроку()} <span>%{Строка.НазначаемаяДолжность
            .ВСтроку()}</span></div>"
        Автор = Строка.Наименование
        ДатаАктуализации = Строка.ДатаАктуализации.ВСтроку()
    ;
    Верстка = Верстка + "<div class='mod-section'> Дата последнего изменения:%{ДатаАктуализации} %{Автор}</div>"
    Верстка = Верстка + "</div>"
    возврат Верстка
;

@НаСервере
@ВПроекте
метод ПолучитьУставнойКапитал(Орг: Организации.Ссылка?): Строка
    пер Верстка = ""
    пер Автор: Строка
    пер ДатаАктуализации: Строка
    
    Верстка = Верстка + "<div class='capital'><h3>Уставной капитал: </h3><br>"

    Верстка = Верстка + "<div class='mod-section'> Дата последнего изменения:%{ДатаАктуализации} %{Автор}</div>"
    Верстка = Верстка + "</div>"

    возврат Верстка
;