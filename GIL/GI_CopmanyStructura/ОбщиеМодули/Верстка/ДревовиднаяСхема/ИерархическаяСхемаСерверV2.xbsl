@ВПроекте
@НаСервере
метод СформироватьУзелОрганиграммыПодразделение(УзелОрганиграммы: УзелОрганиграммы, Адрес: Строка): Строка
    знч Уид = УзелОрганиграммы.ИдНСИ
    знч Название = УзелОрганиграммы.Наименование
    пер Описание = ""
    пер Изображение = ""
    знч Пояснение = УзелОрганиграммы.Пояснение
    пер ЦветФона = ""
    пер Наименование = ""
    пер СсылкаНаПортал = ""
    если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ЭтоЗГД", Значение = "")) != Неопределено
        ЦветФона = "#007bff"
    иначе если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ЭтоПодразделениеПрямогоПодчинения",
                Значение = "")) != Неопределено
        ЦветФона = "#FFFACD"
        Наименование = "<h3 style ='border: 1px solid #ccc; font-size: 14px;'>%Название</h3>"
    иначе если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ЭтоУправление", Значение = "")) != Неопределено
        ЦветФона = "#ccebff"
        Наименование = "<h3 style ='border: 1px solid #ccc; font-size: 14px;'>%Название</h3>"
    иначе если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ЭтоФилиал", Значение = "")) != Неопределено
        ЦветФона = "#66c2ff"
        Наименование = "<h3 style ='border: 1px solid #ccc;font-size: 14px; '>%Название</h3>"
    иначе
        Наименование = "<h3 style ='border: 1px solid #ccc;font-size: 14px;'>%Название</h3>"
    ;
    если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ВыводитьРуководителя", Значение = "")) != Неопределено
        Описание = УзелОрганиграммы.Описание
        Изображение = ВерсткаОбщееСервер.ПолучитьСодержимоеФото(УзелОрганиграммы.Изображение, УзелОрганиграммы
                .Наименование)
    ;
    возврат
    "
    <div id=%Уид  class='tree-node' style='background-color:%ЦветФона;'>
    %Наименование
    <div class='tree-node_img'>%Изображение</div> 
    <div class = 'tree-node-description'>%Описание</div>
    <div><a class='btn-nav-ext' target='_blank' href='%{Пояснение}'>Найти на портале</a></div>
    </div>
    "
;

@ВПроекте
@НаСервере
метод СформироватьУзелОрганиграммыСотрудник(УзелОрганиграммы: УзелОрганиграммы, Адрес: Строка): Строка
    знч Уид = УзелОрганиграммы.ИдНСИ
    знч Название = УзелОрганиграммы.Наименование
    знч Описание = УзелОрганиграммы.Описание
    знч Изображение =
        ВерсткаОбщееСервер.ПолучитьСодержимоеФото(УзелОрганиграммы.Изображение, УзелОрганиграммы.Наименование)
    знч Пояснение = УзелОрганиграммы.Пояснение
    знч ВидимостьНавигации = УзелОрганиграммы.ДопФлаги.Найти(новый Флаг("УбратьВидимостьНавигации", ""))
    пер Кнопка = ВидимостьНавигации != Неопределено ? ""
        : "<div><a class='btn-nav-ext' target='_blank' href='%{Пояснение}'>Найти на портале</a></div>"
    возврат
    "
    <div id=%Уид  class='tree-node'> 
    <h3 style='font-size: 14px;'>%Название</h3>
    <div class='tree-node_img'>%Изображение</div> 
    <div class = 'tree-node-description'>%Описание</div>
    %Кнопка
    </div>
    "
;
//

@ВПроекте
@НаСервере
метод СформироватьУзелОрганиграммыОрганизация(УзелОрганиграммы: УзелОрганиграммы, Адрес: Строка): Строка
    знч Уид = УзелОрганиграммы.ИдНСИ
    знч Название = УзелОрганиграммы.Наименование
    знч Описание = УзелОрганиграммы.Описание
    знч Изображение = УзелОрганиграммы.Изображение == Неопределено ? ""
        : ВерсткаОбщееСервер.ПолучитьСодержимоеФото(УзелОрганиграммы.Изображение, УзелОрганиграммы.Наименование)
    знч Пояснение = УзелОрганиграммы.Пояснение
    знч ВидимостьНавигации = УзелОрганиграммы.ДопФлаги.Найти(новый Флаг("УбратьВидимостьНавигации", ""))
    пер Кнопка = ВидимостьНавигации != Неопределено ? ""
        : "<div><button class='btn-nav-ext' hx-get='%{Адрес}api/structure/card?id=%{Уид}' hx-target='#frontend'>Подробнее</button></div>"
    возврат
    "
    <a id=%Уид  class='tree-node'> 
    %Пояснение
    <h3 style='font-size: 14px;'>%Название</h3>
    <div class='tree-node_img'>%Изображение</div> 
    <div class = 'tree-node-description'>%Описание</div>
    %Кнопка
    </a>
    "
;

@Локально
@НаСервере
метод СформироватьСписокПодчиненныхДерево(УзелОрганиграммы: УзелОрганиграммы, Адрес: Строка): Строка
    пер Верстка = ""
    пер Сворачиваемость = ""
    пер УзелВерстка: Строка
    если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ЭтоЗГД", Значение = "")) != Неопределено
        УзелВерстка = СформироватьУзелОрганиграммыСотрудник(УзелОрганиграммы, Адрес)
    иначе если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг("Это подразделение", "")) != Неопределено
        УзелВерстка = СформироватьУзелОрганиграммыПодразделение(УзелОрганиграммы, Адрес)
    иначе если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг("Это сотрудник", "")) != Неопределено
        УзелВерстка = СформироватьУзелОрганиграммыСотрудник(УзелОрганиграммы, Адрес)
    иначе если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг("ЭтоОрганизация", "")) != Неопределено
        УзелВерстка = СформироватьУзелОрганиграммыОрганизация(УзелОрганиграммы, Адрес)
    //иначе если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ЭтоФилиал", Значение = "")) != Неопределено
    иначе
        УзелВерстка = СформироватьУзелОрганиграммыПодразделение(УзелОрганиграммы, Адрес)
    ;
    если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ЭтоУправление", Значение = "")) != Неопределено
        Верстка = Верстка + "<li class='list'>" + "<details class='tree-details' %Сворачиваемость><summary>"
            + УзелВерстка + "</summary>"
    иначе
        Верстка = Верстка + "<li class='tree'>" + "<details  class='tree-details'><summary>" + УзелВерстка
            + "</summary>"
    ;

    если не УзелОрганиграммы.ДочерниеЭлементы.Пусто()
        Верстка = Верстка + "<ul>"
        для Элемент из УзелОрганиграммы.ДочерниеЭлементы
            Верстка = Верстка + СформироватьСписокПодчиненныхДерево(Элемент, Адрес)
        ;
        Верстка = Верстка + "</ul>"
    ;
    Верстка = Верстка + "</details></li>"
    возврат Верстка
;

@ВПроекте
@НаСервере @ДоступноСКлиента
метод СформироватьДревовиднуюСхему(Массив: Массив<УзелОрганиграммы>, Адрес: Строка): Строка
    пер Верстка = ""
    пер Кнопки = Массив.Первый().ДопФлаги.Найти(новый Флаг("УбратьВидимостьНавигации", "")) != Неопределено ? "" : ВерсткаОбщееСервер.ПолучитьКнопкиМасштабирования()
    Верстка = Верстка + Кнопки
    Верстка = Верстка + "<div class='section-label'><h3>%{Массив.Первый()
        .Наименование}</h3></div><div class ='tree-schema' id ='org-structure'><ul>"
    пер ВыводитьФилиалы = Ложь
    для Элемент из Массив
        если Элемент.ДопФлаги.Найти(новый Флаг(Название = "ЭтоФилиал", Значение = "")) == Неопределено
            Верстка = Верстка + "<div class='section-tree'>"
            Верстка = Верстка + СформироватьСписокПодчиненныхДерево(Элемент, Адрес)
            Верстка = Верстка + "</div>"
        иначе
            ВыводитьФилиалы = Истина
        ;
    ;
    если ВыводитьФилиалы
        Верстка = Верстка + "</ul></div>"
        Верстка = Верстка
            + "<div class='section-label'><h3>Филиалы и представительства</h3></div><div class ='tree-schema'><ul>"
        для Элемент из Массив
            если Элемент.ДопФлаги.Найти(новый Флаг(Название = "ЭтоФилиал", Значение = "")) != Неопределено
                Верстка = Верстка + "<div class='section-tree-branch'>"
                Верстка = Верстка + СформироватьСписокПодчиненныхДерево(Элемент, Адрес)
                Верстка = Верстка + "</div>"
            ;
        ;
    ;
    Верстка = Верстка + "</ul></div>"
    Верстка = Верстка + ВерсткаОбщееСервер.ПолучитьСкриптМасштабирования()
    возврат Верстка
;