@ВПроекте
@НаСервере
метод СформироватьУзелОрганиграммыПодразделение(УзелОрганиграммы: УзелОрганиграммы, Адрес: Строка): Строка
    знч Уид = УзелОрганиграммы.ИдНСИ
    знч Название = УзелОрганиграммы.Наименование
    пер Описание = ""
    пер Изображение = ""
    знч Пояснение = УзелОрганиграммы.Пояснение
    пер ЦветФона = ""
    пер Наименование = ""
    пер СсылкаНаПортал = ""
    пер Якорь = ""
    если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ЭтоЗГД", Значение = "")) != Неопределено
        ЦветФона = "rgb(212, 255, 183)"
    иначе если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ЭтоПодразделениеПрямогоПодчинения",
                Значение = "")) != Неопределено
        ЦветФона = "rgb(255, 255, 255)"
        Наименование = "<h3 style ='border: 1px solid #ccc; font-size: 14px;'>%Название</h3>"
    иначе если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ЭтоУправление", Значение = "")) != Неопределено
        ЦветФона = "rgb(217, 217, 217)"
        Наименование = "<h3 style ='border: 1px solid #ccc; font-size: 14px;'>%Название</h3>"
    иначе если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ЭтоФилиал", Значение = "")) != Неопределено
        ЦветФона = "rgb(187, 249, 255)"
        Наименование = "<h3 style ='border: 1px solid #ccc;font-size: 14px; '>%Название</h3>"
    иначе
        Наименование = "<h3 style ='border: 1px solid #ccc;font-size: 14px;'>%Название</h3>"
    ;
    если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ВыводитьРуководителя", Значение = "")) != Неопределено
        Описание = УзелОрганиграммы.Описание
        Изображение = ВерсткаОбщееСервер.ПолучитьСодержимоеФото(УзелОрганиграммы.Изображение, УзелОрганиграммы
                .Наименование)
    ;
    если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "Якорь", Значение = "")) != Неопределено
        Якорь = "<div id='anchor'></div>"
    ;
    если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "РуководительНеЗаполнен", Значение = "")) != Неопределено
        Описание = ""
        Изображение = ВерсткаОбщееСервер.ПолучитьСодержимоеФото(
            Ресурс{office-team-teamwork-business-partnership-svgrepo-com.svg}.Ссылка)
    ;
    возврат
    "
    <div id=%Уид  class='tree-node' style='background-color:%ЦветФона;'>
    %Якорь
    %Наименование
    <div class='tree-node_img'>%Изображение</div> 
    <div class = 'tree-node-description'>%Описание</div>
    <div><a class='btn-nav-ext' target='_blank' href='%{Пояснение}'>Найти на портале</a></div>
    </div>
    "
;

@ВПроекте
@НаСервере
метод СформироватьУзелОрганиграммыСотрудник(УзелОрганиграммы: УзелОрганиграммы, Адрес: Строка): Строка
    знч Уид = УзелОрганиграммы.ИдНСИ
    знч Название = УзелОрганиграммы.Наименование
    знч Описание = УзелОрганиграммы.Описание
    пер ЦветФона = ""
    пер Якорь = ""
    знч Изображение =
        ВерсткаОбщееСервер.ПолучитьСодержимоеФото(УзелОрганиграммы.Изображение, УзелОрганиграммы.Наименование)
    знч Пояснение = УзелОрганиграммы.Пояснение
    знч ВидимостьНавигации = УзелОрганиграммы.ДопФлаги.Найти(новый Флаг("УбратьВидимостьНавигации", ""))
    пер Кнопка = ВидимостьНавигации != Неопределено ? ""
        : "<div><a class='btn-nav-ext' target='_blank' href='%{Пояснение}'>Найти на портале</a></div>"
    если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ЭтоЗГД", Значение = "")) != Неопределено
        ЦветФона = "rgb(124, 255, 157)"
        
    ;
    если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "Якорь", Значение = "")) != Неопределено
        Якорь = "<div id='anchor'></div>"
    ;
    возврат
    "
    <div id=%Уид  class='tree-node' style='background-color:%ЦветФона;'> 
    %Якорь
    <h3 style='font-size: 14px;'>%Название</h3>
    <div class='tree-node_img'>%Изображение</div> 
    <div class = 'tree-node-description'>%Описание</div>
    %Кнопка
    </div>
    "
;
//

@ВПроекте
@НаСервере
метод СформироватьУзелОрганиграммыОрганизация(УзелОрганиграммы: УзелОрганиграммы, Адрес: Строка): Строка
    знч Уид = УзелОрганиграммы.ИдНСИ
    знч Название = УзелОрганиграммы.Наименование
    знч Описание = УзелОрганиграммы.Описание
    пер Якорь = ""
    пер ЦветФона = ""
    знч Изображение = УзелОрганиграммы.Изображение == Неопределено ? ""
        : ВерсткаОбщееСервер.ПолучитьСодержимоеФото(УзелОрганиграммы.Изображение, УзелОрганиграммы.Наименование)
    знч Пояснение = УзелОрганиграммы.Пояснение
    знч ВидимостьНавигации = УзелОрганиграммы.ДопФлаги.Найти(новый Флаг("УбратьВидимостьНавигации", ""))
    если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ЭтоПроект", Значение = "")) != Неопределено
        ЦветФона = "#dbdbdb"
    ;
    если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг("Якорь", "")) != Неопределено
        Якорь = "<div id='anchor'></div>"
    ;
    пер Кнопка =
        "<div><button class='btn-nav-ext' hx-get='%{Адрес}api/structure/card?id=%{Уид}' hx-target='#frontend'>Подробнее</button></div>"
    возврат
    "
    <a id=%Уид  class='tree-node' style='background-color:%ЦветФона;'> 
    %Якорь
    %Пояснение
    <h3 style='font-size: 14px;'>%Название</h3>
    <div class='tree-node_img'>%Изображение</div> 
    <div class = 'tree-node-description'>%Описание</div>
    %Кнопка
    </a>
    "
;

@Локально
@НаСервере
метод СформироватьСписокПодчиненныхДерево(УзелОрганиграммы: УзелОрганиграммы, Адрес: Строка): Строка
    пер Верстка = ""
    пер ВерсткаГруппыПрямогоПодчинения = ""
    пер УзелВерстка: Строка
    //если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "Выводить", Значение = "")) != Неопределено
    если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ЭтоЗГД", Значение = "")) != Неопределено
        УзелВерстка = СформироватьУзелОрганиграммыСотрудник(УзелОрганиграммы, Адрес)
    иначе если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг("Это подразделение", "")) != Неопределено
        УзелВерстка = СформироватьУзелОрганиграммыПодразделение(УзелОрганиграммы, Адрес)
    иначе если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг("Это сотрудник", "")) != Неопределено
        УзелВерстка = СформироватьУзелОрганиграммыСотрудник(УзелОрганиграммы, Адрес)
    иначе если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг("ЭтоОрганизация", "")) != Неопределено
        УзелВерстка = СформироватьУзелОрганиграммыОрганизация(УзелОрганиграммы, Адрес)
    //иначе если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ЭтоФилиал", Значение = "")) != Неопределено
    иначе
        УзелВерстка = СформироватьУзелОрганиграммыПодразделение(УзелОрганиграммы, Адрес)
    ;
    /*если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ЭтоУправление", Значение = "")) != Неопределено
        Верстка = Верстка + "<li class='list'>" + "<details class='tree-details' open><summary>"
            + УзелВерстка + "</summary>"
    иначе
        Верстка = Верстка + "<li class='tree'>" + "<details  class='tree-details' open><summary>" + УзелВерстка
            + "</summary>"
    ;*/
    если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ЭтоУправление", Значение = "")) != Неопределено
        Верстка = Верстка + "<li class='list'>" + "<div class='tree-details'>" + УзелВерстка
            + ""
    иначе
        Верстка = Верстка + "<li class='tree'>" + "<div  class='tree-details'>" + УзелВерстка
            + ""
    ;
    //;
    если не УзелОрганиграммы.ДочерниеЭлементы.Пусто()
        если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ЕстьПрямоеПодчинение", Значение = ""))
                != Неопределено
            ВерсткаГруппыПрямогоПодчинения = "<li class='list'><ul>"
        ;
        Верстка = Верстка + "<ul>"
        для Элемент из УзелОрганиграммы.ДочерниеЭлементы
            если Элемент.ДопФлаги.Найти(новый Флаг(Название = "ЭтоПодразделениеПрямогоПодчинения",
                Значение = "")) != Неопределено
                ВерсткаГруппыПрямогоПодчинения = ВерсткаГруппыПрямогоПодчинения + СформироватьСписокПодчиненныхДерево(
                    Элемент, Адрес)
            иначе
                Верстка = Верстка + СформироватьСписокПодчиненныхДерево(
                    Элемент, Адрес)
            ;
        ;
        если УзелОрганиграммы.ДопФлаги.Найти(новый Флаг(Название = "ЕстьПрямоеПодчинение", Значение = ""))
                != Неопределено
            ВерсткаГруппыПрямогоПодчинения = ВерсткаГруппыПрямогоПодчинения + "</ul></li>"
        ;
        Верстка = Верстка + ВерсткаГруппыПрямогоПодчинения
        Верстка = Верстка + "</ul>"
    ;
    //Верстка = Верстка + ВерсткаГруппыПрямогоПодчинения
    Верстка = Верстка + "</details></li>"
    возврат Верстка
;

@ВПроекте
@НаСервере @ДоступноСКлиента
метод СформироватьДревовиднуюСхему(Массив: Массив<УзелОрганиграммы>, Адрес: Строка): Строка
    пер Верстка = ""
    пер Компонент = Массив.Первый().ИдНСИ
    пер Кнопки = Массив.Первый().ДопФлаги.Найти(новый Флаг("УбратьВидимостьНавигации", "")) != Неопределено ? ""
        : ВерсткаОбщееСервер.ПолучитьКнопкиМасштабирования("main")
    Верстка = Верстка + "<div class='tree-container'>"
    Верстка = Верстка + "<div class='section-label'><h3>%{Массив.Первый()
        .Наименование}</h3></div>"
    Верстка = Верстка + Кнопки
    Верстка = Верстка
        + "<div class='isolate' id ='isolate-main'><div class ='tree-schema-main' id ='org-structure-%{Компонент}' data-role='draggable'><ul>"
    
    пер ВыводитьФилиалы = Ложь
    //Верстка = Верстка + "<div class='section-tree-main'>"
    для Элемент из Массив
        если Элемент.ДопФлаги.Найти(новый Флаг(Название = "ЭтоФилиал", Значение = "")) == Неопределено
            Верстка = Верстка + "<div class='section-tree'>"
            Верстка = Верстка + СформироватьСписокПодчиненныхДерево(Элемент, Адрес)
            Верстка = Верстка + "</div>"
        иначе
            ВыводитьФилиалы = Истина
        ;
    ;
    //Верстка = Верстка + "</div>"
    если ВыводитьФилиалы
        Верстка = Верстка + "</ul></div></div>"
        Верстка = Верстка + "<div class='section-label'><h3>Филиалы и представительства</h3></div>%{ВерсткаОбщееСервер
            .ПолучитьКнопкиМасштабирования(
            "branch")}<div class='isolate' id ='isolate-brach'><div class ='tree-schema-branch' data-role='draggable'><ul>"
        для Элемент из Массив
            если Элемент.ДопФлаги.Найти(новый Флаг(Название = "ЭтоФилиал", Значение = "")) != Неопределено
                Верстка = Верстка + "<div class='section-tree'>"
                Верстка = Верстка + СформироватьСписокПодчиненныхДерево(Элемент, Адрес)
                Верстка = Верстка + "</div>"
            ;
        ;
    ;
    Верстка = Верстка + "</ul></div></div>"
    Верстка = Верстка + "</div>"
    Верстка = Верстка + ВерсткаОбщееСервер.ПолучитьСкриптМасштабирования("main")
    Верстка = Верстка + ВерсткаОбщееСервер.ПолучитьСкриптМасштабирования("branch")
//Верстка = Верстка + ВерсткаОбщееСервер.ПолучитьСкриптЦентрирования(Компонент)
    //Верстка = Верстка + ВерсткаОбщееСервер.ПолучитьСкриптDragDrop(Компонент = "org-structure-%{Компонент}")
    возврат Верстка
;