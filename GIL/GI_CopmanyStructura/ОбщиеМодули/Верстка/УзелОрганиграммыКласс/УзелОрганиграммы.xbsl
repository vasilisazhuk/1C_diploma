@ВПодсистеме
статический метод ДобавитьДочернийЭлементУзла(Приемник: УзелОрганиграммы, Элемент: УзелОрганиграммы)
    Приемник.ДочерниеЭлементы.Добавить(Элемент)
;
@ВПодсистеме
статический метод ВЭлементОрганиграммы(Узел: УзелОрганиграммы): ЭлементОрганиграммы?
    пер ДочерниеЭлементы = новый Массив<ЭлементОрганиграммы>()
    Узел.ДочерниеЭлементы.ДляКаждого(элемент -> ДочерниеЭлементы.Добавить(ВЭлементОрганиграммы(элемент)))
    возврат новый ЭлементОрганиграммы(
        Наименование = Узел.Наименование,
        Изображение = Узел.Изображение,
        Описание = Узел.Описание,
        Пояснение = Узел.Пояснение,
        Свернут = Истина,
        //Свернут = Узел.Свернут,
        ДочерниеЭлементы = ДочерниеЭлементы,
        Данные = Узел.ОбъектДанных)
;