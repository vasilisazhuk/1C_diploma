@ВПроекте
@НаСервере @ДоступноСКлиента
метод ПолучитьСкриптDragDrop(Область: Строка = "main", Компонент: Строка = ""): Строка
    возврат
    "
    <script>
    const container = document.getElementById('frontend');
    let isDragging = false;
    let offsetX, offsetY;
    let startX, startY;
    let currentX = 0;
    let currentY = 0;
    let target = null;
    container.addEventListener('mousedown', (e) => { 
        target = e.target.closest('[data-role=draggable]');
        if (!target) {console.log('not found'); return};
        isDragging = true;
        //console.log('grabbed');
        target.classList.add('dragging');
        const style = window.getComputedStyle(target);
        const matrix = new DOMMatrix(style.transform);
        currentX = matrix.m41 || 0;
        currentY = matrix.m42 || 0;
        startX = e.clientX;
        startY = e.clientY;
        e.preventDefault();
        document.addEventListener('mousemove', onMouseMove);
        document.addEventListener('mouseup', onMouseUp);
    });
    function onMouseMove(e) {
        if (!isDragging) return;
            //const currentScale = localStorage.getItem('scale%{Область}');
        const containerRect = container.getBoundingClientRect();
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        let newX = currentX + dx;
        let newY = currentY + dy;
        let currentScale = localStorage.getItem('scale%{Область}');
        console.log(currentScale);
        const treeSchema = document.querySelector('.tree-schema-%{Область}');
        //const scale = localStorage.getItem('scale%{Область}');
        target.style.transform = 'translate(' + newX + 'px,' + newY + 'px) scale(' + currentScale + ')';
        localStorage.setItem('scale%{Область}',currentScale);
        
    }
    function onMouseUp() {
        //console.log('dropped');
        isDragging = false;
        target.classList.remove('dragging');
        document.removeEventListener('mousemove', onMouseMove);
        document.removeEventListener('mouseup', onMouseUp);
    }
    </script>
    "
;