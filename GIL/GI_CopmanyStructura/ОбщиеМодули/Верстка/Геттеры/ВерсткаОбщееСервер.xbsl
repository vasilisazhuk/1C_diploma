@ВПроекте
@НаСервере @ДоступноСКлиента
статический метод ИзображениеСтрокой(Изображение: ДвоичныйОбъект.Ссылка?): Строка
    попытка
        возврат Кодировки.Base64.КодироватьВСтроку(Изображение.Загрузить().ПолучитьБайты())
    поймать Исключение: неизвестно
        //Ресурс{user.svg}.Ссылка
        возврат Кодировки.Base64.КодироватьВСтроку(Ресурс{user.svg}.Ссылка.Загрузить().ПолучитьБайты())
    ;
;

@ВПроекте
@НаСервере @ДоступноСКлиента
статический метод ПолучитьТипИзображения(Изображение: ДвоичныйОбъект.Ссылка?): Строка
    попытка
        возврат Изображение.Загрузить().ТипСодержимого
    поймать Исключение: неизвестно
        возврат Ресурс{user.svg}.Ссылка.Загрузить().ТипСодержимого
    ;
;

@ВПроекте
@НаСервере @ДоступноСКлиента
статический метод ПолучитьСодержимоеФото(Изображение: ДвоичныйОбъект.Ссылка?|Null, ОписаниеИзображения = ""): Строка
    пер ИзображениеПроверено: ДвоичныйОбъект.Ссылка?
    если Изображение == Null
        ИзображениеПроверено = Ресурс{No Image SVG Icon.svg}.Ссылка
    иначе
        ИзображениеПроверено = Изображение как ДвоичныйОбъект.Ссылка?
    ;

    знч ИзображениеBase64 = ИзображениеСтрокой(ИзображениеПроверено)
    знч ТипИзображения = ПолучитьТипИзображения(ИзображениеПроверено)
    знч Результат = 
    "
    <div class = 'img--wrapper'>
        <img src='data:%{ТипИзображения};base64,%{ИзображениеBase64}' alt='%ОписаниеИзображения'>
    </div>
    "
    возврат Результат
;

@ВПроекте
метод ПолучитьКнопкуГлавнойИерархии(Адрес: Строка = ""): Строка
    знч Подразделение = УправлениеСостоянием.ПолучитьПодразделениеПоУмолчанию() == Неопределено ? ""
        : УправлениеСостоянием.ПолучитьПодразделениеПоУмолчанию().Ид.ВСтроку()
    возврат 
    "
    <div class='main-scheme'>
        <button class='btn-nav-ext' hx-get='%{Адрес}api/department/schema?id=%{Подразделение}' hx-target='#frontend'>Перейти к организационной структуре</button>
    </div>
    "
;

@ВПроекте
метод ПолучитьКнопкуЮридическойИерархии(Адрес: Строка = ""): Строка
    знч Организация = УправлениеСостоянием.ПолучитьОргЕдиницуПоУмолчанию() == Неопределено ? ""
        : УправлениеСостоянием.ПолучитьОргЕдиницуПоУмолчанию().Ид.ВСтроку()
    возврат 
    "
    <div class='main-scheme'>
        <button class='btn-nav-ext' hx-get='%{Адрес}api/structure/schema?id=%{Организация.ВСтроку()}' hx-target='#frontend'>Перейти к юридической структуре</button>
    </div>
    "
;

@ВПроекте
метод ПолучитьКнопкиГлавнойСтраницы(Адрес: Строка): Строка
    пер Верстка = "<div class='wrapper-navigation'>"
    Верстка = Верстка + ПолучитьКнопкуГлавнойИерархии(Адрес)
    Верстка = Верстка + ПолучитьКнопкуЮридическойИерархии(Адрес)
    возврат Верстка + "</div>"
;

@ВПроекте
метод ПолучитьКнопкиМасштабирования(Область: Строка = ""): Строка
    возврат 
    "
    <div class='wrapper-operation'>
        <div class='btn-oper-plus' id='zoomInBtn%{Область}'>+</div>
        <div class='btn-oper-minus' id='zoomOutBtn%{Область}'>-</div>
        <div class='zoom-value' id='zoomValue%{Область}' style='display: inline-block; margin-left: 15px; padding: 7px 15px; background: #0056b3; color: white; border-radius: 5px;'>100%</div>
    </div>
    "
;

@ВПроекте
@НаСервере @ДоступноСКлиента
метод ПолучитьСкриптHTMX(): Строка
    возврат "<script src='https://unpkg.com/htmx.org@1.9.4'></script>"
;

@ВПроекте
@НаСервере @ДоступноСКлиента
метод ПолучитьСкриптМасштабирования(Область: Строка = ""): Строка
    возврат 
    "
        <script>
(function() {
    let scale = 1;
    const minScale = 0.3;
    const maxScale = 2;
    const step = 0.1;
    const treeSchema = document.querySelector('.tree-schema%{Область}');
    const zoomValueDisplay = document.getElementById('zoomValue%{Область}');
    // Функция применения масштаба
    function applyZoom() {
        if (!treeSchema) return;
        treeSchema.style.transform = 'scale(' + scale + ')';
        //treeSchema.style.transformOrigin = 'top centre';
        // Обновляем отображение процентов
        if (zoomValueDisplay) {
            zoomValueDisplay.textContent = Math.round(scale * 100) + '%';
        }
    }
    function zoomIn() {
        if (scale + step <= maxScale) {
            scale += step;
            applyZoom();
        }
    }
    function zoomOut() {
        if (scale - step >= minScale) {
            scale -= step;
            applyZoom();
        }
    }
    // Назначаем обработчики событий
    const zoomInBtn = document.getElementById('zoomInBtn%{Область}');
    const zoomOutBtn = document.getElementById('zoomOutBtn%{Область}');
    if (zoomInBtn) {
        zoomInBtn.addEventListener('click', zoomIn);
    }
    if (zoomOutBtn) {
        zoomOutBtn.addEventListener('click', zoomOut);
    }
    //масштабирование колесиком мыши с зажатым Ctrl
    if (treeSchema) {
        treeSchema.addEventListener('wheel', function(e) {
            if (e.ctrlKey) {
                e.preventDefault();
                if (e.deltaY < 0) {
                    zoomIn();
                } else {
                    zoomOut();
                }
            }
        });
    }
    applyZoom();
})();
    </script>
    "
;