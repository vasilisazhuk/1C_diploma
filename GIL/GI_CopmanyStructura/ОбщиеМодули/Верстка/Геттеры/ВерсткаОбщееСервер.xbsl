;
@ВПроекте
@НаСервере @ДоступноСКлиента
метод ПолучитьСкриптHTMX(): Строка
    возврат "<script src='https://unpkg.com/htmx.org@1.9.4'></script>"
;

@ВПроекте
@НаСервере @ДоступноСКлиента
метод ПолучитьСкриптМасштабирования(Область: Строка = ""): Строка
    возврат
    "
        <script>
(function() {
    let scale = 1;
    const minScale = 0.3;
    const maxScale = 5;
    const step = 0.1;
    let oldScale = 1;
    const treeSchema = document.querySelector('.tree-schema-%{Область}');
    const zoomValueDisplay = document.getElementById('zoomValue-%{Область}');
    const zoomInBtn = document.getElementById('zoomInBtn-%{Область}');
    const zoomOutBtn = document.getElementById('zoomOutBtn-%{Область}');
    function applyZoom(focusX = null, focusY = null) {
    if (!treeSchema) return;

    const style = window.getComputedStyle(treeSchema);
    const matrix = new DOMMatrix(style.transform);
    let currentX = matrix.m41 || 0;
    let currentY = matrix.m42 || 0;
    
    // Пересчитываем координаты, чтобы точка фокуса осталась на месте
    if (focusX !== null && focusY !== null) {
        const rect = treeSchema.getBoundingClientRect();
        // Находим координаты курсора относительно самого элемента ДО масштабирования
        const mouseXInElement = (focusX - rect.left) / oldScale;
        const mouseYInElement = (focusY - rect.top) / oldScale;

        // Корректируем translate под новый масштаб
        currentX -= mouseXInElement * (scale - oldScale);
        currentY -= mouseYInElement * (scale -oldScale);
    }

    // Применяем изменения
    treeSchema.style.transform = 'translate(' + currentX + 'px,' + currentY + 'px) scale(' + scale + ')';
    
    localStorage.setItem('scale%{Область}', scale);
    
    if (zoomValueDisplay) {
        zoomValueDisplay.textContent = Math.round(scale * 100) + '%';
    }
}

function changeZoom(isZoomIn, focusX = null, focusY = null) {
    oldScale = scale; // Запоминаем старый масштаб для формулы
    
    if (isZoomIn) {
        if (scale + step <= maxScale) scale += step;
    } else {
        if (scale - step >= minScale) scale -= step;
    }
    
    applyZoom(focusX, focusY);
}

// Назначаем обработчики на кнопки (зум в центр карточки)
if (zoomInBtn) {
    zoomInBtn.addEventListener('click', () => {
        const rect = treeSchema.getBoundingClientRect();
        // Передаем центр карточки как точку фокуса
        changeZoom(true, rect.left + rect.width / 2, rect.top + rect.height / 2);
    });
}
if (zoomOutBtn) {
    zoomOutBtn.addEventListener('click', () => {
        const rect = treeSchema.getBoundingClientRect();
        changeZoom(false, rect.left + rect.width / 2, rect.top + rect.height / 2);
    });
}

// Масштабирование колесиком мыши (зум строго в точку курсора)
if (treeSchema) {
    treeSchema.addEventListener('wheel', function(e) {
        if (e.ctrlKey) {
            e.preventDefault();
            // Передаем точные координаты курсора e.clientX и e.clientY
            changeZoom(e.deltaY < 0, e.clientX, e.clientY);
        }
    });
}
    
    })();
    </script>
    "
;


