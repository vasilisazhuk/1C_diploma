@ВПроекте
@НаСервере @ДоступноСКлиента
метод ПолучитьСкриптЦентрирования(Компонент: Строка = ""): Строка
    возврат
    "
    <script>
    const container = document.getElementById('frontend');
    let element = document.getElementById('%{Компонент}');
    //element.scrollIntoView({ behavior:'smooth', inline: 'center', block: 'nearest'});
    const detailsElements = document.querySelectorAll('.tree-details');
    detailsElements.forEach(detail => {
        detail.addEventListener('toggle', function(event) {
            if (this.open) {
                element.scrollIntoView({ 
                    behavior: 'smooth', 
                    block: 'nearest', 
                    inline: 'center' 
                });
                console.log('Details opened:', this);
            }
        });
    });
    </script>
    "
;

@ВПроекте
@НаСервере @ДоступноСКлиента
метод ПолучитьСкриптDragDrop(Область: Строка = "", Компонент: Строка = ""): Строка
    возврат
    "
    <script>
    //const container = document.getElementById('frontend');
    //let draggableElement = document.getElementById('%{Компонент}');
    let isDragging = false;
    let offsetX, offsetY;
    let startX, startY;
    let currentX = 0;
    let currentY = 0;
    let target = null;
    container.addEventListener('mousedown', (e) => { 
        target = e.target.closest('[data-role=draggable]');
        if (!target) {console.log('not found'); return};
        isDragging = true;
        //console.log('grabbed');
        target.classList.add('dragging');
        const style = window.getComputedStyle(target);
        const matrix = new DOMMatrix(style.transform);
        currentX = matrix.m41 || 0;
        currentY = matrix.m42 || 0;
        startX = e.clientX;
        startY = e.clientY;
        e.preventDefault();
        document.addEventListener('mousemove', onMouseMove);
        document.addEventListener('mouseup', onMouseUp);
    });
    function onMouseMove(e) {
        if (!isDragging) return;
        const containerRect = container.getBoundingClientRect();
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        let newX = currentX + dx;
        let newY = currentY + dy;
        target.style.transform = 'translate(' + newX + 'px,' + newY + 'px)';
    }
    function onMouseUp() {
        //console.log('dropped');
        isDragging = false;
        target.classList.remove('dragging');
        document.removeEventListener('mousemove', onMouseMove);
        document.removeEventListener('mouseup', onMouseUp);
    }
    </script>
    "
;