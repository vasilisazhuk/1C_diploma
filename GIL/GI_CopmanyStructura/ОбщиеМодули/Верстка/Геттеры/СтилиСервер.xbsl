@НаСервере @ДоступноСКлиента
метод ПолучитьСтильИерархии(ЦветЭлемента: Строка = "#FFFFFF"): Строка
    возврат
    "
<style>* {
margin: 0;
padding: 0;
font-family: Arial;
}
.frontend{
    margin-top: 80px;
    //flex: 1;
}
[class=*'label']{
font-style: bold;
}
.tree-container{
    overflow-y: visible;
    overflow-x: visible;
    flex: 1;
}
.tree-node-description{
font-style: italic;
}
.tree-node_img {
display: flex;
justify-content: center;
}
.imp--wrapper{
display: flex;
justify-content: center;
}
.tree-node_img .img--wrapper img {
/*max-width: 50px;*/
max-height: 70px;
display: block;
justify-content: center;
}
.tree-node{
display: inline-flex;   /* Заменяем inline-block на inline-flex */
flex-direction: column;
padding: 5px 10px;
width: 250px;
height: 250px;
border: 1px solid #ccc;
border-radius: 2px;
text-decoration: none;
color: #444;
border-radius: 8px;
background-color: #FFFFFF;
font-size: 16px;
transition: all 0.5s;
margin: 0px;
vertical-align: top;
box-shadow: 0 2px 8px rgba(0,0,0,0.15);

white-space: normal;
word-wrap: break-word;
word-break: break-word;
overflow: hidden;
text-overflow: ellipsis;
}

.tree-node-description{
font-size: 12px;
}
.tree-schema {
overflow-x: auto;
display: flex;
position: relative;
padding: 20px;
justify-content: center;
white-space: nowrap;
transition: transform 0.2s ease;
transform-origin: top left;
/*min-width: max-content;*/
flex-direction: column;
}
.tree-schema ul,
.tree-schema li {
transform-origin: top left;
}
.tree-schema ul {
position: relative;
margin: 0 auto;
display: flex;
flex-wrap: nowrap;
overflow: visible;
padding: 20px 0;
}
.tree-schema li {
list-style-type: none;
position: relative;
float: left;
padding: 20px 5px 0 5px;
text-align: center;
flex: 0 0 auto;   /* запрещает сжатие/растяжение */
}
.tree-schema li.list > ul,
.tree-schema li.list > details > ul  {
display: flex;
flex-direction: column;
align-items: center;
margin-top: 10px;
}
.tree-schema li.tree > ul::before,
.tree-schema li.tree > details > ul::before {
content: '';
position: absolute;
top: 0;
left: 50%;
width: 0;
height: 20px;
border-left: 1px solid #ccc;
}
.tree-schema li.tree > ul > li::before,
.tree-schema li.tree > ul > li::after,
.tree-schema li.tree > details > ul > li::before,
.tree-schema li.tree > details > ul > li::after  {
content: '';
position: absolute;
top: 0;
right: 50%;
width: 50%;
height: 20px;
border-top: 1px solid #ccc;
}
.tree-schema li.tree > ul > li::after,
.tree-schema li.tree > details > ul > li::after {
right: auto;
left: 50%;
border-left: 1px solid #ccc;
}
.tree-details {
    display: block;
}
.tree-details > summary {
    //list-style: none;
    position: relative;
    cursor: pointer;
}
.tree-schema li.tree > ul > li:only-child::after,
.tree-schema li.tree > ul > li:only-child::before,
.tree-schema li.tree > details > ul > li:only-child::after,
.tree-schema li.tree > details > ul > li:only-child::before  {
display: none;
}

.tree-schema li.tree > ul > li:only-child,
.tree-schema li.tree > details > ul > li:only-child  {
padding-top: 0;
}
.tree-schema li.tree > ul > li:first-child::before,
.tree-schema li.tree > ul > li:last-child::after,
.tree-schema li.tree > details > ul > li:first-child::before,
.tree-schema li.tree > details > ul > li:last-child::after  {
border: 0 none;
}
.tree-schema li.tree > ul > li:last-child::before,
.tree-schema li.tree > details > ul > li:last-child::before {
border-right: 1px solid #ccc;
border-radius: 0 2px 0 0;
}
.tree-schema li.tree > ul > li:first-child::after,
.tree-schema li.tree > details > ul > li:first-child::after  {
border-radius: 2px 0 0 0;
}
.tree-node > div:last-child {
    margin-top: auto;
}
.updating-info{
opacity: 0.5;
font-size: 12px;
font-style: italic;
}
[class*='wrapper']{
   background: #ffffff;
   padding: 10px 15px;
   border-radius: 8px;
   box-shadow: 0 2px 8px rgba(0,0,0,0.15);
}
[class*='section']{
   background:rgb(211, 234, 255);
   padding: 10px 15px;
   border-radius: 8px; 
}
[class*='section-tree']{
background: #ffffff;
border: 1px solid #ccc; 
}
[class*='btn-'] {
display: inline-block;
padding: 7px 15px;
background-color: #007bff;
color: white;
border-radius: 5px;
cursor: pointer;
}
[class*='btn-']:hover {
color: white;
}
.btn-nav {
background-color:#007bff;
color: #ffffff;
}
.btn-nav:hover {
background-color: #0056b3;
color: #ffffff;
}
btn-nav-link{
    background-color: #ffffff;
}
.wrapper-operation{
    position: fixed;
    top: 20px;
       right: 20px;
       z-index: 9998;
       display: flex;
       flex-direction: row;
       flex-wrap: wrap;
       gap: 12px;
}
.wrapper-card {
    display: flex;
    margin: 10px;
    padding: 20px;
    color: #444;
    background-color: #ffffff;
    overflow-y: visible;
    flex-direction: column;
    height: 100%;
    margin-top: 80px;
}
</style>
"
