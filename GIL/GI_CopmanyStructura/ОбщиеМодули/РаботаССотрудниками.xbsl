@ВПроекте
@НаСервере @ДоступноСКлиента
статический метод НайтиПоИдНСИ(ИдНСИ: Строка): Сотрудники.Ссылка?
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Сотрудники.Ссылка КАК Ссылка,
            Сотрудники.ПометкаУдаления КАК Метка
        ИЗ
            Сотрудники КАК Сотрудники
        ГДЕ
            Сотрудники.ИдНСИ == %ИдНСИ
             И НЕ Сотрудники.ПометкаУдаления
        УПОРЯДОЧИТЬ ПО
            Сотрудники.МоментАктуализации
    }
    исп РезультатЗапроса = Запрос.Выполнить()
    пер Значение: Сотрудники.Ссылка?
    если не РезультатЗапроса.Пусто()
        Значение = РезультатЗапроса.ПервыйИлиНеопределено().Ссылка
        РезультатЗапроса.Закрыть()
        возврат Значение
    ;
    возврат Значение
;

@ВПроекте
@НаСервере @ДоступноСКлиента
статический метод НайтиПоИдШтатного(ИдНСИ: Строка): Сотрудники.Ссылка?
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Сотрудники.Ссылка КАК Ссылка,
            Сотрудники.ПометкаУдаления КАК Метка
        ИЗ
            Сотрудники КАК Сотрудники
        ГДЕ
            Сотрудники.ИдШтатногоРасписания == %ИдНСИ
             И НЕ Сотрудники.ПометкаУдаления
        
    }
    исп РезультатЗапроса = Запрос.Выполнить()
    пер Значение: Сотрудники.Ссылка?
    если не РезультатЗапроса.Пусто()
        Значение = РезультатЗапроса.ПервыйИлиНеопределено().Ссылка
        РезультатЗапроса.Закрыть()
        возврат Значение
    ;
    возврат Значение
;