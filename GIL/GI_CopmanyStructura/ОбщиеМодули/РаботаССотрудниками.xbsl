@ВПроекте
@НаСервере @ДоступноСКлиента
статический метод ПолучитьОрганизацию(СсылкаСотрудниик: Сотрудники.Ссылка?): Организации.Ссылка?
    пер Организация: Организации.Ссылка?

    знч Запрос = Запрос{
        ВЫБРАТЬ
            Сотрудники.Организация КАК Организация
        ИЗ
            Сотрудники КАК Сотрудники
        ГДЕ
            Сотрудники.Ссылка == %СсылкаСотрудниик
    }

    исп РезультатЗапроса = Запрос.Выполнить()
    знч Найдено = не РезультатЗапроса.Пусто()
    если не Найдено
        РезультатЗапроса.Закрыть()
        возврат Организация
    ;
    Организация = РезультатЗапроса.Первый().Организация
    РезультатЗапроса.Закрыть()
    возврат Организация != Неопределено ? Организация : Неопределено
;

@ВПроекте
@НаСервере @ДоступноСКлиента
метод ПолучитьФункциональногоРуководителя(СсылкаСотрудниик: Сотрудники.Ссылка?): Сотрудники.Ссылка?
    пер Руководитель: Сотрудники.Ссылка?
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Сотрудники.ФунРук КАК ФунРуководитель
        ИЗ
            Сотрудники КАК Сотрудники
        ГДЕ
            Сотрудники.Ссылка == %СсылкаСотрудниик
    }

    исп РезультатЗапроса = Запрос.Выполнить()

    если не РезультатЗапроса.Пусто()
        Руководитель = РезультатЗапроса.Первый().ФунРуководитель как Сотрудники.Ссылка?
        РезультатЗапроса.Закрыть()
    иначе
        РезультатЗапроса.Закрыть()
        //todo
        //обработка ошибки
        возврат Неопределено
    ;

    если Руководитель != Неопределено
        возврат Руководитель
    ;
    //возврат не РезультатЗапроса.Пусто() ? РезультатЗапроса.Первый().Подразделение : Подразделение
    возврат Руководитель
;

