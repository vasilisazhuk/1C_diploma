        //todo
        
        
        
        
        //обработка исключения
        //возврат эталонный элемент заглушка (вакантная позиция)
    ;
    //возврат не РезультатЗапроса.Пусто() ? РезультатЗапроса.Первый().Подразделение : Подразделение
    возврат Руководитель
;

