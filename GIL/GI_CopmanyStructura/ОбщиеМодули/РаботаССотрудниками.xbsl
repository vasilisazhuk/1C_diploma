@ВПроекте
@НаСервере @ДоступноСКлиента
статический метод ЭтоРуководитель(СотрудникСсылка: Сотрудники.Ссылка): Подразделения.Ссылка?
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Подразделения.Руководитель КАК Руководитель,
            Подразделения.Ссылка КАК Ссылка
        ИЗ
            Подразделения КАК Подразделения
        ГДЕ
            Подразделения.Руководитель == %СотрудникСсылка
    }
    исп РезультатЗапроса = Запрос.Выполнить()
    если РезультатЗапроса.Пусто()
        РезультатЗапроса.Закрыть()
        возврат Неопределено
    ;
    знч Подразделение = РезультатЗапроса.Первый().Ссылка

    РезультатЗапроса.Закрыть()
    возврат Подразделение
;

@ВПроекте
@НаСервере @ДоступноСКлиента
статический метод ПолучитьПолноеФИО(СсылкаСотрудниик: Сотрудники.Ссылка?): Строка
    знч Запрос = Запрос{
        ВЫБРАТЬ
            ФизическиеЛица.Ссылка КАК Ссылка,
            ФизическиеЛица.ФИО_Полное КАК ФИО_Полное
        ИЗ
            Сотрудники КАК Сотрудники
                ЛЕВОЕ СОЕДИНЕНИЕ ФизическиеЛица КАК ФизическиеЛица
                ПО Сотрудники.ФизическоеЛицо == ФизическиеЛица.Ссылка
        ГДЕ
            Сотрудники.Ссылка == %СсылкаСотрудниик
    }

    исп РезультатЗапроса = Запрос.Выполнить()
    знч Найдено = не РезультатЗапроса.Пусто() //и не РезультатЗапроса.Первый().Ссылка == Null
    если не Найдено
        РезультатЗапроса.Закрыть()
        возврат "Не найдено"
    ;
    знч Результат = РезультатЗапроса.Первый().ФИО_Полное как Строка
    РезультатЗапроса.Закрыть()
    возврат Результат != "" ? Результат : ""
;

@ВПроекте
@НаСервере @ДоступноСКлиента
статический метод ПолучитьСсылкуНаПортал(СсылкаСотрудниик: Сотрудники.Ссылка?): Строка
    знч Запрос = Запрос{
        ВЫБРАТЬ
            ФизическиеЛица.Ссылка КАК Ссылка,
            ФизическиеЛица.СсылкаНаПортал КАК СсылкаНаПортал
        ИЗ
            Сотрудники КАК Сотрудники
                ЛЕВОЕ СОЕДИНЕНИЕ ФизическиеЛица КАК ФизическиеЛица
                ПО Сотрудники.ФизическоеЛицо == ФизическиеЛица.Ссылка
        ГДЕ
            Сотрудники.Ссылка == %СсылкаСотрудниик
    }
    пер Результат: Строка

    если Запрос.Выполнить().Пусто()
        возврат ""
    ;
    знч РезультатЗапроса = Запрос.Выполнить().Первый()
    если РезультатЗапроса.Ссылка == Null
        возврат ""
    ;
    Результат = РезультатЗапроса.СсылкаНаПортал как Строка
    возврат Результат != "" ? Результат : УправлениеСостоянием.ПолучитьПорталПоУмолчанию()
;

@ВПроекте
@НаСервере @ДоступноСКлиента
статический метод ПолучитьФото(СсылкаСотрудниик: Сотрудники.Ссылка?): ДвоичныйОбъект.Ссылка?
    знч Запрос = Запрос{
        ВЫБРАТЬ
            ФизическиеЛица.Ссылка КАК Ссылка,
            ФизическиеЛица.Фото КАК Фото
        ИЗ
            Сотрудники КАК Сотрудники
                ЛЕВОЕ СОЕДИНЕНИЕ ФизическиеЛица КАК ФизическиеЛица
                ПО Сотрудники.ФизическоеЛицо == ФизическиеЛица.Ссылка
        ГДЕ
            Сотрудники.Ссылка == %СсылкаСотрудниик
    }
    исп РезультатЗапроса = Запрос.Выполнить()

    знч Найдено = не РезультатЗапроса.Пусто()
    если не Найдено
        РезультатЗапроса.Закрыть()
        возврат Ресурс{user.svg}.Ссылка
    ;
    пер Результат = РезультатЗапроса.Первый().Фото
    попытка
        Результат = Результат == Null ? Ресурс{No Image SVG Icon.svg}.Ссылка : Результат как ДвоичныйОбъект.Ссылка?
        возврат Результат как ДвоичныйОбъект.Ссылка?
    поймать Исключение: ИсключениеДвоичногоОбъекта
        возврат Ресурс{user.svg}.Ссылка
    ;
;

@ВПроекте
@НаСервере @ДоступноСКлиента
статический метод ПолучитьДолжность(СсылкаСотрудниик: Сотрудники.Ссылка?): Строка
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Сотрудники.Должность КАК Должность
        ИЗ
            Сотрудники КАК Сотрудники
        ГДЕ
            Сотрудники.Ссылка == %СсылкаСотрудниик
    }

    исп РезультатЗапроса = Запрос.Выполнить()
    знч Найдено = не РезультатЗапроса.Пусто()
    если не Найдено
        //обработать исключение
        РезультатЗапроса.Закрыть()
        возврат ""
    ;
    знч Результат = РезультатЗапроса.Первый().Должность
    РезультатЗапроса.Закрыть()
    возврат Результат
;

