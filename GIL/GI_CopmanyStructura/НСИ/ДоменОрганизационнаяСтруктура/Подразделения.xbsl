импорт ОбщиеМодули::Верстка::Геттеры
импорт ОбщиеМодули::ОргСтруктура
импорт ОбщиеМодули::Верстка::ДревовиднаяСхема
импорт ОбщиеМодули::ОргСтруктураНативная

@ВПроекте
@НаСервере
метод ПолучитьКарточкуПодразделения(): Строка
    возврат "Здесь будет карточка подразделения"
;

@НаСервере @ДоступноСКлиента
@ВПроекте
метод ПолучитьКарточкуПодразделенияСтрокой(Подразделение: Строка = "", Адрес: Строка = ""): Строка
    знч Ссылка = Подразделения.ПолучитьСсылку(новый Ууид(Подразделение))
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Подразделения.ИдНСИ КАК ИдНСИ,
            Подразделения.Наименование КАК Наименование,
            Подразделения.ВышестоящееПодразделение.Наименование КАК ВышестоящееНаименование,
            Подразделения.ВышестоящееПодразделение.Ссылка.Ид КАК ВышестоящееИдНСИ,
            Подразделения.ВышестоящееПодразделение.Ссылка КАК ВышестоящееСсылка,
            Сотрудники.Ссылка.Ид КАК РукИдНСИ,
            Сотрудники.Должность КАК РукДолжность,
            Сотрудники.Наименование КАК РукФИО,
            Сотрудники.ЛинРук.Наименование КАК ЛинФИО,
            Сотрудники.ЛинРук.Ссылка КАК ЛинИдНСИ,
            Сотрудники.ФунРук.Наименование КАК ФунФИО,
            Сотрудники.ФунРук.Ссылка КАК ФунИдНСИ,
            ФизическиеЛица.ФИО_Полное КАК РукФИО_Полное,
            ФизическиеЛица.Фото КАК РукФото,
            ФизическиеЛица.СсылкаНаПортал КАК РукСсылкаНаПортал,
            ФизическиеЛица.Аккаунт.ВнутрТелефон КАК РукВнутрТелефон,
            ФизическиеЛица.Аккаунт.РабТелефон КАК РукРабТелефон,
            ФизическиеЛица.Аккаунт.Мессенджер КАК РукМессенджер,
            ФизическиеЛица.Аккаунт.Email КАК РукEmail
        ИЗ
            Подразделения КАК Подразделения
                ЛЕВОЕ СОЕДИНЕНИЕ Сотрудники КАК Сотрудники
                ПО Подразделения.Руководитель == Сотрудники.Ссылка
                ЛЕВОЕ СОЕДИНЕНИЕ ФизическиеЛица КАК ФизическиеЛица
                ПО Сотрудники.ФизическоеЛицо == ФизическиеЛица.Ссылка
        ГДЕ
            Подразделения.Ссылка == %Ссылка
    }
    пер Верстка = ""
    Верстка = Верстка + "<div class='department-card' id=%{Подразделение}>"
    Верстка = Верстка + "<div class = 'info-section'>"
    для Строка из Запрос.Выполнить()
        Верстка = Верстка + "<h3>%{Строка.Наименование}</h3>"
        если Строка.ВышестоящееСсылка != Null
            Верстка = Верстка
                + "<p>Вышестоящее подразделение: <button class='btn-nav-link' hx-target='#frontend' hx-get='%{Адрес}api/department/card?id=%{Строка
                .ВышестоящееИдНСИ.ВСтроку()}'> %{Строка.ВышестоящееНаименование} </button></p>"
        ;
        пер СсылкаНаПортал = Строка.РукСсылкаНаПортал == "" ? УправлениеСостоянием.ПолучитьПорталПоУмолчанию()
            : Строка.РукСсылкаНаПортал
        Верстка = Верстка + "<p>"
        Верстка = Верстка + ВерсткаОбщееСервер.ПолучитьСодержимоеФото(Строка.РукФото)
        Верстка = Верстка +
        "
        Руководитель: <button class='btn-nav-link' hx-target='#frontend' hx-get='%{Адрес}api/employee/?id=%{Строка.РукИдНСИ
            .ВСтроку()}'> %{Строка.РукДолжность}: %{Строка
            .РукФИО}</button> <a class='btn-nav-ext' href='%{СсылкаНаПортал}' target='_blank'>Найти на портале</a><div class='eararchy'><p><button class='btn-nav-link' hx-get='%{Адрес}api/employee/?id=%{Строка
            .ФунИдНСИ.ВСтроку()}' hx-target='#frontend'> Функциональный Руководитель: %{Строка
            .ФунФИО}</button> <button class='btn-nav-link' hx-get='%{Адрес}api/employee/?id=%{Строка.ЛинИдНСИ
            .ВСтроку()}' hx-target='#frontend'>Линейный Руководитель: %{Строка.ЛинФИО}</button></p></div><div class='contact-info'>
        <p>Электронная почта: <span class='email'>%{Строка.РукEmail}</span></p>
        <p>Рабочий номер телефона: <span class='phone'>%{Строка.РукРабТелефон}</span></p>
        <p>Внутренний номер телефона: <span class='internal - phone'>%{Строка.РукРабТелефон}</span></p></div>
        "
        Верстка = Верстка + "</p>"
    ;
    Верстка = Верстка + "</div>"
    знч ЗапросСотрудников = Запрос{
        ВЫБРАТЬ
            Сотрудники.Ссылка КАК Ссылка,
            Сотрудники.Должность КАК Должность,
            Сотрудники.Наименование КАК Наименование,
            Сотрудники.ИдНСИ КАК ИдНСИ,
            ФизическиеЛица.Фото КАК Фото,
            ФизическиеЛица.СсылкаНаПортал КАК СсылкаНаПортал,
            Аккаунты.Email КАК Email
        ИЗ
            Сотрудники КАК Сотрудники
                ЛЕВОЕ СОЕДИНЕНИЕ ФизическиеЛица КАК ФизическиеЛица
                ПО Сотрудники.ФизическоеЛицо == ФизическиеЛица.Ссылка
                ЛЕВОЕ СОЕДИНЕНИЕ Аккаунты КАК Аккаунты
                ПО ФизическиеЛица.Аккаунт == Аккаунты.Ссылка
        ГДЕ
            Сотрудники.Подразделение == %Ссылка
             И Сотрудники.ПометкаУдаления != Истина
    }
    Верстка = Верстка + "<div class='employees-section'>"
    Верстка = Верстка + "<!-- <input type='text' class='search' placeholder='Поиск...' /> -->"
    Верстка = Верстка + "<table class='table-employee'>"
    Верстка = Верстка +
    "
    <thead>
    <tr><th>ФИО <!-- <button class='filter-button'>Фильтр</button> --></th><th>Должность <!--<button class='filter-button'>Фильтр</button> --></th><th>Email  <!-- <button class='filter-button'>Фильтр</button> --></th><th>Перейти на портал</th></tr>
    </thead>
    "
    Верстка = Верстка + "<tbody>"
    для Элемент из ЗапросСотрудников.Выполнить()
        Верстка = Верстка
            + "<tr><td><button class='btn-nav-link' hx-target='#frontend' hx-get='%{Адрес}api/employee/?id=%{Элемент.Ссылка
            .Ид.Представление()}'> %{Элемент.Наименование}</button></td><td>%{Элемент.Должность}</td><td>%{Элемент
            .Email}</td><td><a class='btn-nav-ext' target='_blank' href='%{Элемент
            .СсылкаНаПортал}'>Найти на портале</a></td></tr>"
    ;
    Верстка = Верстка + "</tbody>"
    Верстка = Верстка + "</table>"
    Верстка = Верстка + "</div>"
    Верстка = Верстка + "</div>"
    возврат Верстка
;

@НаСервере @ДоступноСКлиента
@ВПроекте
метод ПолучитьИерархиюПодразделенияСтрокой(Подразделение: Строка = "", Адрес: Строка = ""): Строка
    знч Ссылка = Подразделения.ПолучитьСсылку(новый Ууид(Подразделение))
    знч Узел = ОрганизационнаяСтруктураСервер.ПредставлениеСтруктуры(Ссылка)
    возврат "<div id=%{Подразделение}><div class='department-schema'>" + ИерархическаяСхемаСерверV2
        .СформироватьДревовиднуюСхему(Узел, Адрес) + "</div></div>"
        
;