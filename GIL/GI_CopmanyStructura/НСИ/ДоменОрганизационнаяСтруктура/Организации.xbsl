импорт ОбщиеМодули::Верстка::УзелОрганиграммыКласс
импорт ОбщиеМодули::ЮрСтруктура
импорт ОбщиеМодули::Верстка::ДревовиднаяСхема

@ВПроекте
метод ПолучитьИерархиюОрганизацийСтрокой(Организация: Строка, Адрес: Строка = "", Тип: Строка? = Неопределено): Строка
    знч Ссылка = Организации.ПолучитьСсылку(новый Ууид(Организация))
    пер Узел: Массив<УзелОрганиграммы>
    выбор Тип
    когда "leg"
    когда "fin"
    когда "tax"
    когда "org"
    иначе
         Узел = ЮридическаяСтруктураСервер.ПредставлениеСтруктуры(Ссылка)
    ;
    пер Верстка = ""
    Верстка = Верстка + "<div id=%{Организация}><div class='organization-schema'>"
    Верстка = Верстка + ИерархическаяСхемаСерверV2.СформироватьДревовиднуюСхему(Узел, Адрес)
    Верстка = Верстка + "</div></div>"
    возврат Верстка
;

@ВПроекте
метод ПолучитьКарточкуОргЕдиницыСтрокой(Организация: Строка, Адрес: Строка = ""): Строка
    знч Ссылка = Организации.ПолучитьСсылку(новый Ууид(Организация))
    пер Верстка = ""
    Верстка = Верстка + "<div id=%{Организация}><div class='wrapper-organization'>"
    Верстка = Верстка + ЮридическаяИнформацияСервер.ПолучитьКарточкуОргЕдиницы(Ссылка, Адрес)
    Верстка = Верстка + "</div></div>"
    возврат Верстка
;