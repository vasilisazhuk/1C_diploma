@НаСервере @ДоступноСКлиента
@ВПроекте
статический метод АккаунтПриложения(): Аккаунты.Ссылка?
    знч Пользователь = Пользователи.ТекущийПользователь
    знч Результат = Запрос{
        ВЫБРАТЬ
            Аккаунты.Ссылка КАК Ссылка
        ИЗ
            Аккаунты КАК Аккаунты
        ГДЕ
            Аккаунты.ПользовательПриложения == %Пользователь
    }
    пер Аккаунт: Аккаунты.Ссылка?
    если Результат.Выполнить().Пусто()
        возврат Неопределено
    иначе
        Аккаунт = Результат.Выполнить().Первый().Ссылка
        возврат Аккаунт
    ;
;

@ВПроекте
@НаСервере @ДоступноСКлиента
статический метод АккаунтПриложения(Пользователь: Пользователи.Ссылка?): Аккаунты.Ссылка?
    //знч Пользователь = Пользователи.ТекущийПользователь
    знч Результат = Запрос{
        ВЫБРАТЬ
            Аккаунты.Ссылка КАК Ссылка
        ИЗ
            Аккаунты КАК Аккаунты
        ГДЕ
            Аккаунты.ПользовательПриложения == %Пользователь
    }
    пер Аккаунт: Аккаунты.Ссылка?
    если Результат.Выполнить().Пусто()
        возврат Неопределено
    иначе
        Аккаунт = Результат.Выполнить().Первый().Ссылка
        возврат Аккаунт
    ;
;

