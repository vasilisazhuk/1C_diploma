@ВПроекте
метод ПолучитьКонтактнуюИнформацию(): КонтактнаяИнформация
    знч Информация = новый КонтактнаяИнформация(Владелец = этот.Ссылка)
    
    Информация.Мессенджер = этот.Мессенджер
    Информация.ВнутреннийТелефон = этот.ВнутрТелефон
    Информация.РабочийТелефон = этот.РабТелефон
    Информация.Email = этот.Email
    
    возврат Информация
;