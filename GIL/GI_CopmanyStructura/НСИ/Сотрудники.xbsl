импорт ОбщиеМодули::Верстка::Геттеры

@ВПроекте
@НаСервере
метод ПолучитьКарточкуСотрудникаСтрокой(Сотрудник: Строка = "", Адрес: Строка = ""): Строка
    знч Ссылка = Сотрудники.ПолучитьСсылку(новый Ууид(Сотрудник))
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Сотрудники.Ссылка.Ид КАК СсылкаСотрудник,
            Сотрудники.ИдНСИ КАК РукИдНСИ,
            Сотрудники.Подразделение.Ид как Подразделение,
            Сотрудники.Подразделение.Наименование как ПодразделениеНаименование,
            Сотрудники.Должность КАК РукДолжность,
            Сотрудники.Наименование КАК РукФИО,
            Сотрудники.ЛинРук.Наименование КАК ЛинФИО,
            Сотрудники.ЛинРук.ИдНСИ КАК ЛинИдНСИ,
            Сотрудники.ФунРук.Наименование КАК ФунФИО,
            Сотрудники.ФунРук.ИдНСИ КАК ФунИдНСИ,
            ФизическиеЛица.ФИО_Полное КАК РукФИО_Полное,
            ФизическиеЛица.Фото КАК РукФото,
            ФизическиеЛица.СсылкаНаПортал КАК РукСсылкаНаПортал,
            ФизическиеЛица.Аккаунт.ВнутрТелефон КАК РукВнутрТелефон,
            ФизическиеЛица.Аккаунт.РабТелефон КАК РукРабТелефон,
            ФизическиеЛица.Аккаунт.Мессенджер КАК РукМессенджер,
            ФизическиеЛица.Аккаунт.Email КАК РукEmail
        ИЗ
            Сотрудники КАК Сотрудники
                ЛЕВОЕ СОЕДИНЕНИЕ ФизическиеЛица КАК ФизическиеЛица
                ПО Сотрудники.ФизическоеЛицо == ФизическиеЛица.Ссылка
        ГДЕ
            Сотрудники.Ссылка == %Ссылка
    }
    пер Верстка = ""
    Верстка = Верстка + "<div class='wrapper-card' id=%{Сотрудник}>"
    Верстка = Верстка + "<div class='employee-card'>"
    Верстка = Верстка + "<div class = 'info-section'>"
    для Строка из Запрос.Выполнить()
        Верстка = Верстка + "<h3>%{Строка.РукФИО}</h3>"
        Верстка = Верстка + "<p>"
        Верстка = Верстка + ВерсткаОбщееСервер.ПолучитьСодержимоеФото(Строка.РукФото)
        Верстка = Верстка +
        "
        Подразделение: <button class='nav-link' hx-target='#frontend' hx-get='%{Адрес}api/department/card?id=%{Строка
            .Подразделение.ВСтроку()}'> %{Строка.ПодразделениеНаименование}</button><div class='eararchy'><p><button class='nav-link' hx-get='%{Адрес}api/employee/?id=%{Строка
            .ФунИдНСИ}' hx-target='#frontend'> Функциональный Руководитель: %{Строка
            .ФунФИО}</button> <button class='nav-link' hx-get='%{Адрес}api/employee/?id=%{Строка
            .ЛинИдНСИ}' hx-target='#frontend'>Линейный Руководитель: %{Строка.ЛинФИО}</button></p></div><div class='contact - info'>
        <p>Электронная почта: <span class='email'>%{Строка.РукEmail}</span></p>
        <p>Рабочий номер телефона: <span class='phone'>%{Строка.РукРабТелефон}</span></p>
        <p>Внутренний номер телефона: <span class='internal - phone'>%{Строка.РукРабТелефон}</span></p></div>
        "
        Верстка = Верстка + "</p>"
    ;
    Верстка = Верстка + "</div>"
    Верстка = Верстка + "</div></div>"
    возврат Верстка
;