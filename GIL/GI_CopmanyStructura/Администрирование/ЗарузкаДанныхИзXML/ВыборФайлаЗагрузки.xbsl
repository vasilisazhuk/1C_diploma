импорт НСИ::ДоменОрганизационнаяСтруктура
импорт НСИ

метод ЗагрузитьПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    ЗагрузкаФайловСервер.ЧтениеXML(Путь)
;

метод УдалитьПодразделенияБезОрганизацийПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    УдалитьПодразделенияНаСервере()
;

@НаСервере @ДоступноСКлиента
статический метод УдалитьПодразделенияНаСервере()
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Подразделения.Ссылка КАК Ссылка
        ИЗ
            Сотрудники КАК Подразделения
    }
    для Подразделения из Запрос.Выполнить()
        Подразделения.Ссылка.ЗагрузитьОбъект().Удалить()
    ;
;

метод ЗагрузитьCSVПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    //ЗагрузкаФайлов
    ЗагрузкаФайловСервер.ЧтениеCSV(Путь)
;