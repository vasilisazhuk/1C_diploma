импорт НСИ::ДоменОрганизационнаяСтруктура
импорт НСИ
импорт ОбщиеМодули

@НаСервере
@ВПодсистеме
статический метод ПотокXML(Путь: Строка): ЧтениеXml?
    попытка
        знч Файл = новый Файл(Путь)
        знч Поток = новый ЧтениеXml(Файл.ОткрытьПотокЧтения())
        возврат Поток
    поймать Исключение: ИсключениеДоступаКФайлу
        возврат Неопределено
    ;
;

@НаСервере
@Локально
статический метод ПолучитьИдНСИПоТрнспортнойСсылке(ТранспортнаяСсылка: Строка): Строка?
    знч Запрос = Запрос{
        ВЫБРАТЬ
            СоответсвиеСсылок.ИдНСИ КАК ИдНСИ,
            СоответсвиеСсылок.ТранспортнаяСсылка КАК ТранспортнаяСсылка
        ИЗ
            СоответсвиеСсылок КАК СоответсвиеСсылок
        ГДЕ
            СоответсвиеСсылок.ТранспортнаяСсылка == %ТранспортнаяСсылка
    }

    возврат Запрос.Выполнить().Пусто() ? "00000000-0000-0000-0000-000000000000" : Запрос.Выполнить()
        .ПервыйИлиНеопределено().ИдНСИ
;

@НаСервере
@Локально
статический метод СопоставитьСсылки(Ссылки: СсылкиОбъекта)
    знч ТипОбъекта = Ссылки.ТипОбъекта
    знч МассивСсылки = Ссылки.Ссылки
    если МассивСсылки.Пусто()
        возврат
    ;
    выбор ТипОбъекта
    когда "Сотрудники"
        знч Объект = Ссылки.Объект.ЗагрузитьОбъект() как Сотрудники.Объект
        для Ссылка из МассивСсылки
            пер ИдНСИ = ПолучитьИдНСИПоТрнспортнойСсылке(Ссылка.ТранспортнаяСсылкаОбъектаСсылки)
            выбор Ссылка.Реквизит
            когда "v8:ФизическоеЛицо"
                Объект.ФизическоеЛицо = РаботаСФизЛицами.НайтиПоИдНСИ(ИдНСИ)
            когда "v8:ГоловнаяОрганизация"
                Объект.Организация = РаботаСОрганизациями.НайтиПоИдНСИ(ИдНСИ)
            ;
        ;
        Объект.Записать()

    когда "Подразделения"
        знч Объект = Ссылки.Объект.ЗагрузитьОбъект() как Подразделения.Объект
        для Ссылка из МассивСсылки
            пер ИдНСИ = ПолучитьИдНСИПоТрнспортнойСсылке(Ссылка.ТранспортнаяСсылкаОбъектаСсылки)
            выбор Ссылка.Реквизит
            когда "v8:ГоловнаяОрганизация"
                Объект.Организация = РаботаСОрганизациями.НайтиПоИдНСИ(ИдНСИ)
            когда "v8:Parent"
                Объект.ВышестоящееПодразделение = РаботаСПодразделениями.НайтиПоИдНСИ(ИдНСИ)
            ;
        ;
        Объект.Записать()
    когда "Организации"
        знч Объект = Ссылки.Объект.ЗагрузитьОбъект() как Организации.Объект
        для Ссылка из МассивСсылки
            пер ИдНСИ = ПолучитьИдНСИПоТрнспортнойСсылке(Ссылка.ТранспортнаяСсылкаОбъектаСсылки)
            выбор Ссылка.Реквизит
            когда "v8:ГоловнаяОрганизация"
                Объект.ГоловнаяОрганизация = РаботаСОрганизациями.НайтиПоИдНСИ(ИдНСИ)
            ;
        ;
        Объект.Записать()
    ;
;

@НаСервере
@ВПодсистеме
статический метод ПотокCSV(Путь: Строка): ЧтениеДанных?
    попытка
        знч Файл = новый Файл(Путь)
        знч Поток = новый ЧтениеДанных(Файл.ОткрытьПотокЧтения())
        возврат Поток
    поймать Исключение: ИсключениеДоступаКФайлу
        возврат Неопределено
    ;
;

@НаСервере @ДоступноСКлиента
@ВПодсистеме
статический метод ЧтениеCSV(Путь: Строка)
    знч Поток = ПотокCSV(Путь)
    //вместо GI_НСИ у справочника "Сотрудник" - таб. номер, поэтому в ИдНСИ пойдет номер
    // ИдСотрудник - ИдФизЛицо - Сотрудник - ИдРоли - Должность - ИдОрганизация - ИдПодразделение
    пер НомерСтолбца = 0
    знч КолвоСтолбцов = 6

    пер Сотрудник: Сотрудники.Объект?
    пер ФизЛицо: ФизическиеЛица.Объект?

    пока (НомерСтолбца <= КолвоСтолбцов) и (не Поток.ЧтениеЗавершено())
        знч Реквизит = Поток.ПрочитатьСтроку(РазделительСтрок = [";", ";\в\н", ";\н"])
        если Реквизит == ""
            возврат
        ;
        выбор НомерСтолбца
        когда 0
            пер СсылкаСотрудник = РаботаССотрудниками.НайтиПоИдНСИ(Реквизит)
            Сотрудник = СсылкаСотрудник == Неопределено ? новый Сотрудники.Объект() : СсылкаСотрудник.ЗагрузитьОбъект()
            Сотрудник.ИдНСИ = Реквизит
            //Сотрудник = новый Сотрудники.Объект()
            //ФизЛицо = новый ФизическиеЛица.Объект()
            //Сотрудник.Наименование = Реквизит
            //ФизЛицо.Наименование = Реквизит
            НомерСтолбца += 1
        когда 1
            пер СсылкаФизЛицо = РаботаСФизЛицами.НайтиПоИдНСИ(Реквизит)
            ФизЛицо = СсылкаФизЛицо == Неопределено ? новый ФизическиеЛица.Объект() : СсылкаФизЛицо.ЗагрузитьОбъект()
            ФизЛицо.ИдНСИ = Реквизит
            НомерСтолбца += 1
        когда 2
            Сотрудник.Наименование = Реквизит
            ФизЛицо.Наименование = Реквизит
            //Сотрудник.Должность = Реквизит
            НомерСтолбца += 1
        когда 3
            НомерСтолбца += 1
        когда 4
            Сотрудник.Должность = Реквизит
            НомерСтолбца += 1
        когда 5
            Сотрудник.Организация = РаботаСОрганизациями.НайтиПоИдНСИ(Реквизит)
            НомерСтолбца += 1
        когда 6
            Сотрудник.Подразделение = РаботаСПодразделениями.НайтиПоИдНСИ(Реквизит)
            ФизЛицо.Записать()
            Сотрудник.ФизическоеЛицо = ФизЛицо.Ссылка
            Сотрудник.Записать()
            НомерСтолбца = 0
        ;
    ;
;

@НаСервере @ДоступноСКлиента
@ВПодсистеме
статический метод ЧтениеXML(Путь: Строка)
    знч Поток = ПотокXML(Путь)
    знч МассивНеобработанных = новый Массив<СсылкиОбъекта>()
    пока Поток.Следующий()
        если Поток.ВидУзла == ВидУзлаXml.НачалоЭлемента
            выбор Поток.Имя
            когда "v8:CatalogObject.Организации"
                пер СсылкиОргЕдиницы = СериализацияСервер.ЗаписатьОргЕдиницу(Поток)
                если СсылкиОргЕдиницы != Неопределено
                    МассивНеобработанных.Добавить(СсылкиОргЕдиницы)
                ;
            когда "v8:CatalogObject.Сотрудники"
                пер СсылкиСотрудника = СериализацияСервер.ЗаписатьСотрудника(Поток)
                если СсылкиСотрудника != Неопределено
                    МассивНеобработанных.Добавить(СсылкиСотрудника)
                ;
            когда "v8:CatalogObject.ФизическиеЛица"
                пер СсылкиФизЛица = СериализацияСервер.ЗаписатьФизЛицо(Поток)
                если СсылкиФизЛица != Неопределено
                    МассивНеобработанных.Добавить(СсылкиФизЛица)
                ;
            когда "v8:CatalogObject.ПодразделенияОрганизаций"
                пер СсылкиПодразделения = СериализацияСервер.ЗаписатьПодразделениеОрганизации(Поток)
                если СсылкиПодразделения != Неопределено
                    МассивНеобработанных.Добавить(СсылкиПодразделения)
                ;

            иначе
            ;
        ;
    ;
    для Объект из МассивНеобработанных
        СопоставитьСсылки(Объект)
    ;
;