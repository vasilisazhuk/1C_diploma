импорт НСИ
импорт НСИ::ДоменОрганизационнаяСтруктура

@Локально
@НаСервере
статический метод ОбработатьСсылочныйРеквизит(Поток: ЧтениеXml, ТипОбъектаСсылки: Строка, Реквизит: Строка): НеобработаннаяСсылка?
    знч СсылочныйОбъект = Поток.ПрочитатьСодержимоеКакСтроку()
    если СсылочныйОбъект != "00000000-0000-0000-0000-000000000000"
        возврат новый НеобработаннаяСсылка(
                            ТранспортнаяСсылкаОбъектаСсылки = СсылочныйОбъект,
                            ТипОбъектаСсылки = ТипОбъектаСсылки, Реквизит = Реквизит)
    иначе
        возврат Неопределено
    ;
;

@ВПодсистеме
@НаСервере
статический метод ЗаписатьОргЕдиницу(Поток: ЧтениеXml): СсылкиОбъекта?
    знч МассивНеобработанныхСсылок = новый Массив<НеобработаннаяСсылка>()

    знч Организация = новый Организации.Объект()
    пер ТранспортнаяСсылка = ""
    пер ИдНСИ = ""
    пока Поток.Следующий()
        //реквизитный состав взят из выгрузки СЭД 3.0 и не имеет ссылок на головную организацию и руководителя
        если Поток.ВидУзла == ВидУзлаXml.НачалоЭлемента
            выбор Поток.Имя
            когда "v8:Ref"
                ТранспортнаяСсылка = Поток.ПрочитатьСодержимоеКакСтроку()
            когда "v8:GI_ИдентификаторНСИ"
                ИдНСИ = Поток.ПрочитатьСодержимоеКакСтроку()
                Организация.ИдНСИ = ИдНСИ
            когда "v8:Description"
                Организация.Наименование = Поток.ПрочитатьСодержимоеКакСтроку()
            когда "v8:DeletionMark"
                если Поток.ПрочитатьСодержимоеКакБулево()
                    возврат Неопределено
                ;
            когда "v8:ИНН"
                Организация.ИНН = Поток.ПрочитатьСодержимоеКакСтроку()
            когда "v8:КПП"
                Организация.КПП = Поток.ПрочитатьСодержимоеКакСтроку()
            когда "v8:ОГРН"
                Организация.ОГРН = Поток.ПрочитатьСодержимоеКакСтроку()
            когда "v8:НаименованиеПолное"
                Организация.ПолноеНаименование = Поток.ПрочитатьСодержимоеКакСтроку()
            когда "v8:ГоловнаяОрганизация"
        
                пер РезультатЗаписи = ОбработатьСсылочныйРеквизит(Поток,
                        "v8:CatalogObject.Организации", "v8:ГоловнаяОрганизация")
                если РезультатЗаписи != Неопределено 
                    МассивНеобработанныхСсылок.Добавить(РезультатЗаписи)
                ;
            иначе
            ;
        ;
        если Поток.ВидУзла == ВидУзлаXml.КонецЭлемента и Поток.Имя == "v8:CatalogObject.Организации"
            //в списске есть дубли
            //знч ОрганизацияВБазе = РаботаСОрганизациями.НайтиПоИдНСИ(ИдНСИ)
            //если ОрганизацияВБазе != Неопределено
                //знч ОрганизацияИБ = ОрганизацияВБазе.ЗагрузитьОбъект()
                //ОрганизацияИБ.ИНН = Организация.ИНН
                //ОрганизацияИБ.КПП = Организация.КПП
                //ОрганизацияИБ.ОГРН = Организация.ОГРН
                //ОрганизацияИБ.ПолноеНаименование = Организация.ПолноеНаименование
            //иначе 
            попытка
                ИдНСИ = Организация.ИдНСИ
                //если РаботаСОрганизациями.НайтиПоИдНСИ(ИдНСИ) == Неопределено
                Организация.Записать()
                знч АвторИзменения = Пользователи.ТекущийПользователь
                знч КлючЗаписи =
                    новый СоответсвиеСсылок.КлючЗаписи(ИдНСИ = ИдНСИ, ТранспортнаяСсылка = ТранспортнаяСсылка)
                пер ЗаписьСоответствия = КлючЗаписи.ЗагрузитьЗапись()
                если ЗаписьСоответствия != Неопределено
                    СоответсвиеСсылок.Удалить(КлючЗаписи)
                //обработать историю изменения
                ;
                знч Запись = новый СоответсвиеСсылок.Запись(КлючЗаписи)
                Запись.МоментИзменения = Момент.Сейчас()
                Запись.АвторИзменения = АвторИзменения
                Запись.СсылкаЭлемент = Организация.Ссылка
                СоответсвиеСсылок.Записать(Запись)
                если МассивНеобработанныхСсылок.Пусто()
                    возврат Неопределено
                ;
              знч Результат = новый СсылкиОбъекта(Объект = Организация.Ссылка, Ссылки = МассивНеобработанныхСсылок, ТипОбъекта = "Организации")
                возврат Результат
            поймать И: Исключение
                возврат Неопределено
            ;
        ;
        
    ;
    возврат Неопределено
;

@НаСервере
@ВПодсистеме
метод ЗаписатьСотрудника(Поток: ЧтениеXml): СсылкиОбъекта?
    знч Сотрудник = новый Сотрудники.Объект()
    знч МассивНеобработанныхСсылок = новый Массив<НеобработаннаяСсылка>()
    пер ТранспортнаяСсылка = ""
    пер ИдНСИ = ""
    пер РезультатЗаписи: НеобработаннаяСсылка? = новый НеобработаннаяСсылка()
    пока Поток.Следующий()
        если Поток.ВидУзла == ВидУзлаXml.НачалоЭлемента
            выбор Поток.Имя
            когда "v8:Ref"
                ТранспортнаяСсылка = Поток.ПрочитатьСодержимоеКакСтроку()
            когда "v8:DeletionMark"
                если Поток.ПрочитатьСодержимоеКакБулево()
                    возврат Неопределено
                ;
            когда "v8:Description"
                Сотрудник.Наименование = Поток.ПрочитатьСодержимоеКакСтроку()
            когда "v8:ФизическоеЛицо"
                РезультатЗаписи = ОбработатьСсылочныйРеквизит(Поток,
                        "v8:CatalogRef.ФизическиеЛица", "v8:ФизическоеЛицо")
                если РезультатЗаписи != Неопределено
                    МассивНеобработанныхСсылок.Добавить(РезультатЗаписи)
                ;

            когда "v8:ГоловнаяОрганизация"
                РезультатЗаписи = ОбработатьСсылочныйРеквизит(Поток,
                        "v8:CatalogRef.Организации", "v8:ГоловнаяОрганизация")
                если РезультатЗаписи != Неопределено
                    МассивНеобработанныхСсылок.Добавить(РезультатЗаписи)
                ;

            когда "v8:ДолжностьПоШтРасп"
                РезультатЗаписи = ОбработатьСсылочныйРеквизит(Поток,
                        "v8:CatalogRef.ШтатноеРасписание", "v8:ДолжностьПоШтРасп")
                если РезультатЗаписи != Неопределено
                    МассивНеобработанныхСсылок.Добавить(РезультатЗаписи)
                ;

            когда "v8:Должность"
                РезультатЗаписи = ОбработатьСсылочныйРеквизит(Поток,
                        "v8:CatalogRef.Должности", "v8:Должность")
                если РезультатЗаписи != Неопределено
                    МассивНеобработанныхСсылок.Добавить(РезультатЗаписи)
                ;
            когда "v8:GI_ИдентификаторНСИ"
                ИдНСИ = Поток.ПрочитатьСодержимоеКакСтроку()
                Сотрудник.ИдНСИ = ИдНСИ
            ;
        иначе
        ;
        если Поток.ВидУзла == ВидУзлаXml.КонецЭлемента и Поток.Имя == "v8:CatalogObject.Сотрудники"
            попытка
                
                Сотрудник.Записать()
                знч АвторИзменения = Пользователи.ТекущийПользователь
                знч КлючЗаписи =
                    новый СоответсвиеСсылок.КлючЗаписи(ИдНСИ = ИдНСИ, ТранспортнаяСсылка = ТранспортнаяСсылка)
                пер ЗаписьСоответствия = КлючЗаписи.ЗагрузитьЗапись()
                если ЗаписьСоответствия != Неопределено
                    СоответсвиеСсылок.Удалить(КлючЗаписи)
                //обработать историю изменения
                ;
                знч Запись = новый СоответсвиеСсылок.Запись(КлючЗаписи)
                Запись.МоментИзменения = Момент.Сейчас()
                Запись.АвторИзменения = АвторИзменения
                Запись.СсылкаЭлемент = Сотрудник.Ссылка
                СоответсвиеСсылок.Записать(Запись)
                //    ;
                если МассивНеобработанныхСсылок.Пусто()
                    возврат Неопределено
                ;
                
                знч Результат = новый СсылкиОбъекта(Объект = Сотрудник.Ссылка, Ссылки = МассивНеобработанныхСсылок, ТипОбъекта = "Сотрудники")
                возврат Результат
            
            поймать И: Исключение
                возврат Неопределено
            ;
        ;
    ;
    возврат Неопределено
;

@НаСервере
@ВПодсистеме
статический метод ЗаписатьФизЛицо(Поток: ЧтениеXml): СсылкиОбъекта?
    знч ФизЛицо = новый ФизическиеЛица.Объект()
    знч МассивНеобработанныхСсылок = новый Массив<НеобработаннаяСсылка>()
    пер ТранспортнаяСсылка = ""
    пер ИдНСИ = ""
    пока Поток.Следующий()
        если Поток.ВидУзла == ВидУзлаXml.НачалоЭлемента
            выбор Поток.Имя
            когда "v8:Ref"
                ТранспортнаяСсылка = Поток.ПрочитатьСодержимоеКакСтроку()
            когда "v8:DeletionMark"
                если Поток.ПрочитатьСодержимоеКакБулево()
                    возврат Неопределено
                ;
            когда "v8:Description"
                ФизЛицо.Наименование = Поток.ПрочитатьСодержимоеКакСтроку()
            когда "v8:GI_ИдентификаторНСИ"
                ИдНСИ = Поток.ПрочитатьСодержимоеКакСтроку()
                ФизЛицо.ИдНСИ = ИдНСИ
            ;
        иначе
        ;
        если Поток.ВидУзла == ВидУзлаXml.КонецЭлемента и Поток.Имя == "v8:CatalogObject.ФизическиеЛица"
            попытка
                //знч ИдНСИ = ФизЛицо.ИдНСИ
                //если РаботаССотрудниками.НайтиПоИдНСИ(ИдНСИ) == Неопределено  
                ФизЛицо.Записать()
                знч АвторИзменения = Пользователи.ТекущийПользователь
                знч КлючЗаписи =
                    новый СоответсвиеСсылок.КлючЗаписи(ИдНСИ = ИдНСИ, ТранспортнаяСсылка = ТранспортнаяСсылка)
                пер ЗаписьСоответствия = КлючЗаписи.ЗагрузитьЗапись()
                если ЗаписьСоответствия != Неопределено
                    СоответсвиеСсылок.Удалить(КлючЗаписи)
                //обработать историю изменения
                ;
                знч Запись = новый СоответсвиеСсылок.Запись(КлючЗаписи)
                Запись.МоментИзменения = Момент.Сейчас()
                Запись.АвторИзменения = АвторИзменения
                Запись.СсылкаЭлемент = ФизЛицо.Ссылка
                СоответсвиеСсылок.Записать(Запись)
                //    ;
                если МассивНеобработанныхСсылок.Пусто()
                    возврат Неопределено
                ;
                
                знч Результат = новый СсылкиОбъекта(Объект = ФизЛицо.Ссылка, Ссылки = МассивНеобработанныхСсылок, ТипОбъекта = "ФизическиеЛица")
                возврат Результат
            поймать И: Исключение
                возврат Неопределено
            ;
        ;
    ;
    возврат Неопределено
;

@НаСервере
@ВПодсистеме
статический метод ЗаписатьПодразделениеОрганизации(Поток: ЧтениеXml): СсылкиОбъекта?
    знч Подразделение = новый Подразделения.Объект()
    знч МассивНеобработанныхСсылок = новый Массив<НеобработаннаяСсылка>()
    пер ТранспортнаяСсылка = ""
    пер ИдНСИ = ""
    пер РезультатЗаписи: НеобработаннаяСсылка? = новый НеобработаннаяСсылка()
    пока Поток.Следующий()
        если Поток.ВидУзла == ВидУзлаXml.НачалоЭлемента
            выбор Поток.Имя
            когда "v8:Ref"
                ТранспортнаяСсылка = Поток.ПрочитатьСодержимоеКакСтроку()
            когда "v8:DeletionMark"
                если Поток.ПрочитатьСодержимоеКакБулево()
                    возврат Неопределено
                ;
            когда "v8:Parent"
                РезультатЗаписи = ОбработатьСсылочныйРеквизит(Поток, "v8:CatalogRef.ПодразделенияОрганизаций", "v8:Parent")
                 если РезультатЗаписи != Неопределено
                    МассивНеобработанныхСсылок.Добавить(РезультатЗаписи)
                ;
            когда "v8:Description"
                Подразделение.Наименование = Поток.ПрочитатьСодержимоеКакСтроку()
            когда "v8:ГоловнаяОрганизация"
                РезультатЗаписи = ОбработатьСсылочныйРеквизит(Поток, "v8:CatalogRef.Организации", "v8:ГоловнаяОрганизация")
                 если РезультатЗаписи != Неопределено
                    МассивНеобработанныхСсылок.Добавить(РезультатЗаписи)
                ;
            когда "v8:GI_ИдентификаторНСИ"
                ИдНСИ = Поток.ПрочитатьСодержимоеКакСтроку()
                Подразделение.ИдНСИ = ИдНСИ
            иначе
            ;
        ;
        если Поток.ВидУзла == ВидУзлаXml.КонецЭлемента и Поток.Имя == "v8:CatalogObject.ПодразделенияОрганизаций"
            попытка
                
                //если РаботаССотрудниками.НайтиПоИдНСИ(ИдНСИ) == Неопределено  
                Подразделение.Записать()
                знч АвторИзменения = Пользователи.ТекущийПользователь
                знч КлючЗаписи =
                    новый СоответсвиеСсылок.КлючЗаписи(ИдНСИ = ИдНСИ, ТранспортнаяСсылка = ТранспортнаяСсылка)
                пер ЗаписьСоответствия = КлючЗаписи.ЗагрузитьЗапись()
                если ЗаписьСоответствия != Неопределено
                    СоответсвиеСсылок.Удалить(КлючЗаписи)
                //обработать историю изменения
                ;
                знч Запись = новый СоответсвиеСсылок.Запись(КлючЗаписи)
                Запись.МоментИзменения = Момент.Сейчас()
                Запись.АвторИзменения = АвторИзменения
                Запись.СсылкаЭлемент = Подразделение.Ссылка
                //    ;
                если МассивНеобработанныхСсылок.Пусто()
                    возврат Неопределено
                    ;
                //МассивНеобработанныхСсылок.ДляКаждого(Элемент -> Элемент.СсылкаОбъектНазначения = Подразделение.Ссылка)
                //МассивНеобработанныхСсылок.ДляКаждого(Элемент -> Элемент.ИдНСИОбъектНазначения = Подразделение.ИдНСИ)
                знч Результат = новый СсылкиОбъекта(Объект = Подразделение.Ссылка, Ссылки = МассивНеобработанныхСсылок, ТипОбъекта = "Подразделения")
                возврат Результат
            поймать И: Исключение
                возврат Неопределено
            ;
        ;
    ;

    возврат Неопределено
;