@НаСервере
@ВПроекте
метод МойМетод()
    знч Событие = новый СобытиеЖурналаСобытийТест()
    исп Событие.ЗаписатьНачало()
    пер Сотрудник = новый Сотрудники.Объект(Наименование = "Этот сотрудник создан заданием")
    Сотрудник.Записать()
;