@ВПодсистеме
метод ЗагрузкаТаблицыФизическиеЛица()
    //исп Контекст = новый ОперацияИмпортДанных(Задание = "Загрузка физ. лиц").ЗаписатьНачало()
    пер Соединение = новый СоединениеSql(
        "jdbc:postgresql://10.130.46.13:5432/org_structure_db?user=e1c_agent&password=l_Djd4ypJ_&tcpKeepAlive=true")
    попытка
        пер Запрос = Соединение.СоздатьЗапросСВыборкой("select * from persons_etl;")
        исп Результат = Запрос.Выполнить()
        знч ПараметрыУдаления = новый УдалениеОбъектов()
        знч МассивУдаляемых = новый Массив<ФизическиеЛица.Ссылка>()
        пока Результат.Следующий()
            пер ОбновлениеСуществующейЗаписи = Ложь
            пер ИдНСИ = Результат.Получить("gi_person_uid") как Строка|Null
            пер РабТелефон = Результат.Получить("person_eternal_phone") как Строка|Null
            пер ВнутрТелефон = Результат.Получить("person_mobile_phone") как Строка|Null
            пер EMail = Результат.Получить("person_email") как Строка|Null
            пер ФИО_ЕКС = Результат.Получить("person_name") как Строка|Null
            пер ПометкаУдаления = (Результат.Получить("person_deletion_mark") как Число) == 1
            пер Аккаунт: Аккаунты.Объект?
            пер ДатаВыгрузки = Результат.Получить("person_update_time") как Строка
            пер ДоменноеИмя = Результат.Получить("person_domain_name") как Строка|Null

            знч СсылкаВХранилище = ИдНСИ == Null ? Неопределено : РаботаСФизЛицами.НайтиПоИдНСИ(ИдНСИ как Строка)
            если ПометкаУдаления
                //если объект в базе и нужно удалить -> помещаем на удаление
                если СсылкаВХранилище != Неопределено
                    МассивУдаляемых.Добавить(СсылкаВХранилище)
                ;
            ;
            исп Транзакции.Начать()
            пер ФизическоеЛицо: ФизическиеЛица.Объект?

            если СсылкаВХранилище != Неопределено
                ФизическоеЛицо = СсылкаВХранилище.ЗагрузитьОбъект(Истина)
                ОбновлениеСуществующейЗаписи = Истина
            иначе
                ФизическоеЛицо = новый ФизическиеЛица.Объект()
            ;
            ФизическоеЛицо.Наименование = ФИО_ЕКС == Null ? "не заполнено" : ФИО_ЕКС как Строка
            ФизическоеЛицо.ФИО_Полное = ФИО_ЕКС == Null ? "не заполнено" : ФИО_ЕКС как Строка
            ФизическоеЛицо.ИдНСИ = ИдНСИ == Null ? "!!!" : ИдНСИ как Строка

            пер СсылкаНаАккаунт: Аккаунты.Ссылка?
            если ДоменноеИмя != Null
                пер АккаунтСсылка = РаботаСАккаунтами.НайтиПоДоменномуИмени(ДоменноеИмя как Строка)
                если АккаунтСсылка != Неопределено
                    Аккаунт = АккаунтСсылка.ЗагрузитьОбъект(Истина)
                иначе
                    Аккаунт = новый Аккаунты.Объект()
                ;
                если ДоменноеИмя != ""
                    Аккаунт.Наименование = ДоменноеИмя как Строка
                    Аккаунт.Email = EMail == Null ? "не заполнено" : EMail как Строка
                    Аккаунт.РабТелефон = РабТелефон == Null ? "не заполнено" : РабТелефон как Строка
                    Аккаунт.ВнутрТелефон = ВнутрТелефон == Null ? "не заполнено" : ВнутрТелефон как Строка
                    Аккаунт.МоментАктуализации = Момент.Сейчас().ВДатаВремя(ЧасовойПояс.Текущий())
                    Аккаунт.Записать()
                    СсылкаНаАккаунт = Аккаунт.Ссылка
                иначе
                    //Аккаунт = Неопределено
                    
                    СсылкаНаАккаунт = Неопределено
                ;
            иначе
                СсылкаНаАккаунт = Неопределено
            ;
            ФизическоеЛицо.ИдНСИ = ИдНСИ == Null ? "Не заполнено" : ИдНСИ как Строка
            ФизическоеЛицо.Аккаунт = СсылкаНаАккаунт
            ФизическоеЛицо.МмоментАктуализации = Момент.Сейчас().ВДатаВремя(ЧасовойПояс.Текущий())
            ФизическоеЛицо.Записать()
        ;
        ПараметрыУдаления.Выполнить()
        Соединение.Закрыть()
        возврат
    поймать Исключение: ИсключениеSql
    ;
;

@ВПодсистеме
статический метод ЗагрузкаТаблицыСотрудники()
    пер Соединение = новый СоединениеSql(
        "jdbc:postgresql://10.130.46.13:5432/org_structure_db?user=e1c_agent&password=l_Djd4ypJ_&tcpKeepAlive=true")
    пер МассивСотрудников = новый Массив<Строка>()
    попытка
        пер Запрос = Соединение.СоздатьЗапросСВыборкой(
            "select *  from employes_etl;")
        исп Результат = Запрос.Выполнить()
        знч ПараметрыУдаления = новый УдалениеОбъектов()
        знч МассивУдаляемых = новый Массив<Сотрудники.Ссылка>()
        пока Результат.Следующий()
            пер ИдНСИ = Результат.Получить("gi_employee_uid") как Строка|Null
            пер ИдШтатного = Результат.Получить("gi_shtat_uid") как Строка|Null
            пер СсылкаНаФизЛицо = Результат.Получить("gi_person_uid") как Строка|Null
            пер Должность = Результат.Получить("employee_position") как Строка|Null
            пер ФИО = Результат.Получить("employee_name") как Строка|Null

            пер ИдОрганизации = Результат.Получить("employee_organization") как Строка|Null
            пер НаименованиеОрганизации = Результат.Получить("employee_organization_name") как Строка|Null

            пер ИдОтдела = Результат.Получить("employee_department") как Строка|Null
            пер НазваниеОтдела = Результат.Получить("employee_department_name") как Строка|Null

            пер СсылкаНаЛинРук = Результат.Получить("employee_lin_head") как Строка|Null
            пер ЛинРук = Результат.Получить("employee_lin_head_name") как Строка|Null

            пер СсылкаНаФунРук = Результат.Получить("employee_fun_head") как Строка|Null
            пер ФунРук = Результат.Получить("employee_fun_head_name") как Строка|Null


            пер ПометкаУдаления = (Результат.Получить("employee_deletion_mark") как Число) == 1

            пер СотрудникОбъект: Сотрудники.Объект
            пер СсылкаВХранилище: Сотрудники.Ссылка?
            если ИдНСИ != Null
                СсылкаВХранилище = РаботаССотрудниками.НайтиПоИдНСИ(ИдНСИ как Строка)
            иначе
                СсылкаВХранилище = Неопределено
            ;
            если ПометкаУдаления
                //если объект в базе и нужно удалить -> помещаем на удаление
                если СсылкаВХранилище != Неопределено
                    МассивУдаляемых.Добавить(СсылкаВХранилище)
                ;
            ;

            если СсылкаВХранилище == Неопределено
                СотрудникОбъект = новый Сотрудники.Объект()
            иначе
                СотрудникОбъект = СсылкаВХранилище.ЗагрузитьОбъект(Истина)
            ;
            СотрудникОбъект.Наименование = ФИО == Null ? "НЕ ЗАПОЛНЕНО" : ФИО как Строка
            СотрудникОбъект.ИдНСИ = ИдНСИ == Null ? "НЕ ЗАПОЛНЕНО" : ИдНСИ как Строка
            СотрудникОбъект.Должность = Должность == Null ? "НЕ ЗАПОЛНЕНО" : Должность как Строка
            СотрудникОбъект.ИдШтатногоРасписания = ИдШтатного == Null ? "НЕ ЗАПОЛНЕНО" : ИдШтатного как Строка
            СотрудникОбъект.Подразделение = ИдОтдела == Null ? Неопределено
                : НайтиПодразделение(ИдОтдела как Строка, НазваниеОтдела)
            СотрудникОбъект.Организация = ИдОрганизации == Null ? Неопределено
                : НайтиОрганизацию(ИдОрганизации как Строка, НаименованиеОрганизации)
            СотрудникОбъект.ЛинРук = СсылкаНаЛинРук == Null ? Неопределено
                : НайтиРуководителяСотрудника(СсылкаНаЛинРук как Строка, ЛинРук)
            СотрудникОбъект.ФунРук = СсылкаНаФунРук == Null ? Неопределено
                : НайтиРуководителяСотрудника(СсылкаНаФунРук как Строка, ФунРук)
            СотрудникОбъект.ФизическоеЛицо = СсылкаНаФизЛицо == Null ? Неопределено
                : НайтиФизЛицо(СсылкаНаФизЛицо как Строка, ФИО)
            //если ПометкаУдаления
            //    если СсылкаВХранилище != Неопределено
            //        МассивУдаляемых.Добавить(СсылкаВХранилище)
            //    ;
            //;
            СотрудникОбъект.МоментАктуализации = Момент.Сейчас().ВДатаВремя(ЧасовойПояс.Текущий())
            СотрудникОбъект.Записать()
        ;
        ПараметрыУдаления.Выполнить()
        Соединение.Закрыть()
        возврат
    поймать Исключение: ИсключениеSql
    ;
;

@ВПодсистеме
статический метод ЗагрузкаТаблицыПодразделения()
    пер Соединение = новый СоединениеSql(
        "jdbc:postgresql://10.130.46.13:5432/org_structure_db?user=e1c_agent&password=l_Djd4ypJ_&tcpKeepAlive=true")
    попытка
        пер Запрос = Соединение.СоздатьЗапросСВыборкой(
            "select *  from departments_etl;")
        исп Результат = Запрос.Выполнить()
        знч ПараметрыУдаления = новый УдалениеОбъектов()
        знч МассивУдаляемых = новый Массив<Подразделения.Ссылка>()
        пока Результат.Следующий()
            пер ИдНСИ = Результат.Получить("gi_department_uid") как Строка|Null
            пер Название = Результат.Получить("department_name") как Строка|Null

            пер ВышестоящееПодразделение = Результат.Получить("department_parent") как Строка|Null
            пер ВышестоящееПодразделениеНазвание = Результат.Получить("department_parent_name") как Строка|Null

            пер ИдОрганизация = Результат.Получить("department_organization") как Строка|Null
            пер НазваниеОрганизации = Результат.Получить("department_organization_name") как Строка|Null

            пер ИдРук = Результат.Получить("department_head") как Строка|Null
            пер ИмяРуководителя = Результат.Получить("department_head_name") как Строка|Null
            пер ПометкаУдаления = (Результат.Получить("department_deletion_mark") как Число) == 1

            исп Транзакции.Начать()
            пер ПодразделениеОбъект: Подразделения.Объект
            пер СсылкаВХранилище = ИдНСИ == Null ? Неопределено : РаботаСПодразделениями.НайтиПоИдНСИ(ИдНСИ как Строка)
            если ПометкаУдаления
                //если объект в базе и нужно удалить -> помещаем на удаление
                если СсылкаВХранилище != Неопределено
                    МассивУдаляемых.Добавить(СсылкаВХранилище)
                ;
            ;
            пер НеОбновлять = Ложь
            если СсылкаВХранилище != Неопределено
                ПодразделениеОбъект = СсылкаВХранилище.ЗагрузитьОбъект(Истина)
                НеОбновлять = ПодразделениеОбъект.НеОбновлять
            иначе
                ПодразделениеОбъект = новый Подразделения.Объект()
                ПодразделениеОбъект.НеобходимоПроверить = Истина
            ;
            если не НеОбновлять
                ПодразделениеОбъект.Наименование = Название == Null ? "НЕ ЗАПОЛНЕНО" : Название как Строка
                ПодразделениеОбъект.Организация = ИдОрганизация == Null ? Неопределено
                    : НайтиОрганизацию(ИдОрганизация как Строка, НазваниеОрганизации)
                ПодразделениеОбъект.ВышестоящееПодразделение = ВышестоящееПодразделение == Null ? Неопределено
                    : НайтиПодразделение(ВышестоящееПодразделение как Строка, ВышестоящееПодразделениеНазвание)
                ПодразделениеОбъект.Руководитель = ИдРук == Null ? Неопределено
                    : НайтиСотрудника(ИдРук как Строка, ИмяРуководителя)
                ПодразделениеОбъект.МоментАктуализации = Момент.Сейчас().ВДатаВремя(ЧасовойПояс.Текущий())

                ПодразделениеОбъект.Записать()
            ;
        ;
        ПараметрыУдаления.Выполнить()
        Соединение.Закрыть()
        возврат
    поймать Исключение: неизвестно
    ;
;

@ВПодсистеме
статический метод ЗагрузкаТаблицыОрганизации()
    пер Соединение = новый СоединениеSql(
        "jdbc:postgresql://10.130.46.13:5432/org_structure_db?user=e1c_agent&password=l_Djd4ypJ_&tcpKeepAlive=true")
    попытка
        пер Запрос = Соединение.СоздатьЗапросСВыборкой(
            "select *  from organization_etl;")
        исп Результат = Запрос.Выполнить()
        знч ПараметрыУдаления = новый УдалениеОбъектов()
        знч МассивУдаляемых = новый Массив<Организации.Ссылка>()
        пока Результат.Следующий()
            пер ИдНСИ = Результат.Получить("gi_organization_uid") как Строка|Null
            пер Наименование = Результат.Получить("organization_name") как Строка|Null
            пер ИдАСФЭБ = Результат.Получить("gi_organization_econ_uid") как Строка|Null
            пер ИНН = Результат.Получить("organization_inn") как Строка|Null
            пер КПП = Результат.Получить("organization_kpp") как Строка|Null
            пер ПометкаУдаления = (Результат.Получить("organization_deletion_mark") как Число) == 1
            пер Страна = Результат.Получить("organization_country") как Строка|Null

            пер ВышестоящаяОрганизация = Результат.Получить("organization_parent") как Строка|Null
            пер ВышестоящееОрганизацияНазвание = Результат.Получить("organization_parent_name") как Строка|Null

            пер Руководитель = Результат.Получить("organization_head") как Строка|Null
            пер РуководительНаименование = Результат.Получить("organization_head_name") как Строка|Null

            исп Транзакции.Начать()
            пер СсылкаВХранилище = ИдНСИ == Null ? Неопределено : РаботаСОрганизациями.НайтиПоИдНСИ(ИдНСИ как Строка)
            пер ОрганизацияОбъект: Организации.Объект
            
            если ПометкаУдаления
                //если объект в базе и нужно удалить -> помещаем на удаление
                если СсылкаВХранилище != Неопределено
                    МассивУдаляемых.Добавить(СсылкаВХранилище)
                ;
            ;
            пер НеОбновлять = Ложь
            если СсылкаВХранилище != Неопределено
                ОрганизацияОбъект = СсылкаВХранилище.ЗагрузитьОбъект(Истина)
                НеОбновлять = ОрганизацияОбъект.НеОбновлять
            иначе
                ОрганизацияОбъект = новый Организации.Объект()
            ;
            если не НеОбновлять
                ОрганизацияОбъект.ИдНСИ = ИдНСИ == Null ? "" : ИдНСИ как Строка
                ОрганизацияОбъект.Страна = Страна == Null ? "" : Страна как Строка
                ОрганизацияОбъект.ИНН = ИНН == Null ? "" : ИНН как Строка
                ОрганизацияОбъект.КПП = КПП == Null ? "" : КПП как Строка
                ОрганизацияОбъект.ИдАСФЭБ = ИдАСФЭБ == Null ? "" : ИдАСФЭБ как Строка
                ОрганизацияОбъект.Наименование = Наименование == Null ? "" : Наименование как Строка
                ОрганизацияОбъект.ГоловнаяОрганизация = ВышестоящаяОрганизация == Null ? Неопределено
                    : НайтиОрганизацию(ВышестоящаяОрганизация как Строка, ВышестоящееОрганизацияНазвание)
                ОрганизацияОбъект.РуководительОрганизации = Руководитель == Null ? Неопределено
                    : НайтиСотрудника(Руководитель как Строка, РуководительНаименование)
                ОрганизацияОбъект.Записать()
            ;
            
        ;
        Соединение.Закрыть()
        ПараметрыУдаления.Выполнить()
    поймать Исключение: неизвестно
    ;
;

//Служебные функции для создания ссылки во внутренней базе при первом упоминании

@Локально
статический метод НайтиФизЛицо(GI_Employee: Строка, Наименование: Строка|Null = "Не заполнено"): ФизическиеЛица.Ссылка?
    пер Сотрудник = РаботаСФизЛицами.НайтиПоИдНСИ(GI_Employee)
    если Сотрудник != Неопределено
        возврат Сотрудник
    ;
    пер НаименованиеВал: Строка
    если Наименование == Null
        НаименованиеВал = "Не заполнено"
    иначе
        НаименованиеВал = Наименование как Строка
    ;
    знч НовыйСотрудник =
        новый ФизическиеЛица.Объект(Наименование = НаименованиеВал, ИдНСИ = GI_Employee, МмоментАктуализации = Момент
            .Сейчас().ВДатаВремя(ЧасовойПояс.Текущий()))
    НовыйСотрудник.Записать()
    возврат НовыйСотрудник.Ссылка
;

@Локально
статический метод НайтиСотрудника(GI_Employee: Строка, Наименование: Строка|Null = "Не заполнено"): Сотрудники.Ссылка?
    пер Сотрудник = РаботаССотрудниками.НайтиПоИдНСИ(GI_Employee)
    если Сотрудник != Неопределено
        возврат Сотрудник
    ;
    пер НаименованиеВал: Строка
    если Наименование == Null
        НаименованиеВал = "Не заполнено"
    иначе
        НаименованиеВал = Наименование как Строка
    ;
    знч НовыйСотрудник =
        новый Сотрудники.Объект(Наименование = НаименованиеВал, ИдНСИ = GI_Employee, МоментАктуализации = Момент
            .Сейчас().ВДатаВремя(ЧасовойПояс.Текущий()))
    НовыйСотрудник.Записать()
    возврат НовыйСотрудник.Ссылка
;

//НайтиПоИдШтатного
@Локально
статический метод НайтиРуководителяСотрудника(GI_Employee: Строка, Наименование: Строка|Null =
            "Не заполнено"): Сотрудники.Ссылка?
    пер Сотрудник = РаботаССотрудниками.НайтиПоИдШтатного(GI_Employee)
    если Сотрудник != Неопределено
        возврат Сотрудник
    ;
    пер НаименованиеВал: Строка
    если Наименование == Null
        НаименованиеВал = "Не заполнено"
    иначе
        НаименованиеВал = Наименование как Строка
    ;
    знч НовыйСотрудник =
        новый Сотрудники.Объект(Наименование = НаименованиеВал, ИдШтатногоРасписания = GI_Employee,
        МоментАктуализации = Момент.Сейчас().ВДатаВремя(ЧасовойПояс.Текущий()))
    НовыйСотрудник.Записать()
    возврат НовыйСотрудник.Ссылка
;

@Локально
статический метод НайтиОрганизацию(GI_Organization: Строка, Наименование: Строка|Null =
            "Не заполнено"): Организации.Ссылка?
    пер Организация = РаботаСОрганизациями.НайтиПоИдНСИ(GI_Organization)
    если Организация != Неопределено
        возврат Организация
    ;
    пер НаименованиеВал: Строка
    если Наименование == Null
        НаименованиеВал = "Не заполнено"
    иначе
        НаименованиеВал = Наименование как Строка
    ;
    знч НоваяОрганизация =
        новый Организации.Объект(Наименование = НаименованиеВал, ИдНСИ = GI_Organization, МоментАктуализации = Момент
            .Сейчас().ВДатаВремя(ЧасовойПояс.Текущий()))
    НоваяОрганизация.Записать()
    возврат НоваяОрганизация.Ссылка
;

@Локально
статический метод НайтиПодразделение(GI_Department: Строка, Наименование: Строка|Null =
            "Не заполнено"): Подразделения.Ссылка?
    пер Подразделение = РаботаСПодразделениями.НайтиПоИдНСИ(GI_Department)
    если Подразделение != Неопределено
        возврат Подразделение
    ;
    пер НаименованиеВал: Строка
    если Наименование == Null
        НаименованиеВал = "Не заполнено"
    иначе
        НаименованиеВал = Наименование как Строка
    ;
    знч НовыйОтдел =
        новый Подразделения.Объект(Наименование = НаименованиеВал, ИдНСИ = GI_Department, МоментАктуализации = Момент
            .Сейчас().ВДатаВремя(ЧасовойПояс.Текущий()))
    НовыйОтдел.Записать()
    возврат НовыйОтдел.Ссылка
;