@ВПодсистеме
@НаСервере @ДоступноСКлиента
статический метод ЗапланироватьОбновлениеОргСтруктуры()
    знч ИмпортФизЛиц = новый ОперацияИмпортДанных(Задание = "Импорт таблицы persons_etl")
    попытка
        исп ИмпортФизЛиц.ЗаписатьНачало()
        ЗагрузитьФизЛица()
    поймать Исключение: ИсключениеSql
        новый ОшибкаИмпорта(ОписаниеОбъекта = "%{Исключение.Описание}",
        Важность = ВажностьСобытияЖурналаСобытий.Высокая, ХарактерОшибки = ХарактерОшибки.ДляПоддержки).Записать()
    //выбросить Исключение
    ;
    
    знч ИмпортПодразделения = новый ОперацияИмпортДанных(Задание = "Импорт таблицы departments_etl")
    попытка
        исп ИмпортПодразделения.ЗаписатьНачало()
        ЗагрузитьПодразделения()
    поймать Исключение: ИсключениеSql
        новый ОшибкаИмпорта(ОписаниеОбъекта = "%{Исключение.Описание}",
        Важность = ВажностьСобытияЖурналаСобытий.Высокая, ХарактерОшибки = ХарактерОшибки.ДляПоддержки).Записать()
    ;
    
    знч ИмпортОрганизации = новый ОперацияИмпортДанных(Задание = "Импорт таблицы organizations_etl")
    попытка
        исп ИмпортОрганизации.ЗаписатьНачало()
        ЗагрузитьОрганизации()
    поймать Исключение: ИсключениеSql
        новый ОшибкаИмпорта(ОписаниеОбъекта = "%{Исключение.Описание}",
        Важность = ВажностьСобытияЖурналаСобытий.Высокая, ХарактерОшибки = ХарактерОшибки.ДляПоддержки).Записать()
    ;
    
    знч ИмпортСотрудников = новый ОперацияИмпортДанных(Задание = "Импорт таблицы employees_etl")
    попытка 
        исп ИмпортСотрудников.ЗаписатьНачало()
        ЗагрузитьСотрудники()
    поймать Исключение: ИсключениеSql
        новый ОшибкаИмпорта(ОписаниеОбъекта = "%{Исключение.Описание}",
        Важность = ВажностьСобытияЖурналаСобытий.Высокая, ХарактерОшибки = ХарактерОшибки.ДляПоддержки).Записать()     
    ;
    
;