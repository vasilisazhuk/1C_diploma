импорт ОбщиеМодули::Верстка::Геттеры
импорт НСИ::ДоменОрганизационнаяСтруктура

метод GET(Запрос: HttpСервисЗапрос)
    знч Ссылка = Запрос.Параметры.ПолучитьПервый("id")
    Запрос.Ответ.Заголовки.Установить("Content-Type", "text/html; charset=utf-8")
    Запрос.Ответ.УстановитьТело(Организации.ПолучитьКарточкуОргЕдиницыСтрокой(Ссылка))
    
;

метод GETSchema(Запрос: HttpСервисЗапрос)
    знч Ссылка = Запрос.Параметры.ПолучитьПервый("id")
    знч Тип = Запрос.Параметры.ПолучитьПервый("type")
    //знч Адрес = Запрос.Заголовки.ПолучитьПервый()
    пер Страница = СтилиСервер.ПолучитьСтильИерархии() + Организации.ПолучитьИерархиюОрганизацийСтрокой(Организация = Ссылка, Тип = Тип)
        + ВерсткаОбщееСервер.ПолучитьСкриптЦентрирования(Ссылка)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "text/html; charset=utf-8")
    Запрос.Ответ.УстановитьТело(Страница)
;