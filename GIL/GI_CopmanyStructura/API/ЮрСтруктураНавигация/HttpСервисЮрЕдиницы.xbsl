импорт ОбщиеМодули::Верстка::Геттеры
импорт НСИ::ДоменОрганизационнаяСтруктура

метод GET(Запрос: HttpСервисЗапрос)
    знч Ссылка = Запрос.Параметры.ПолучитьПервый("id")
    Запрос.Ответ.КодСтатуса = 500
    Запрос.Ответ.Заголовки.Установить("Content-Type", "text/html; charset=utf-8")
    //Запрос.Ответ.УстановитьТело(СтилиСервер.ПолучитьСтильКарточкиПодразделения() + Подразделения
    //        .ПолучитьКарточкуПодразделенияСтрокой(Ссылка))
;

метод GETSchema(Запрос: HttpСервисЗапрос)
    знч Ссылка = Запрос.Параметры.ПолучитьПервый("id")
    Запрос.Ответ.Заголовки.Установить("Content-Type", "text/html; charset=utf-8")
    Запрос.Ответ.УстановитьТело(СтилиСервер.ПолучитьСтильИерархии() + Организации
            .ПолучитьИерархиюОрганизацийСтрокой(Ссылка))
;