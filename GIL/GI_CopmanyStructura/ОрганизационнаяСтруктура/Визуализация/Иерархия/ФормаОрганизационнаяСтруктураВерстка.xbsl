импорт ОбщиеМодули::Верстка::ДревовиднаяСхема
импорт ОбщиеМодули::ОргСтруктура
импорт ОбщиеМодули::Верстка::Геттеры
импорт Основное

метод ПодразделениеПриИзменении(
        Источник: ПолеВвода<GIL::GI_CopmanyStructura::НСИ::ДоменОрганизационнаяСтруктура::Подразделения.Ссылка?>,
        Событие: СобытиеПриИзменении<GIL::GI_CopmanyStructura::НСИ::ДоменОрганизационнаяСтруктура::Подразделения.Ссылка?>)

    Подразделение_св = Источник.Значение
    знч Адрес = НавигационнаяСсылка.Абсолютная(Тип<ПриложениеАвторизации>)
    знч Узел = ОрганизационнаяСтруктураСервер.ПредставлениеСтруктуры(Подразделение_св)
    этот.Компоненты.КонтейнерHtml.Содержимое = "<head>" + ВерсткаОбщееСервер.ПолучитьСкриптHTMX()  + СтилиСервер.ПолучитьСтильИерархии() + СтилиСервер
        .ПолучитьСтильГлавнойНавигациии() + "</head>" + "<body>" + ВерсткаОбщееСервер.ПолучитьКнопкиГлавнойСтраницы(
        Адрес) + "<div id='frontend' class='frontend' style='background-color: #ffffff'>" + ИерархическаяСхемаСерверV2
        .СформироватьДревовиднуюСхему(Узел,
        Адрес) + "</div></body>"
;

метод ОрганизационнаСтруктура(): Строка
    знч Адрес = НавигационнаяСсылка.Абсолютная(Тип<ПриложениеАвторизации>)
    знч Узел = ОрганизационнаяСтруктураСервер.ПредставлениеСтруктуры(Подразделение_св)
    возврат "<head>" + ВерсткаОбщееСервер.ПолучитьСкриптHTMX() + СтилиСервер.ПолучитьСтильИерархии() + СтилиСервер
        .ПолучитьСтильГлавнойНавигациии() + "</head>" + "<body style='width: stretch;'>" + ВерсткаОбщееСервер.ПолучитьКнопкиГлавнойСтраницы(
        Адрес) + "<div id='frontend' class='frontend' style='background-color: #ffffff'>" + ИерархическаяСхемаСерверV2
        .СформироватьДревовиднуюСхему(Узел,
        Адрес) + "</div></div></body>"
;