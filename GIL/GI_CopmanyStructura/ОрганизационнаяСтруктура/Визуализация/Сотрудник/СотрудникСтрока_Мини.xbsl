импорт ОбщиеМодули


@Локально
метод ФИО(): Строка  
    возврат ДанныеСтроки.Данные["ФИО"] == "" ? "--" : ДанныеСтроки.Данные["ФИО"] как Строка
;

@Локально
метод ФИО_Полное(): Строка
    возврат ДанныеСтроки.Данные["Полное_ФИО"] == "" ? ФИО() : ДанныеСтроки.Данные["Полное_ФИО"] как Строка
    //возврат ДанныеСтроки.Данные["Полное_ФИО"] как Строка
;

@Локально
метод Фото(): ДвоичныйОбъект.Ссылка?
    возврат ДанныеСтроки.Данные["Фото"] == Неопределено ? Ресурс{user.svg}.Ссылка : ДанныеСтроки.Данные["Фото"] как ДвоичныйОбъект.Ссылка?
;

@Локально
метод Должность(): Строка
    возврат ДанныеСтроки.Данные["Должность"] == "" ? "--" : ДанныеСтроки.Данные["Должность"].Представление()
    //возврат ДанныеСтроки.Данные["Должность"].Представление()
;

@Локально
метод Email(): Строка
    возврат ДанныеСтроки.Данные["Почта"] == "" ? "--" : ДанныеСтроки.Данные["Почта"] как Строка
    //возврат ""
;

