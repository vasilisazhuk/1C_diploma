импорт ОбщиеМодули::ОргСтруктураНативная
импорт ОбщиеМодули::Верстка::ДревовиднаяСхема
импорт ОбщиеМодули::Верстка::Геттеры
импорт Основное

@Локально
метод ЛинейноеПодчинениеСтрокой(): Строка
    знч Адрес = НавигационнаяСсылка.Абсолютная(Тип<ПриложениеАвторизации>)
    знч Подчиненность = ПодчиненностьСотрудникаСервер.СформироватьЛинейнуюЦепочкуПодчинения(Сотрудник_св)
    пер Верстка =
        "<head>" + ВерсткаОбщееСервер.ПолучитьСкриптHTMX() + СтилиСервер.ПолучитьСтильИерархии() + "</head>" + "<body>"
        + "<div id='frontend' style='background-color: #ffffff'>" + ИерархическаяСхемаСерверV2
        .СформироватьДревовиднуюСхему(Подчиненность,
        Адрес) + "</div></body>"
    возврат Верстка
//возврат ИерархическаяСхемаСерверV1.ПолучитьРазметку(Подчиненность)
;

@Локально
метод ФункциональноеПодчинениеСтрокой(): Строка
    знч Подчиненность = ПодчиненностьСотрудникаСервер.СформироватьФункциональнуюЦепочкуПодчинения(Сотрудник_св)
    знч Адрес = НавигационнаяСсылка.Абсолютная(Тип<ПриложениеАвторизации>)
    пер Верстка =
        "<head>" + ВерсткаОбщееСервер.ПолучитьСкриптHTMX() + СтилиСервер.ПолучитьСтильИерархии()  + "</head>" + "<body>"
        + "<div id='frontend' style='background-color: #ffffff'>" + ИерархическаяСхемаСерверV2
        .СформироватьДревовиднуюСхему(Подчиненность,
        Адрес) + "</div></body>"
    возврат Верстка
;