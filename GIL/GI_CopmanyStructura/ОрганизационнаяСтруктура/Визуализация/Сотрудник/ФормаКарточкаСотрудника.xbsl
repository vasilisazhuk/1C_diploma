//Переход на карточку подаразделения
метод ПодразделенииеПриНажатии(Источник: Надпись, Событие: СобытиеПриНажатии)
    знч Подразделение: Подразделения.Ссылка? = РаботаССотрудниками.ПолучитьПодразделение(Сотрудник_св)
    //Подразделения.СоздатьФормуОбъекта(Ключ = Подразделение).ОткрытьВМодальномОкне()
    КарточкаПодразделения.ОткрытьВМодальномОкне(Подразделение_св = Подразделение)
;

метод ЛинейныйРуководительПриНажатии(Источник: Надпись, Событие: СобытиеПриНажатии)
    знч Руководитель: Сотрудники.Ссылка? = РаботаССотрудниками.ПолучитьЛинейногоРуководителя(Сотрудник_св)
    ФормаКарточкаСотрудника.ОткрытьВМодальномОкне(Сотрудник_св = Руководитель, ОжидатьЗакрытия = Истина)
;

метод ФункциональныйРуководительПриНажатии(Источник: Надпись, Событие: СобытиеПриНажатии)
    знч Руководитель: Сотрудники.Ссылка? = РаботаССотрудниками.ПолучитьФункциональногоРуководителя(Сотрудник_св)
    ФормаКарточкаСотрудника.ОткрытьВМодальномОкне(Сотрудник_св = Руководитель, ОжидатьЗакрытия = Истина)
;
