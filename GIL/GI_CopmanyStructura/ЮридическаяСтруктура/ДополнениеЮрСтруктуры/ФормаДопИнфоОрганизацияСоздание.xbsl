импорт НСИ
импорт НСИ::ДоменОрганизационнаяСтруктура
импорт НСИ::ДоменЮридическаяСтруктура


@НаСервере @ДоступноСКлиента
статический метод НайтиУставнойКапитал(Организация: Организации.Ссылка, Автор: Сотрудники.Ссылка? =
            Неопределено): УставнойКапитал.Ссылка?
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            УставнойКапитал.Ссылка КАК Ссылка
        ИЗ
            УставнойКапитал КАК УставнойКапитал
        ГДЕ
            УставнойКапитал.ОргЕдиница == %Организация
        УПОРЯДОЧИТЬ ПО 
            УставнойКапитал.ДатаАктуализации УБЫВ
    }
    исп РезультатЗапроса = Запрос.Выполнить()
    пер Значение: УставнойКапитал.Ссылка?
    если не РезультатЗапроса.Пусто()
        Значение = РезультатЗапроса.ПервыйИлиНеопределено().Ссылка
        РезультатЗапроса.Закрыть()
        возврат Значение
    ;

    возврат Неопределено
;

метод ИзменитьУставнойКапиталПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    знч Ссылка = НайтиУставнойКапитал(Организация_св)
    УставнойКапитал.СоздатьФормуОбъекта(Ссылка).Открыть()
;