импорт НСИ::ДоменЮридическаяСтруктура
импорт ОбщиеМодули

метод ОбычнаяКомандаОбработчик(Команда: ОбычнаяКоманда)
    знч Пользователь = РаботаСАккаунтами.СотрудникПользователя()
    ОбновитьДанные(Ссылка_св, Компоненты.Валюта.Значение, Компоненты.Пояснение.Значение, Компоненты.Капитал.Значение, Пользователь.Пользователь как Пользователи.Ссылка, Организация_св)
    Закрыть()
;

@Локально
@НаСервере @ДоступноСКлиента
статический метод ОбновитьДанные(С: УставнойКапитал.Ссылка, Валюта: Валюты, Пояснение: Строка, Капитал: Число,
        Автор: Пользователи.Ссылка,
        Организация: Организации.Ссылка?)

    знч Событие =
        новый СобытиеОбновлениеИнформацииЮрЕдиницы(Пользователь = Автор.ВСтроку(), Организация = Организация.ВСтроку(),
        Раздел = "Уставной капитал")
    попытка
        исп Событие.ЗаписатьНачало()
        знч О = С.ЗагрузитьОбъект(Истина)
        О.Валюта = Валюта
        О.Капитал = Капитал
        О.Автор = Автор
        О.ОргЕдиница = Организация
        О.Пояснение = Пояснение
        О.ДатаАктуализации = Момент.Сейчас().ВДатаВремя(ЧасовойПояс.Текущий())
        О.Записать()
    поймать И: Исключение
    ;
;