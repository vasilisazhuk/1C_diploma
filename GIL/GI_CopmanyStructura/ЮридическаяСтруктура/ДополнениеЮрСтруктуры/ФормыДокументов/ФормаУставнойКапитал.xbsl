импорт НСИ::ДоменОрганизационнаяСтруктура
импорт НСИ::ДоменЮридическаяСтруктура

@НаСервере @ДоступноСКлиента
статический метод ОбновитьАкуализацию(О: УставнойКапитал.Объект, Организация: Организации.Ссылка?)
    О.Автор = Пользователи.ТекущийПользователь
    О.ДатаАктуализации = Момент.Сейчас().ВДатаВремя(ЧасовойПояс = ЧасовойПояс.Текущий())
    О.ОргЕдиница = Организация
;

@Обработчик
метод ПередЗаписью()
    ОбновитьАкуализацию(Объект, Организация_св)
    Объект.Капитал = Компоненты.Капитал.Значение
    Объект.Валюта = Компоненты.Валюта.Значение
    Объект.Пояснение = Компоненты.Пояснение.Значение
;

метод СохранитьПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    Записать()
;