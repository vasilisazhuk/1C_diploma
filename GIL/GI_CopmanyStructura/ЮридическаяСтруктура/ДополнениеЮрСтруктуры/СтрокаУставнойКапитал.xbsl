импорт НСИ::ДоменЮридическаяСтруктура
@Локально
метод Пояснение(): Строка  
    возврат ДанныеСтроки.Данные["Пояснение"] == "" ? "--" : ДанныеСтроки.Данные["Пояснение"] как Строка
;

@Локально
метод Валюта(): Строка  
    возврат ДанныеСтроки.Данные["Валюта"] == "" ? "--" : ДанныеСтроки.Данные["Валюта"].Представление()
;

@Локально
метод Дата(): Строка  
    возврат ДанныеСтроки.Данные["УставнойКапитал.ДатаАктуализации"].Представление()
;

@Локально
метод Автор(): Строка  
    возврат ДанныеСтроки.Данные["Автор"] == "" ? "--" : ДанныеСтроки.Данные["Автор"].Представление()
;

@Локально
метод Название(): Строка  
    возврат ДанныеСтроки.Данные["Орг"] == "" ? "--" : "Уставной капитал: " + ДанныеСтроки.Данные["Орг"].Представление() 
;

@Локально
метод Ссылка(): УставнойКапитал.Ссылка?  
    возврат ДанныеСтроки.Данные["УставнойКапиталСсылка"] как УставнойКапитал.Ссылка?
;


