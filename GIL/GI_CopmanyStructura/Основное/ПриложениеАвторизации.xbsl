импорт ОбщиеМодули

@Обработчик
метод ПослеСоздания()
    знч ЭтоАдминистратор = РаботаСАккаунтами.ЭтоАдминистратор()
    если ЭтоАдминистратор
        ПерейтиПоСсылке(НавигационнаяСсылка.Абсолютная(Тип<ПриложениеАдминистратора>), Ложь)
    иначе
        ПерейтиПоСсылке(НавигационнаяСсылка.Абсолютная(Тип<ПриложениеСотрудника>), Ложь)
    ;
;